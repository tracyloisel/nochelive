<header class="quiz-hud<%= " is-guest" if guest? %><%= " is-quiz" if quiz? %><%= " is-rank-up" if bar.rank_up %>"
        aria-label="<%= aria_label %>"
        data-hud-theme="<%= theme %>"
        data-controller="hub-streak">
  <% if guest? && !quiz? %>
    <%= link_to who_path, class: "quiz-hud-who is-guest", aria: { label: t("hub.guest_invite") } do %>
      <span class="quiz-hud-avatar is-guest"><%= picto("profile-spark") %></span>
      <div class="quiz-hud-meta">
        <p class="quiz-hud-name"><%= t("hub.guest_invite") %></p>
        <p class="quiz-hud-rank"><%= t("hub.guest_in_ward") %></p>
      </div>
      <span class="quiz-hud-guest-go" aria-hidden="true"><%= picto("arrow") %></span>
    <% end %>
  <% else %>
    <% if quiz? %>
      <%= link_to who_path, class: "quiz-hud-who", aria: { label: t("hub.nav_home") } do %>
        <span class="quiz-hud-avatar<%= " is-guest" if guest? %>">
          <% if bar.avatar_key.present? && (src = avatar_mark(bar.avatar_key)) %>
            <img src="<%= src %>" alt="" class="avatar-img" width="40" height="40">
          <% else %>
            <%= picto("person") %>
          <% end %>
        </span>
        <div class="quiz-hud-meta">
          <p class="quiz-hud-name">
            <span class="quiz-hud-name-text"><%= bar.name.presence || t("hub.pick_ficha") %></span>
            <% if bar.level.present? %><span class="quiz-hud-level"><%= bar.level %></span><% end %>
          </p>
          <% if bar.rank_key.present? %>
            <p class="quiz-hud-rank"><span class="quiz-hud-rank-name"><%= rank_name(bar.rank_key) %></span></p>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <%= link_to who_path, class: "quiz-hud-who", aria: { label: t("hub.nav_home") } do %>
        <span class="quiz-hud-avatar">
          <% if bar.avatar_key.present? && (src = avatar_mark(bar.avatar_key)) %>
            <img src="<%= src %>" alt="" class="avatar-img" width="40" height="40">
          <% else %>
            <%= picto("person") %>
          <% end %>
        </span>
        <div class="quiz-hud-meta">
          <p class="quiz-hud-name"><%= bar.name %></p>
          <% if bar.rank_key.present? %>
            <p class="quiz-hud-rank">
              <span><%= rank_name(bar.rank_key) %></span>
              <% if bar.level.present? %><span class="quiz-hud-level"><%= bar.level %></span><% end %>
            </p>
          <% end %>
          <% if bar.xp_progress.present? %>
            <span class="quiz-hud-xp"
                  role="progressbar"
                  aria-label="<%= t("hub.rank_progress") %>"
                  aria-valuenow="<%= bar.xp_progress %>"
                  aria-valuemin="0"
                  aria-valuemax="100">
              <i style="--hud-xp-progress: <%= bar.xp_progress %>%"></i>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if bar.pack_title.present? %>
      <div class="quiz-hud-pack">
        <div class="quiz-hud-pack-copy">
          <p class="quiz-hud-title"><%= bar.pack_title %></p>
          <% if bar.progress_n.present? && bar.progress_total.to_i.positive? %>
            <p class="quiz-hud-progress quiz-progress"><%= t("quiz.progress", n: bar.progress_n, total: bar.progress_total) %></p>
          <% end %>
          <% if bar.dots.present? %>
            <nav class="quiz-hud-rail" aria-hidden="true">
              <% bar.dots.each do |state| %>
                <span class="quiz-hud-dot <%= state %>"></span>
              <% end %>
            </nav>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= render "shared/quiz_hud_stats", bar: bar %>
  <% end %>
  <span class="quiz-hud-menu" aria-hidden="true"></span>
</header>
