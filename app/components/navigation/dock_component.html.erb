<nav class="street-hub-nav street-world-dock" aria-label="<%= t("hub.nav_home") %>">
  <%= link_to helpers.root_path, class: item_class(:home) do %>
    <%= picto("meetinghouse") %>
    <span><%= t("hub.nav_home") %></span>
  <% end %>
  <%= link_to helpers.street_map_path, class: item_class(:adventure) do %>
    <%= picto("compass") %>
    <span><%= t("hub.nav_adventure") %></span>
  <% end %>
  <%= link_to helpers.study_program_path, class: item_class(:word, "is-word") do %>
    <span class="street-hub-word-medallion"><%= picto("scripture-book") %></span>
    <span><%= t("hub.nav_word") %></span>
  <% end %>
  <%= link_to helpers.church_path, class: item_class(:church) do %>
    <%= picto("church") %>
    <span><%= t("hub.nav_church") %></span>
  <% end %>
  <%= link_to helpers.street_profile_path(edit: 1), class: item_class(:profile) do %>
    <%= picto("person") %>
    <span><%= t("hub.nav_profile") %></span>
