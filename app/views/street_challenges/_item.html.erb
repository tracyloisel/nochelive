<% duel = item.duel %>
<% other = item.other %>
<% pack_title = item.pack.copy(:title) %>
<% you = current_street_person %>
<article class="street-duel-inbox-card">
  <div class="street-duel-inbox-card-who">
    <% if other %>
      <% src = avatar_mark(other) %>
      <% if src %>
        <img src="<%= src %>" alt="" class="avatar-img" width="44" height="44">
      <% else %>
        <span class="avatar-fallback" aria-hidden="true"><%= other.given_name.to_s.first %></span>
      <% end %>
    <% else %>
      <span class="street-duel-face-slot" aria-hidden="true"><%= picto("sparkle") %></span>
    <% end %>
    <div class="street-duel-inbox-card-meta">
      <p class="street-duel-inbox-card-name"><%= other ? other.display_name : t("street.share_guest") %></p>
      <p class="street-duel-inbox-card-pack"><%= pack_title %></p>
      <% if duel.challenger_score && item.role != :challenger %>
        <p class="street-duel-inbox-card-score"><%= t("street.duel_beat_score", name: duel.challenger_person.display_name, score: duel.challenger_score) %></p>
      <% elsif item.phase == :result && you %>
        <% you_score = you.id == duel.challenger_person_id ? duel.challenger_score : duel.opponent_score %>
        <% them_score = you.id == duel.challenger_person_id ? duel.opponent_score : duel.challenger_score %>
        <p class="street-duel-inbox-card-score"><%= you_score %>–<%= them_score %><% if duel.challenger_score == duel.opponent_score %> · <%= t("street.duel_tie") %><% elsif duel.winner_person&.id == you.id %> · <%= t("street.duel_winner") %><% end %></p>
      <% elsif item.role == :challenger %>
        <p class="street-duel-inbox-card-score">
          <% if item.waiting_for == :play && other %>
            <%= t("street.duel_playing_named", name: other.display_name) %>
          <% elsif item.waiting_for == :accept && other %>
            <%= t("street.duel_waiting_named", name: other.display_name) %>
          <% else %>
            <%= t("street.duel_waiting_friend") %>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <% case item.phase %>
  <% when :accept %>
    <%= button_to street_challenge_accept_path(duel.token), class: "btn btn-gold" do %>
      <%= t("street.duel_accept") %>
    <% end %>
  <% when :play %>
    <%= link_to t("street.duel_play"), jugar_path, class: "btn btn-gold" %>
  <% when :result %>
    <%= link_to t("street.duel_title"), street_challenge_path(duel.token), class: "quiet-link" %>
  <% else %>
    <% if item.waiting_for == :link %>
      <button type="button"
              class="btn btn-gold"
              data-controller="street-share"
              data-action="street-share#invite"
              data-street-share-url-value="<%= street_challenge_url(duel.token) %>"
              data-street-share-text-value="<%= t("street.duel_share_text", name: you.display_name, pack: pack_title) %>"
              data-street-share-copied-value="<%= t("street.share_copied") %>">
        <%= t("street.duel_share_again") %>
      </button>
    <% end %>
  <% end %>
</article>
