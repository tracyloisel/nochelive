<% content_for :title, t("street.duel_title") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>

<%= paper_hall id: "street_desafio", kicker: t("street.duel_title") do %>
  <h1><%= t("street.duel_title") %></h1>
  <p class="lede"><%= t("street.duel_challenge", name: @challenger.given_name, pack: @pack.copy(:title)) %></p>
  <%= button_to street_challenge_accept_path(@duel.token), class: "btn btn-gold" do %>
    <%= t("street.duel_accept") %>
  <% end %>
  <nav class="hall-sheet-foot">
    <%= link_to t("street.ceremony_back_map"), root_path, class: "quiet-link" %>
  </nav>
<% end %>
