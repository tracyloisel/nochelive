<% invitation = @screen.invitation %>
<% challenger = @screen.challenger %>
<% token = invitation.public_token %>
<% owner = current_street_person&.id == invitation.challenger_person_id %>
<% recipient = current_street_person&.id == invitation.recipient_person_id %>
<% receipt_url = if invitation.external? && !owner
  street_challenge_opened_path(token, src: params[:src])
elsif recipient
  street_challenge_received_path(token)
end %>
<% content_for :title, t("duel_campus.invitation.title", name: challenger.given_name) %>
<% content_for :body_class, "is-kid is-paper-hall is-duel-invitation" %>
<% surface_stylesheet("duel_campus") %>
<% declare_frontend_resources(
     context: "duel.invitation",
     styles: %w[shell duel_campus],
     controllers: %w[loading press duel-invitation duel-motion],
     media: { lcp: media_src("media/social/campus-invitation-friends-v1.png") },
     motion: %w[invitation-enter],
     classes: {
       "style.duel_campus" => "critical",
       "media.lcp" => "critical",
       "controller.duel_invitation" => "contextual",
       "controller.duel_motion" => "contextual",
       "motion.invitation" => "contextual"
     }
   ) %>
<% content_for :head do %>
  <%= noche_picture_preload("media/social/campus-invitation-friends-v1.png") %>
<% end %>
<% page_hud(face: true) { site_menu } %>

<section class="duel-invitation<%= " has-dock" if current_street_person %>"
         data-controller="duel-invitation duel-motion"
         data-state="<%= @screen.state %>"
         data-origin="<%= invitation.external? ? "cold" : "named" %>"
         data-duel-invitation-receipt-url-value="<%= receipt_url %>"
         data-duel-motion-sequence-value="invitation"
         style="view-transition-name: street-world">
  <header class="duel-invitation-hero">
    <%= noche_media_picture("media/social/campus-invitation-friends-v1.png", alt: "", loading: "eager", fetchpriority: "high") %>
    <span aria-hidden="true"></span>
    <div>
      <p><%= @screen.rematch ? t("duel_campus.invitation.rematch_kicker") : t("duel_campus.invitation.kicker") %></p>
      <h1><%= t("duel_campus.invitation.title", name: challenger.given_name) %></h1>
      <p><%= t("duel_campus.invitation.lede") %></p>
    </div>
  </header>

  <main class="duel-invitation-sheet" data-duel-motion-target="reveal">
    <div class="duel-invitation-faces">
      <%= render "street_challenges/person", person: challenger %>
      <span class="duel-invitation-versus" aria-hidden="true"><%= picto("duel-scrolls") %></span>
      <%= render "street_challenges/person", person: current_street_person unless owner %>
    </div>

    <time class="duel-campus-invitation-date is-detail" datetime="<%= invitation.expires_at.iso8601 %>"><%= picto("calendar") %><span><%= t("duel_campus.dates.expires", date: duel_calendar_date(invitation.expires_at)) %><small><%= t("duel_campus.deadline", time: duel_time_left(invitation.expires_at)) %></small></span></time>

    <% if invitation.challenger_score %>
      <p class="duel-invitation-score"><small><%= t("duel_campus.invitation.shared_score") %></small><strong><%= invitation.challenger_score %></strong><span class="duel-invitation-currency"><%= picto("crown") %><%= t("chrome.crowns_word") %></span></p>
    <% end %>
    <p class="duel-invitation-rule"><span aria-hidden="true">✦</span><%= t("duel_campus.invitation.any_pack") %></p>

    <% case @screen.state %>
    <% when :available %>
      <% if owner %>
        <%= render "street_challenges/receipt", invitation:, viewer: current_street_person %>
        <% if invitation.external? %>
          <div class="duel-invitation-actions">
            <button type="button"
                    class="btn btn-gold duel-campus-command duel-invitation-primary"
                    data-controller="street-share"
                    data-action="street-share#invite"
                    data-street-share-url-value="<%= street_challenge_url(token, src: "share") %>"
                    data-street-share-duel-token-value="<%= token %>"
                    data-street-share-source-value="invitation"
                    data-street-share-text-value="<%= t("duel_campus.share.text", name: challenger.given_name) %>">
              <%= t("duel_campus.actions.share_again") %>
            </button>
          </div>
        <% else %>
          <p class="duel-invitation-wait"><%= t("duel_campus.invitation.waiting_named", name: invitation.recipient_person.given_name) %></p>
        <% end %>
      <% elsif @screen.state == :available %>
        <div class="duel-invitation-actions">
          <%= button_to t("duel_campus.actions.accept"), street_challenge_accept_path(token), class: "btn btn-gold duel-campus-command duel-invitation-primary" %>
          <% if recipient %>
            <%= button_to t("duel_campus.actions.decline"), street_challenge_decline_path(token), class: "btn btn-ghost" %>
          <% end %>
        </div>
      <% end %>
    <% when :claimed %>
      <% if current_street_person && invitation.street_duel&.includes_person?(current_street_person) %>
        <h2><%= t("duel_campus.invitation.now_active") %></h2>
        <div class="duel-invitation-actions">
          <%= link_to t("duel_campus.actions.open_duel"), street_duel_path(invitation.street_duel), class: "btn btn-gold duel-campus-command duel-invitation-primary" %>
        </div>
      <% else %>
        <h2><%= t("duel_campus.invitation.already_claimed") %></h2>
        <div class="duel-invitation-actions">
          <%= link_to t("duel_campus.actions.visit_campus"), street_challenges_path, class: "btn btn-navy duel-campus-command duel-invitation-primary" %>
        </div>
      <% end %>
    <% when :expired, :revoked %>
      <h2><%= t("duel_campus.invitation.expired") %></h2>
      <p><%= t("duel_campus.invitation.expired_lede") %></p>
      <div class="duel-invitation-actions">
        <%= link_to t("duel_campus.actions.visit_campus"), street_challenges_path, class: "btn btn-navy duel-campus-command duel-invitation-primary" %>
      </div>
    <% when :declined %>
      <h2><%= t("duel_campus.invitation.declined") %></h2>
      <div class="duel-invitation-actions">
        <%= link_to t("duel_campus.actions.visit_campus"), street_challenges_path, class: "btn btn-navy duel-campus-command duel-invitation-primary" %>
      </div>
    <% when :other_recipient %>
      <h2><%= t("duel_campus.invitation.for_someone_else") %></h2>
      <div class="duel-invitation-actions">
        <%= link_to t("duel_campus.actions.visit_campus"), street_challenges_path, class: "btn btn-navy duel-campus-command duel-invitation-primary" %>
      </div>
    <% end %>

    <footer><%= link_to t("duel_campus.actions.back"), owner ? street_challenges_path : root_path, class: "quiet-link" %></footer>
  </main>

  <% page_dock(active: :home) if current_street_person %>
</section>
