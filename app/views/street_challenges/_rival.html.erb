<% state = row.state %>
<% badge = { won: "street.duel_won_badge", lost: "street.duel_lost_badge", tie: "street.duel_tie_badge",
             waiting: "street.duel_waiting_short", incoming: "street.duel_incoming_badge" }[state] %>
<% if badge %>
  <article class="street-duel-inbox-rival is-settled">
    <%= render "street_challenges/rival_who", row: row %>
    <span class="street-duel-inbox-rival-state"><%= t(badge) %></span>
  </article>
<% else %>
  <%= form_with url: street_challenges_path, method: :post, class: "street-duel-inbox-rival-form" do %>
    <%= hidden_field_tag :opponent_id, row.person.id %>
    <%= hidden_field_tag :pack_id, pack_id %>
    <article class="street-duel-inbox-rival">
      <%= render "street_challenges/rival_who", row: row %>
      <button type="submit" class="btn <%= incoming_action ? "btn-navy" : "btn-gold" %> street-duel-inbox-rival-go">
        <%= t("street.duel_send") %>
      </button>
    </article>
  <% end %>
<% end %>
