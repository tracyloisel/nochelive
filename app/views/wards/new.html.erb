<% content_for :title, "Tu rama" %>
<% shot = capture do %>
  <%= render "shared/still", src: night_poster_src("reyes_y_profetas"), poster: true %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", title: "Presentador", ticks: false %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "open", mid: 0.62, reel_class: "is-join" do %>
  <h1>Tu rama</h1>
  <p class="lede">Las fichas y los equipos viven aquí. Las noches se abren dentro de la rama.</p>

  <%= form_with url: wards_path, class: "join-form" do %>
    <label for="ward_name">Nombre de la rama</label>
    <input id="ward_name" name="name" maxlength="48" required class="code-input" placeholder="Madrid Centro">
    <button type="submit" class="btn btn-gold picto-btn"><%= picto("plus") %>Crear rama</button>
  <% end %>

  <p class="split">¿Ya tienes una?</p>
  <%= link_to "Entrar en una rama", ward_gate_path, class: "btn btn-navy" %>
  <%= link_to "Volver", root_path, class: "btn btn-ghost" %>
<% end %>
