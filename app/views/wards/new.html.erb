<% content_for :title, t("ward.yours") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<% page_hud { site_menu } %>

<%= paper_hall id: "ward_new", kicker: t("ward.yours") do %>
  <%= render "shared/hall_still", src: night_poster_src("reyes_y_profetas") %>
  <h1><%= t("ward.yours") %></h1>
  <p class="lede"><%= t("ward.yours_lede") %></p>

  <%= form_with url: wards_path, class: "join-form" do %>
    <label for="ward_name"><%= t("ward.name") %></label>
    <input id="ward_name" name="name" maxlength="<%= Ward::NAME_MAX %>" required class="code-input" placeholder="<%= t("ward.name_ph") %>">

    <fieldset class="emblem-pick">
      <legend><%= t("ward.emblem") %></legend>
      <% Team::EMBLEMS.each do |key, _label| %>
        <label class="emblem-choice">
          <input type="radio" name="emblem" value="<%= key %>" <%= "checked" if key == "paloma" %>>
          <span class="emblem emblem-lg emblem-<%= key %>"><%= render "shared/emblem", key: key %></span>
          <em><%= emblem_name(key) %></em>
        </label>
      <% end %>
    </fieldset>

    <label for="chapel_name"><%= t("ward.chapel_name") %></label>
    <input id="chapel_name" name="chapel_name" maxlength="80" class="code-input" placeholder="<%= t("ward.chapel_ph") %>">

    <label for="chapel_address"><%= t("ward.chapel_address") %></label>
    <input id="chapel_address" name="chapel_address" maxlength="80" class="code-input" placeholder="<%= t("ward.address_ph") %>">

    <label for="city"><%= t("ward.city") %></label>
    <input id="city" name="city" maxlength="80" class="code-input" placeholder="<%= t("ward.city_ph") %>">

    <label for="region"><%= t("ward.region") %></label>
    <input id="region" name="region" maxlength="80" class="code-input" placeholder="<%= t("ward.region_ph") %>">

    <label for="postal_code"><%= t("ward.postal_code") %></label>
    <input id="postal_code" name="postal_code" maxlength="80" class="code-input" placeholder="<%= t("ward.postal_ph") %>">

    <label for="country_code"><%= t("ward.country") %></label>
    <select id="country_code" name="country_code" class="place-input">
      <option value=""><%= t("ward.country") %></option>
      <% I18n.t("countries").each_key do |code| %>
        <option value="<%= code %>" <%= "selected" if code.to_s == "ES" %>><%= t("countries.#{code}") %></option>
      <% end %>
    </select>

    <button type="submit" class="btn btn-gold"><%= picto("plus") %><%= t("ward.create") %></button>
  <% end %>

  <p class="split"><%= t("ward.have_one") %></p>
  <%= link_to t("ward.enter_one"), ward_gate_path, class: "btn btn-navy" %>
  <nav class="hall-sheet-foot">
    <%= link_to t("presenter.back"), root_path, class: "quiet-link" %>
  </nav>
<% end %>
