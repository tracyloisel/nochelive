<% content_for :title, t("scripture_library.title") %>
<% content_for :body_class, "is-scripture-library is-celestial-dark" %>
<% declare_frontend_resources(context: "scripture.library", styles: %w[library]) %>
<% page_hud(hud: true, theme: "celestial-dark") { site_menu } %>

<% editorial = @screen.editorial %>
<% hero_artwork = editorial&.artwork_key || "scripture.library.psalms-refuge" %>
<% hero_role = editorial ? :library_daily_hero : :hub_hero %>
<% content_for :head do %>
  <%= noche_picture_preload(hero_artwork, role: hero_role) %>
<% end %>

<% value_for = lambda do |object, key|
     if object.is_a?(Hash)
       object.key?(key) ? object[key] : object[key.to_s]
     elsif object.respond_to?(key)
       object.public_send(key)
     end
   end %>
<% selection_key = value_for.call(@selection, :key).to_s %>

<article id="bibliotheque"
         class="scripture-library"
         aria-labelledby="scripture_library_title"
         data-controller="library-search"
         data-library-search-error-message-value="<%= t("scripture_library.search.errors.network") %>">
  <header class="scripture-library-daily<%= " is-fallback" unless editorial %>"
          <% if editorial %>data-daily-discovery-id="<%= editorial.id %>" data-daily-discovery-date="<%= editorial.scheduled_on.iso8601 %>"<% end %>>
    <div class="scripture-library-daily__world">
      <%= noche_picture(
            hero_artwork,
            role: hero_role,
            alt: editorial&.alt.to_s,
            class_name: "scripture-library-daily__art",
            loading: "eager",
            fetchpriority: "high",
            sizes: "100vw"
          ) %>
    </div>

    <div class="scripture-library-daily__veil" aria-hidden="true"></div>

    <div class="scripture-library-daily__chrome">
      <div class="scripture-library-daily__day">
        <% if editorial %>
          <time datetime="<%= editorial.scheduled_on.iso8601 %>"><%= l(editorial.scheduled_on, format: :library_day) %></time>
          <span><%= t("scripture_library.editorial.door_open") %></span>
        <% else %>
          <span><%= t("scripture_library.editorial.fallback_eyebrow") %></span>
        <% end %>
      </div>

      <details class="scripture-library-search-drawer" <%= "open" if @query.present? || @result.present? %>>
        <summary>
          <span aria-hidden="true"><%= picto("search") %></span>
          <span><%= t("scripture_library.editorial.search_toggle") %></span>
        </summary>
        <form id="recherche-ecritures"
              class="scripture-library-search"
              action="<%= scripture_library_search_path %>"
              method="get"
              role="search"
              aria-busy="false"
              data-library-search-target="form"
              data-action="submit->library-search#submit">
          <input type="hidden" name="locale" value="<%= I18n.locale %>">
          <label for="scripture_library_query"><%= t("scripture_library.search.label") %></label>
          <div class="scripture-library-search__field">
            <span class="scripture-library-search__icon" aria-hidden="true"><%= picto("search") %></span>
            <input id="scripture_library_query"
                   name="q"
                   type="search"
                   value="<%= @query %>"
                   placeholder="<%= t("scripture_library.search.placeholder") %>"
                   autocomplete="off"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="<%= @result&.suggestions&.any? ? 'true' : 'false' %>"
                   aria-controls="scripture-library-suggestions"
                   aria-describedby="scripture-library-search-status"
                   data-library-search-target="input"
                   data-action="input->library-search#change keydown->library-search#keydown">
            <button type="button"
                    class="scripture-library-search__clear"
                    aria-label="<%= t("scripture_library.search.clear") %>"
                    data-action="library-search#clear">×</button>
            <button type="submit" class="scripture-library-search__submit">
              <span><%= t("scripture_library.search.submit") %></span>
              <i aria-hidden="true"></i>
            </button>
          </div>
          <%= render "scripture_libraries/search_results", result: @result %>
        </form>
      </details>
    </div>

    <div class="scripture-library-daily__copy">
      <% if editorial %>
        <p class="scripture-library-kicker"><span aria-hidden="true">✦</span><%= editorial.eyebrow %></p>
        <h1 id="scripture_library_title"><%= editorial.title %></h1>
        <p class="scripture-library-daily__setup"><%= editorial.setup %></p>
        <% if editorial.question.present? %>
          <p class="scripture-library-daily__question"><%= editorial.question %></p>
        <% end %>
        <%= link_to editorial.path,
              class: "scripture-library-action scripture-library-action--hero",
              data: {
                turbo_frame: "_top",
                action: "click->scripture-launcher#prepare",
                scripture_chapter_title: editorial.cite
              } do %>
          <span><%= editorial.cta_label %></span><small><%= editorial.cite %></small><b aria-hidden="true">→</b>
        <% end %>
        <% if editorial.disclosure.present? %>
          <p class="scripture-library-daily__disclosure"><%= editorial.disclosure %></p>
        <% end %>
      <% else %>
        <p class="scripture-library-kicker"><span aria-hidden="true">✦</span><%= t("scripture_library.eyebrow") %></p>
        <h1 id="scripture_library_title"><%= t("scripture_library.title") %></h1>
        <p class="scripture-library-daily__question"><%= t("scripture_library.hero.fallback_quote") %></p>
      <% end %>
    </div>

    <a class="scripture-library-daily__continue" href="#choisir-lecture">
      <span><%= t("scripture_library.editorial.continue_below") %></span><b aria-hidden="true">⌄</b>
    </a>
  </header>

  <main id="choisir-lecture" class="scripture-library-stream" aria-label="<%= t("scripture_library.editorial.stream_label") %>">
    <div class="scripture-library-stream__inner">
      <%= render "scripture_libraries/resume", resume: @screen.resume if @screen.resume %>
      <%= render "scripture_libraries/week", week: @screen.week, active: selection_key == "weekly" if @screen.week %>
      <%= render "scripture_libraries/quiz_prompt", prompt: @screen.quiz_prompt if @screen.quiz_prompt %>
      <%= render "scripture_libraries/rama_highlights", highlights: @screen.rama_highlights if @screen.rama_highlights.any? %>
      <%= render "scripture_libraries/tools", tools: @screen.tools, selection_key: %>

      <% if @selection %>
        <%= render "scripture_libraries/selection", selection: @selection, value_for: %>
      <% else %>
        <turbo-frame id="library_selection"
                     data-turbo-action="advance"
                     data-library-search-target="selectionFrame"></turbo-frame>
      <% end %>

      <footer class="scripture-library-stream__colophon">
        <span aria-hidden="true">✦</span>
        <p><%= t("scripture_library.editorial.colophon") %></p>
      </footer>
    </div>
  </main>
</article>

<% page_dock(active: :word) %>
