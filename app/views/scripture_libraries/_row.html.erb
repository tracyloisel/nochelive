<% row_data = {
     library_row: key,
     library_search_target: "row",
     action: "click->library-search#remember"
   } %>
<% if reader %>
  <% row_data[:turbo_frame] = "scripture_reader" %>
  <% row_data[:action] = "click->library-search#remember click->scripture-launcher#prepare" %>
  <% row_data[:scripture_chapter_title] = row.title %>
<% elsif key.to_sym != :rama %>
  <% row_data[:turbo_frame] = "library_selection" %>
  <% row_data[:turbo_action] = "advance" %>
<% end %>
<% controls_selection = row.path.present? && !reader && key.to_sym != :rama %>
<% row_classes = [
     "scripture-library-row",
     ("is-priority" if priority),
     ("has-primary-action" if primary_action),
     ("is-active" if active),
     ("is-disabled" if row.path.blank?)
   ] %>
<% row_aria = {
     current: ("true" if active),
     expanded: ((active ? "true" : "false") if controls_selection),
     controls: ("library_selection" if controls_selection),
     disabled: ("true" if row.path.blank?)
   }.compact %>
<% row_label = if key.to_sym == :resume && row.progress.nil?
     t("scripture_library.rows.start")
   else
     t("scripture_library.rows.#{key}")
   end %>
<% row_content = capture do %>
  <span class="scripture-library-row__icon" aria-hidden="true"><%= picto(row.icon) %></span>
  <span class="scripture-library-row__body">
    <span class="scripture-library-row__label"><%= row_label %></span>
    <strong><%= row.title %></strong>
    <span class="scripture-library-row__detail"><%= row.detail %></span>
    <% if row.avatars.any? %>
      <span class="scripture-library-row__avatars" aria-hidden="true">
        <% row.avatars.each do |person| %>
          <span>
            <% if (src = avatar_mark(person)) %>
              <img src="<%= src %>" alt="">
            <% else %>
              <%= person.given_name.to_s.first %>
            <% end %>
          </span>
        <% end %>
      </span>
    <% end %>
    <% if row.progress %>
      <span class="scripture-library-row__progress"
            role="progressbar"
            aria-label="<%= t("scripture_library.progress_label") %>"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="<%= (row.progress * 100).round %>">
        <i style="--library-progress:<%= (row.progress * 100).round %>%"></i>
      </span>
    <% end %>
  </span>
  <span class="scripture-library-row__intent">
    <span><%= row.meta.presence || t("scripture_library.actions.open") %></span>
    <b aria-hidden="true"><%= row.path.present? ? "→" : "·" %></b>
  </span>
<% end %>

<% if row.path.present? %>
  <%= link_to row.path, { id: anchor, class: row_classes, aria: row_aria, data: row_data } do %><%= row_content %><% end %>
<% else %>
  <div id="<%= anchor %>"
       class="<%= row_classes.compact.join(" ") %>"
       aria-disabled="true"
       data-library-row="<%= key %>"
       data-library-search-target="row"><%= row_content %></div>
<% end %>
