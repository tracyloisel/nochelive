<p class="night-entry-kicker"><%= t("join.recognized_kicker") %></p>
<h1><%= t("join.recognized_title") %></h1>
<p class="lede"><%= t("join.recognized_lede", name: person.given_name) %></p>
<div class="street-quien-ficha night-entry-person">
  <div class="team-pick person-pick is-here">
    <%= render "people/card", person: person, show_year: false %>
  </div>
</div>
<%= form_with url: night_players_path(night.code), method: :post, class: "join-form" do %>
  <input type="hidden" name="person_id" value="<%= person.id %>">
  <button type="submit" class="btn night-entry-cta"><%= t("join.enter_now") %></button>
<% end %>

<div class="night-entry-quiet-row">
  <%= link_to t("join.change_person"), night_name_path(night.code, fresh: 1), class: "quiet-link" %>
</div>
