<div class="street-quien-ficha">
  <div class="team-pick person-pick is-here">
    <%= render "people/card", person: person, show_year: false %>
  </div>
</div>
<h1><%= t("join.welcome_title") %></h1>
<p class="lede"><%= person.card_caption %></p>
<% if person.last_ward_team %>
  <p class="quiet"><%= person.last_ward_team.name %></p>
<% end %>

<%= form_with url: night_players_path(night.code), method: :post, class: "join-form" do %>
  <input type="hidden" name="person_id" value="<%= person.id %>">
  <input type="hidden" name="location" value="room">
  <button type="submit" class="btn btn-gold"><%= picto("check") %><%= t("join.yes_name", name: person.given_name) %></button>
<% end %>

<%= link_to night_name_path(night.code, fresh: 1), class: "btn btn-ghost" do %>
  <%= picto("person") %><%= t("join.not_me") %>
<% end %>
