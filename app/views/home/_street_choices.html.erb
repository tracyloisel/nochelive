<div class="choices">
  <% street_shuffled_choices(street.run, street.question).each_with_index do |choice, index| %>
    <% mark = choice_mark(index) %>
    <%= button_to quiz_answers_path(street.run),
          params: { choice: choice_key(choice) },
          class: "choice-btn choice-#{mark[:tone]}",
          form: { data: { turbo_stream: true } },
          data: { choice_key: choice_key(choice) } do %>
      <span class="word"><%= street.question.choice_copy(choice) %></span>
    <% end %>
  <% end %>
</div>
