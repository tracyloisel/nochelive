<% complete = street.complete %>
<% campus = local_assigns[:duel_campus] || Quizzes::DuelCampus.call(person: current_street_person, run: street.run) %>
<% impacts = campus.impacts %>
<% verdict = street_ceremony_verdict(complete:, impacts:) %>
<% pack_rows = ceremony_board_rows(complete.pack_board) %>
<% chest_src = street_ceremony_asset_src("ceremony-chest") %>
<% outcome_scene = if impacts.any? { |item| item.outcome == :ahead }
  "victory"
elsif impacts.any? { |item| item.outcome == :behind }
  "rematch"
else
  "neutral"
end %>
<div class="play-shot quiz-world duel-ceremony-world is-duel-<%= outcome_scene %>">
  <div class="challenge-media duel-ceremony-art">
    <%= noche_media_picture(chrome.image, alt: "", class_name: "challenge-story", loading: "eager", fetchpriority: "high") %>
  </div>
  <span class="street-ceremony-rays" aria-hidden="true"></span>

  <div class="street-ceremony-scroll">
    <%= render "home/street_quiz_hud", street:, run:, question:, pack:, quiz_standings:, combo:, theme: chrome.mode %>
    <div class="street-win street-ceremony duel-ceremony is-duel-<%= outcome_scene %>" role="status" tabindex="0">
      <header class="street-ceremony-hero">
        <span class="duel-ceremony-seal" aria-hidden="true">✦</span>
        <p class="street-ceremony-shout is-<%= verdict[:tone] %>"><%= verdict[:title] %></p>
        <p class="street-ceremony-kicker"><%= verdict[:detail] %></p>
      </header>

      <div class="street-ceremony-medallion">
        <span class="street-ceremony-medallion-glow" aria-hidden="true"></span>
        <span class="street-ceremony-crown" aria-hidden="true"><%= picto("crown") %></span>
        <p class="street-ceremony-score-label"><%= t("street.ceremony_score_label") %></p>
        <p class="street-win-score score-fly" data-from="<%= complete.base_score %>" data-final="<%= complete.score %>"><%= complete.base_score %></p>
        <p class="street-ceremony-crowns"><%= t("chrome.crowns_word") %></p>
        <% if complete.streak_bonus.positive? %><p class="street-ceremony-score-math"><span><%= complete.base_score %></span><strong>+<%= complete.streak_bonus %></strong><span><%= t("street.ceremony_fire_bonus_short") %></span></p><% end %>
      </div>

      <ul class="street-ceremony-stats">
        <li class="street-ceremony-stat"><%= picto("found") %><span class="street-ceremony-stat-label"><%= t("street.ceremony_stat_answered") %></span><strong><%= complete.answered %> / <%= pack.questions.size %></strong></li>
        <li class="street-ceremony-stat"><%= picto("check") %><span class="street-ceremony-stat-label"><%= t("street.ceremony_stat_correct") %></span><strong><%= complete.correct %></strong></li>
        <li class="street-ceremony-stat"><img class="street-ceremony-streak-icon" src="/media/streak/living-fire-hud-v1.webp" srcset="/media/streak/living-fire-hud-v1@2x.webp 2x" alt="" width="64" height="64"><span class="street-ceremony-stat-label"><%= t("street.ceremony_stat_streak") %></span><strong><%= complete.max_streak %></strong></li>
        <li class="street-ceremony-stat"><%= picto("hourglass") %><span class="street-ceremony-stat-label"><%= t("street.ceremony_stat_time") %></span><strong><%= street_clock(complete.duration_s) %></strong></li>
      </ul>

      <% if impacts.any? %>
        <% primary_impact = impacts.one? ? impacts.first : nil %>
        <section class="duel-ceremony-impact"
                 role="region"
                 aria-live="polite"
                 data-controller="duel-motion"
                 data-state="complete"
                 data-next-desire="<%= campus.next_desire %>"
                 data-duel-motion-sequence-value="impact">
          <header>
            <small><%= t("duel_campus.ceremony.kicker") %></small>
            <% if primary_impact %>
              <% name = primary_impact.other.given_name %>
              <% gap = primary_impact.theirs.nil? ? nil : (primary_impact.mine.to_i - primary_impact.theirs.to_i).abs %>
              <h2><%= t("duel_campus.outcomes.#{primary_impact.outcome}", name:) %></h2>
              <p><%= t("duel_campus.ceremony.margin.#{primary_impact.outcome}", name:, crowns: gap) %></p>
            <% else %>
              <h2><%= t("duel_campus.ceremony.title") %></h2>
              <p><%= t("duel_campus.ceremony.lede") %></p>
            <% end %>
          </header>
          <div class="duel-ceremony-impact-grid">
            <% impacts.each do |item| %>
              <%= render "home/duel_ceremony_result_card", item:, show_verdict: impacts.many? %>
            <% end %>
          </div>
          <% if primary_impact %>
            <%= link_to t("duel_campus.ceremony.actions.#{primary_impact.outcome}"), street_duel_path(primary_impact.duel), class: "btn btn-navy" %>
          <% else %>
            <%= link_to t("duel_campus.actions.open_campus"), street_challenges_path, class: "btn btn-navy" %>
          <% end %>
        </section>
      <% end %>

      <button type="button"
              class="street-ceremony-chest-wrap"
              aria-label="<%= t("street.ceremony_chest_replay") %>"
              data-action="click->street-motion#replayChest">
        <span class="street-ceremony-pedestal" aria-hidden="true"></span>
        <span class="street-ceremony-starburst" aria-hidden="true"></span>
        <span class="street-ceremony-chest-aura" aria-hidden="true"></span>
        <span class="street-ceremony-chest"><% if chest_src %><img src="<%= chest_src %>" alt="" class="street-ceremony-chest-img"><% else %><%= picto("chest") %><% end %></span>
        <% if complete.streak_bonus.positive? %>
          <span class="street-ceremony-chest-reward"><%= t("street.ceremony_chest_bonus", count: complete.streak_bonus) %></span>
        <% end %>
      </button>

      <div class="street-ceremony-boards">
        <%= render "home/street_ceremony_board", title: t("street.ceremony_best_players"), icon: "trophy", rows: pack_rows, empty: t("street.leaderboard_empty") %>
      </div>

      <footer class="street-ceremony-actions">
        <% if current_street_person %>
          <button type="button" class="btn street-ceremony-share street-ceremony-viral-cta" data-controller="street-share" data-action="street-share#challenge" data-street-share-run-id-value="<%= street.run.id %>" data-street-share-source-value="ceremony" data-street-share-endpoint-value="<%= viral_events_path %>" data-street-share-impression-value="invite_prompt_seen" data-street-share-text-value="<%= t("duel_campus.share.score", name: current_street_person.given_name, score: complete.score) %>" data-street-share-url-value="<%= street_challenges_path %>">
            <span class="street-ceremony-button-icon" aria-hidden="true">❦</span><span class="street-ceremony-button-label"><%= t("duel_campus.actions.invite_from_score") %></span><span class="street-ceremony-button-tail" aria-hidden="true"><%= picto("star4") %></span>
          </button>
          <%= link_to street_challenges_path, class: "btn street-challenge-btn" do %><span class="street-ceremony-button-icon" aria-hidden="true">✦</span><span class="street-ceremony-button-label"><%= t("duel_campus.actions.open_campus") %></span><span class="street-ceremony-button-tail" aria-hidden="true"><%= picto("arrow") %></span><% end %>
        <% else %>
          <%= link_to t("duel_campus.actions.join"), street_profile_path(quick: 1, fresh: 1), class: "btn street-challenge-btn" %>
        <% end %>
        <%= link_to street_map_path(rank_up: complete.rank_up ? 1 : nil, unlock: Quizzes::Complete.unlock_pack_id(street.run)), class: "btn street-ceremony-map" do %><span class="street-ceremony-button-icon" aria-hidden="true"><%= picto("compass") %></span><span class="street-ceremony-button-label"><%= t("street.ceremony_back_map") %></span><span class="street-ceremony-button-tail" aria-hidden="true"><%= picto("arrow") %></span><% end %>
      </footer>
    </div>
  </div>
</div>
