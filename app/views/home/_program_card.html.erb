<% poster = night_poster_src("reyes_y_profetas") %>
<article class="night-card night-program">
  <% if poster %>
    <img class="night-poster" src="<%= poster %>" alt="<%= theme.title %>">
  <% end %>
  <div class="night-copy">
    <p class="eyebrow">Noche de hogar</p>
    <h2><%= theme.title %></h2>
    <p class="lede"><%= theme.tagline %></p>
  </div>
  <ul class="night-acts">
    <li><%= picto("star") %><span>Quiz</span></li>
    <li><%= picto("hands") %><span>Juegos</span></li>
    <li><%= picto("dancer") %><span>Danza</span></li>
    <li><%= picto("trophy") %><span>Premios</span></li>
  </ul>
</article>
