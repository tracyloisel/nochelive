<% run = street.run %>
<% question = street.question %>
<% pack = street.pack %>
<% snap = street.asking? ? "mid" : "open" %>
<% quiz_standings = local_assigns[:standings] %>
<% extra_sfx = local_assigns[:sfx] %>
<% extra_fx = local_assigns[:fx] %>
<% duel_campus = local_assigns[:duel_campus] %>
<% play_context = local_assigns[:play_context] %>
<% overlay = %i[jugar live].include?(play_context) %>
<% live = play_context == :live %>
<% chrome = local_assigns[:chrome] || if overlay && street.done?
  Quizzes::Chrome.ceremony(outcomes: duel_campus&.impacts&.map(&:outcome))
elsif overlay
  Quizzes::Chrome.call(question: question)
end %>
<% combo = overlay ? Quizzes::HitStreak.call(run: run) : nil %>
<% reward = street.reward %>
<% still = street_still_src(question) %>
<% shell = street_quiz_shell_attributes(street:, overlay:, chrome:, combo:, extra_sfx:, extra_fx:) %>

<%= tag.section id: "street_quiz",
      class: shell[:class],
      data: shell[:data] do %>
  <% if live && street.done? %>
    <%= render "home/live_quiz_ceremony", street:, run:, question:, pack:, chrome:, night: local_assigns[:night], player: local_assigns[:player] %>
  <% elsif overlay && street.done? %>
    <%= render "home/street_overlay_ceremony",
          street: street,
          run: run,
          question: question,
          pack: pack,
          quiz_standings: quiz_standings,
          combo: combo,
          duel_campus: duel_campus,
          chrome: chrome %>
  <% elsif overlay %>
    <%= render "home/street_overlay",
          street: street,
          run: run,
          question: question,
          pack: pack,
          still: still,
          quiz_standings: quiz_standings,
          chrome: chrome,
          combo: combo,
          duel_campus: duel_campus,
          live: live,
          night: local_assigns[:night] %>
  <% else %>
    <div class="play-shot">
      <% if still %>
        <div class="challenge-media">
          <%= noche_media_picture(still, alt: "", class_name: "challenge-story", loading: "eager", fetchpriority: "high") %>
        </div>
      <% end %>
      <% if street.settled? && street.answer&.correct? %>
        <% shout = street_praise_line(run, question) %>
        <p class="street-praise" role="status" aria-label="<%= shout %> <%= t("quiz.points_gained", count: reward&.points_awarded.to_i) %>">
          <span class="street-praise-line"><%= shout %></span>
          <span class="street-praise-crowns" aria-hidden="true">+<%= reward&.points_awarded.to_i %></span>
        </p>
      <% end %>
      <% if street.settled? && !street.done? %>
        <div class="street-shot-actions">
          <%= link_to scripture_path(question.scripture.study, cite: question.scripture.cite),
                class: "btn btn-navy quiz-scripture",
                aria: { label: "#{t("quiz.read")} #{question.scripture.cite}" },
                data: {
                  turbo_frame: "scripture_reader",
                  action: "click->scripture-launcher#prepare",
                  scripture_chapter_title: scripture_reader_reference_label(question.scripture.study)
                } do %>
            <span class="quiz-read"><%= t("quiz.read") %></span>
            <span class="quiz-cite"><%= question.scripture.cite %></span>
          <% end %>
          <%= button_to quiz_advance_path(street.run),
                class: "btn btn-gold quiz-next",
                form: { data: { turbo_stream: true }, class: "quiz-next-form" },
                data: { action: "click->quiz#next" } do %>
            <%= t("quiz.next") %><%= picto("arrow") %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="play-chrome">
      <%= render "home/street_person", standings: quiz_standings %>
      <% unless street.done? %>
        <p class="street-score <%= "is-tick" if street.settled? && street.answer&.correct? %>"
           aria-label="<%= t("chrome.crowns", score: run.score) %>">
          <%= picto("star") %>
          <span><%= run.score %></span>
          <% if street.settled? && street.answer&.correct? %>
            <span class="street-crowns-pop" aria-hidden="true">+<%= reward&.points_awarded.to_i %></span>
          <% end %>
        </p>
        <% if quiz_standings&.pack_rank %>
          <p class="street-rank" aria-label="<%= t("street.rank_in_ward", rank: quiz_standings.pack_rank, title: quiz_standings.rank_title) %>">
            <span class="street-rank-num">#<%= quiz_standings.pack_rank %></span>
            <span class="street-rank-title"><%= quiz_standings.rank_title %></span>
          </p>
        <% end %>
      <% end %>
      <% if street.asking? && question.timed? %>
        <%= render "play/timer", round: run, expire_url: quiz_expire_path(run) %>
      <% end %>
    </div>

    <div class="street-quiz-card">
      <% unless street.done? %>
        <span class="street-quiz-apex" aria-hidden="true"><%= picto("star4") %></span>
      <% end %>
      <div class="play-sheet story-sheet"
           data-controller="sheet"
           data-sheet-mid-ratio-value="0.48"
           data-sheet-peek-ratio-value="0.12"
           data-sheet-snap="<%= snap %>"
           data-sheet-snap-value="<%= snap %>"
           data-sheet-open-label-value="<%= t("chrome.grip_open") %>"
           data-sheet-mid-label-value="<%= t("chrome.grip_mid") %>"
           data-sheet-peek-label-value="<%= t("chrome.grip_peek") %>"
           data-action="pointerdown->sheet#start">
        <% unless street.asking? %>
          <button type="button"
                  class="play-sheet-grip"
                  data-sheet-target="handle"
                  data-action="click->sheet#cycle"
                  aria-label="<%= t("chrome.grip") %>"
                  aria-valuetext="<%= t("chrome.grip_mid") %>">
            <span class="play-sheet-pip" aria-hidden="true"></span>
          </button>
        <% end %>
        <div class="play-sheet-body" data-sheet-target="body">
          <div class="play-stage">
            <% if street.done? %>
              <%= render "home/street_done", street: street, duel_campus: duel_campus %>
            <% elsif street.asking? %>
              <p class="prompt"><%= question.copy(:question) %></p>
              <p class="street-quiz-rule" aria-hidden="true"></p>
              <%= render "home/street_choices", street: street %>
            <% else %>
              <%= render "home/street_settled", street: street, pack: pack, run: run %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
