<% run = street.run %>
<% question = street.question %>
<% pack = street.pack %>
<% snap = street.asking? ? "mid" : "open" %>
<% street_trail = local_assigns[:street_trail] || Quizzes::Trail.call(run: run) %>
<% quiz_standings = local_assigns[:standings] %>
<% extra_sfx = local_assigns[:sfx] %>
<% extra_fx = local_assigns[:fx] %>
<% still = street_still_src(question) %>
<% nxt = street_next_still(street) %>

<%= tag.section id: "street_quiz",
      class: [ "play-card", "play-reel", "is-quiz", "is-street", ("is-settled" if street.settled?), ("is-done" if street.done?) ],
      data: street_audio_data(run, question, extra_sfx:, extra_fx:).merge(
        controller: "quiz story",
        story_street_value: true,
        quiz_correct_value: question.correct_choice,
        quiz_next_image_value: nxt,
        quiz_rewind_url_value: quiz_rewind_path(run),
        intensity: question.intensity,
        action: "pointerdown->story#start click->quiz#pick turbo:submit-start->quiz#lock"
      ) do %>
  <div class="play-shot">
    <% if still %>
      <div class="challenge-media">
        <img src="<%= still %>" alt="" class="challenge-story">
      </div>
    <% end %>
  </div>

  <div class="play-chrome">
    <%= render "home/street_person", standings: quiz_standings %>
    <% unless street.done? %>
      <p class="street-score <%= "is-tick" if street.settled? && street.answer&.correct? %>"
         aria-label="<%= t("chrome.points", score: run.score) %>">
        <%= picto("star") %>
        <span><%= run.score %></span>
        <% if street.settled? && street.answer&.correct? %>
          <span class="street-points-pop" aria-hidden="true">+<%= question.points %></span>
        <% end %>
      </p>
      <% if quiz_standings&.pack_rank %>
        <p class="street-rank" aria-label="<%= t("street.rank_in_ward", rank: quiz_standings.pack_rank, title: quiz_standings.rank_title) %>">
          <span class="street-rank-num">#<%= quiz_standings.pack_rank %></span>
          <span class="street-rank-title"><%= quiz_standings.rank_title %></span>
        </p>
      <% end %>
    <% end %>
    <% if street.asking? && question.timed? %>
      <%= render "play/timer", round: run, expire_url: quiz_expire_path(run) %>
    <% end %>
  </div>

  <div class="play-sheet story-sheet"
       data-controller="sheet"
       data-sheet-mid-ratio-value="0.36"
       data-sheet-peek-ratio-value="0.12"
       data-sheet-snap="<%= snap %>"
       data-sheet-snap-value="<%= snap %>"
       data-sheet-open-label-value="<%= t("chrome.grip_open") %>"
       data-sheet-mid-label-value="<%= t("chrome.grip_mid") %>"
       data-sheet-peek-label-value="<%= t("chrome.grip_peek") %>"
       data-action="pointerdown->sheet#start">
    <button type="button"
            class="play-sheet-grip"
            data-sheet-target="handle"
            data-action="click->sheet#cycle"
            aria-label="<%= t("chrome.grip") %>"
            aria-valuetext="<%= t("chrome.grip_mid") %>">
      <span class="play-sheet-pip" aria-hidden="true"></span>
    </button>
    <div class="play-sheet-body" data-sheet-target="body">
      <div class="play-stage">
        <% if street.done? %>
          <%= render "home/street_done", street: street %>
        <% else %>
          <% unless street.settled? %>
            <%= render "home/street_map", street: street, street_trail: street_trail %>
            <p class="round-title">
              <span class="quiz-pack"><%= pack.copy(:title) %></span>
              <span class="quiz-progress"><%= t("quiz.progress", n: run.position, total: pack.questions.size) %></span>
            </p>
          <% end %>
          <% if street.asking? %>
            <p class="prompt"><%= question.copy(:question) %></p>
            <%= render "home/street_choices", street: street %>
          <% else %>
            <%= render "home/street_settled", street: street, pack: pack, run: run %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
