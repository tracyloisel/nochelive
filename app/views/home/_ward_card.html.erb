<% poster = ward_poster_src(ward) %>
<% live = ward.live_night %>
<%= form_with url: local_assigns.fetch(:pick_url, enter_ward_path), method: :post, class: "ward-card" do %>
  <input type="hidden" name="code" value="<%= ward.code %>">
  <button type="submit" class="ward-hit" aria-label="<%= ward.name %>">
    <% if poster %>
      <div class="night-still">
        <img class="night-poster" src="<%= poster %>" alt="">
      </div>
    <% end %>
    <div class="night-copy">
      <span class="emblem emblem-lg emblem-<%= ward.emblem %>"><%= render "shared/emblem", key: ward.emblem %></span>
      <p class="night-status">
        <% if live %><span class="live-dot"></span> <%= t("home.live") %> · <% end %>
        <%= t("ward.nights_count", count: ward.nights_count) %>
      </p>
      <h2><%= ward.name %></h2>
      <% if ward_place(ward).present? %>
        <p class="lede ward-place"><%= picto("pin") %><%= ward_place(ward) %></p>
      <% end %>
    </div>
  </button>
<% end %>
