<% question = street.question %>
<% answer = street.answer %>
<% right = answer&.correct? %>
<div class="quiz-board is-settled <%= "is-right" if right %> <%= "is-wrong" unless right %>">
  <div class="quiz-verdict <%= right ? "is-right" : "is-wrong" %>" role="status">
    <p class="quiz-shout"><%= right ? t("quiz.correct") : t("quiz.incorrect") %></p>
    <p class="quiz-answer"><%= question.copy(:answer) %></p>
  </div>
  <div class="quiz-bars" aria-label="<%= t("quiz.crowd") %>">
    <% Array(street.tally).each_with_index do |row, index| %>
      <% mark = choice_mark(index) %>
      <% picked = row.key == answer.choice_key.to_s %>
      <% label = question.choice_copy({ "key" => row.key, "label" => row.label }) %>
      <div class="quiz-bar choice-<%= mark[:tone] %> <%= "is-correct is-right" if row.correct %> <%= "is-picked" if picked %> <%= "is-wrong is-miss" if picked && !row.correct %>"
           role="img"
           aria-label="<%= label %>, <%= row.percent %>%">
        <span class="quiz-fill" data-share="<%= row.percent %>"></span>
        <span class="choice-mark" aria-hidden="true"><%= picto(mark[:shape]) %></span>
        <span class="word"><%= label %></span>
        <% if row.correct %>
          <span class="quiz-flag" aria-hidden="true"><%= picto("check") %></span>
        <% end %>
        <span class="quiz-pct"><%= row.percent %>%</span>
      </div>
    <% end %>
  </div>
  <p class="quiz-scripture">
    <%= link_to Quizzes::Scripture.url(question), class: "quiet-link", target: "_blank", rel: "noopener" do %>
      <%= t("quiz.read_more") %><span class="quiz-cite"> · <%= question.scripture.cite %></span>
    <% end %>
  </p>
  <%= button_to quiz_advance_path(street.run),
        class: "btn btn-gold quiz-next",
        form: { data: { turbo_stream: true } },
        data: { action: "click->quiz#next" } do %>
    <%= t("quiz.next") %><%= picto("arrow") %>
  <% end %>
</div>
