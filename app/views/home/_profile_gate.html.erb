<% if local_assigns[:profile_gate] %>
  <div id="profile_gate">
    <aside class="claim-veil profile-gate" role="dialog" aria-modal="true" aria-labelledby="profile-gate-title">
      <div class="claim-modal profile-gate-modal">
        <% if gate_ward.blank? %>
          <h1 id="profile-gate-title"><%= t("street.gate_ward_title") %></h1>
          <p class="lede"><%= t("street.gate_ward_lede") %></p>
          <%= render "street_hub/ward_picker", pick: "rama" %>
        <% else %>
          <%= render "street_hub/identity_steps",
                screen: local_assigns[:gate_screen],
                person: local_assigns[:gate_person],
                people: gate_people,
                not_me_path: root_path(not_me: 1),
                someone_else_path: root_path(fresh: 1) %>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>
