<section class="home-paper">
  <header class="home-brand">
    <%= render "shared/street_hub_lockup", heading: true, kicker: t("home.nights") %>
  </header>
  <nav class="home-doors" aria-label="<%= t("church.invite") %>">
    <%= link_to t("church.invite"), church_path, class: "btn btn-gold" %>
  </nav>

  <section class="home-feed home-upcoming">
    <h2>
      <span class="street-hub-rule" aria-hidden="true"></span>
      <span class="home-feed-title"><%= t("home.upcoming") %></span>
      <span class="street-hub-rule" aria-hidden="true"></span>
    </h2>
    <% if upcoming.any? %>
      <div class="night-menu">
        <% upcoming.each do |night| %>
          <%= render "home/night_card", night: night %>
        <% end %>
      </div>
    <% else %>
      <p class="lede home-empty"><%= t("home.empty_upcoming") %></p>
    <% end %>
  </section>

  <section class="home-feed home-past">
    <h2>
      <span class="street-hub-rule" aria-hidden="true"></span>
      <span class="home-feed-title"><%= t("home.past") %></span>
      <span class="street-hub-rule" aria-hidden="true"></span>
    </h2>
    <% if past.any? %>
      <div class="night-menu">
        <% past.each do |night| %>
          <%= render "home/night_card", night: night %>
        <% end %>
      </div>
    <% else %>
      <p class="lede home-empty"><%= t("home.empty_past") %></p>
    <% end %>
  </section>
</section>
