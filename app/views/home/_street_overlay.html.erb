<div class="play-shot quiz-world">
  <% if still %>
    <div class="challenge-media">
      <%= noche_media_picture(still, alt: "", class_name: "challenge-story", loading: "eager", fetchpriority: "high") %>
    </div>
  <% end %>

  <%= render "home/street_quiz_hud",
        street: street,
        run: run,
        question: question,
        pack: pack,
        quiz_standings: quiz_standings,
        combo: combo,
        theme: chrome.mode %>

  <% if local_assigns[:duel_campus] %>
    <%= render "home/duel_campus_rail", campus: local_assigns[:duel_campus], run: run %>
  <% end %>

  <%= render "home/street_overlay_feedback", street:, run:, question:, combo: %>
  <%= render "home/street_overlay_dock", street:, run:, question:, pack: %>
</div>
