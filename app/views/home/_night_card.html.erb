<% count = night.players.count(&:participant?) %>
<% poster = night_poster_src(night) %>
<article class="night-card">
  <%= link_to home_night_path_for(night), class: "night-hit", aria: { label: t("home.enter_night", title: night_title(night), code: night.code) } do %>
    <% if poster %>
      <img class="night-poster" src="<%= poster %>" alt="">
    <% end %>
    <div class="night-copy">
      <p class="live night-status">
        <% if night.playing? %><span class="live-dot"></span><% end %>
        <%= night_status_caption(night) %>
        · <%= l(night.starts_at.to_date) %>
        · <%= night.ward.name %>
      </p>
      <h2><%= night_title(night) %></h2>
      <p class="lede"><%= t("play.players", count: count) %></p>
    </div>
  <% end %>
</article>
