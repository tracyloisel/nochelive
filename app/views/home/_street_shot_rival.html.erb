<% rival = local_assigns[:rival] %>
<% src = avatar_mark(rival.person) %>
<% gap = rival.pack_gap.to_i > 0 ? rival.pack_gap : rival.gap %>
<% others = rival.others.to_i %>
<% label = t("street.shot_rival", name: rival.person.given_name) %>
<% label = "#{label}. #{t("street.shot_rival_gap", gap: gap)}" if gap.to_i > 0 %>
<% label = "#{label}. #{t("street.shot_rival_more", count: others)}" if others.positive? %>

<article class="street-shot-rival <%= "is-live" if rival.live %>" aria-label="<%= label %>">
  <span class="street-shot-rival-face <%= "is-live" if rival.live %>">
    <% if src %>
      <img src="<%= src %>" alt="" class="avatar-img street-shot-rival-avatar" width="40" height="40">
    <% else %>
      <span class="avatar-fallback street-shot-rival-avatar" aria-hidden="true"><%= rival.person.given_name.to_s.first %></span>
    <% end %>
    <%= street_live_dot(rival.live) %>
  </span>
  <div class="street-shot-rival-body">
    <span class="street-shot-rival-name"><%= rival.person.given_name %></span>
    <span class="street-shot-rival-meta">
      <% if gap.to_i > 0 %>
        <span class="street-shot-rival-gap"><%= t("street.shot_rival_gap", gap: gap) %></span>
      <% end %>
      <% if others.positive? %>
        <span class="street-shot-rival-more"><%= t("street.shot_rival_more", count: others) %></span>
      <% end %>
    </span>
  </div>
</article>
