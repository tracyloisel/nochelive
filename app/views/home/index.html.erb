<% content_for :title, "Noche Live" %>
<% content_for :body_class, "is-kid" %>
<% nights = @nights.to_a %>
<% featured = nights.first %>
<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(featured), poster: true, icon: "sparkle" %>
<% end %>
<%= story_reel shot: shot, chrome: nil, snap: "mid", mid: 0.42, handle: false, reel_class: "is-home", skip: "Desliza abajo para salir. Arriba abre el juego." do %>
  <div class="home-brand">
    <h1>Noche Live</h1>
  </div>
  <p class="lede">Elige tu noche. En la sala y en casa.</p>

  <%= form_with url: join_path, method: :post, class: "join-form home-join" do %>
    <label for="code">Código de la noche</label>
    <input id="code" name="code" inputmode="text" autocomplete="off" autocapitalize="characters" maxlength="8" required class="code-input" placeholder="<%= featured&.code.presence || "DEMO" %>">
    <button type="submit" class="btn btn-gold"><%= picto("door") %>Entrar</button>
    <p class="door-links">
      <button type="submit" name="as" value="present" class="quiet-link">Soy el presentador</button>
      <button type="submit" name="as" value="watch" class="quiet-link">Solo ver</button>
    </p>
  <% end %>

  <div class="night-menu">
    <% if nights.any? %>
      <% nights.each do |night| %>
        <%= render "home/night_card", night: night %>
      <% end %>
    <% else %>
      <%= render "home/program_card", theme: @theme %>
    <% end %>

    <article class="night-card-new">
      <div class="night-create-art" aria-hidden="true"><%= picto("wand") %></div>
      <p class="eyebrow">Presentador</p>
      <h2>¿Presentas tú?</h2>
      <p class="lede">Abre una noche para tu rama. Se crea un código corto.</p>
      <%= link_to new_game_session_path, class: "btn btn-navy" do %>
        <%= picto("wand") %>Crear una noche
      <% end %>
    </article>
  </div>

  <% if @memories.any? %>
    <section class="memory-shelf">
      <p class="eyebrow">Noches de la rama</p>
      <h2>Lo que recordamos</h2>
      <% @memories.each do |night| %>
        <%= render "home/memory_card", night: night %>
      <% end %>
    </section>
  <% end %>
<% end %>
