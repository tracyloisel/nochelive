<% ballot = player.ballots.find_by(round_run: round) %>
<% others = night.teams.where.not(id: team.id).order(:name) %>

<% if round.revealed? || round.locked? %>
  <% if line = vote_tally_line(round) %>
    <div class="lock lock-gold" role="status">
      <%= picto("trophy", size: "lg") %>
      <p class="place"><%= line %></p>
    </div>
  <% end %>
  <%= render "play/reveal", definition: definition, team: team, round: round if round.revealed? %>
<% elsif ballot %>
  <p class="prompt"><%= definition.copy(:question) %></p>
  <%= render "shared/wait", message: t("play.vote_sent") %>
<% elsif others.empty? %>
  <p class="lede"><%= definition.copy(:instructions) %></p>
  <%= render "shared/wait", message: t("play.need_team") %>
<% elsif round.open? %>
  <p class="prompt"><%= definition.copy(:question) %></p>
  <p class="lede"><%= definition.copy(:instructions) %></p>
  <ul class="team-list">
    <% others.each do |other| %>
      <li>
        <%= button_to night_round_run_vote_path(night.code, round), params: { team_id: other.id }, class: "team-pick" do %>
          <span class="emblem emblem-lg emblem-<%= other.emblem %>"><%= render "shared/emblem", key: other.emblem %></span>
          <strong><%= other.name %></strong>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="lede"><%= definition.copy(:instructions) %></p>
  <%= render "shared/wait", message: t("play.judgment_comes") %>
<% end %>
