<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif explainer?(team, player) %>
  <div class="put-down-art" aria-hidden="true"><%= picto("speak", size: "xl") %></div>
  <p class="prompt put-down"><%= t("play.you_explain") %></p>
  <p class="secret-target"><%= definition.copy(:target) %></p>
  <p class="lede"><%= t("play.taboo_lede") %></p>
  <ul class="forbidden" aria-label="<%= t("play.forbidden") %>">
    <% definition.forbidden_copy.each do |word| %>
      <li><%= word %></li>
    <% end %>
  </ul>
  <% unless round.open? %>
    <%= render "shared/wait", message: t("play.read_quiet") %>
  <% end %>
<% else %>
  <div class="put-down-art" aria-hidden="true"><%= picto("ear", size: "xl") %></div>
  <p class="prompt put-down"><%= t("play.guess") %></p>
  <p class="lede">
    <% if host = team_explainer(team) %>
      <%= t("play.listen_to", name: host.name) %>
    <% else %>
      <%= t("play.listen_room") %>
    <% end %>
  </p>
  <% if player_remote?(player) && round.open? && answer.nil? %>
    <%= form_with url: night_round_run_answer_path(night.code, round), class: "answer-form" do %>
      <label for="body"><%= t("play.home_guess") %></label>
      <input id="body" name="body" maxlength="80" class="code-input" placeholder="<%= t("play.guess_ph") %>" autocomplete="off">
      <button class="btn btn-gold picto-btn" type="submit"><%= picto("send") %><%= t("play.send") %></button>
    <% end %>
  <% elsif answer %>
    <p class="sent" role="status"><%= t("play.idea_sent") %></p>
  <% elsif player_remote?(player) %>
    <%= render "shared/wait", message: t("play.ears_ready") %>
  <% else %>
    <%= render "shared/wait", message: t("play.shout_when") %>
  <% end %>
<% end %>
