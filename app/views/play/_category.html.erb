<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif player_remote?(player) %>
  <div class="put-down-art" aria-hidden="true"><%= picto("speak", size: "xl") %></div>
  <p class="prompt put-down">¡DECID!</p>
  <p class="lede"><%= definition.remote_variant&.fetch("instructions", definition.instructions) %></p>
  <% if answer %>
    <p class="sent" role="status">Nombres enviados. El presentador escucha la sala.</p>
  <% elsif round.open? %>
    <%= form_with url: night_round_run_answer_path(night.code, round), class: "answer-form" do %>
      <label for="body">Tres profetas</label>
      <input id="body" name="body" maxlength="140" required class="code-input" placeholder="Elías, Daniel…" autocomplete="off">
      <button class="btn btn-gold picto-btn" type="submit"><%= picto("send") %>Enviar</button>
    <% end %>
  <% else %>
    <%= render "shared/wait", message: "Preparad los nombres. El presentador va a abrir." %>
  <% end %>
<% else %>
  <div class="put-down-art" aria-hidden="true"><%= picto("speak", size: "xl") %></div>
  <p class="prompt put-down">¡DECID!</p>
  <p class="lede"><%= definition.instructions %></p>
  <% if round.open? && round.opened_at %>
    <p class="countdown" data-controller="countdown" data-countdown-end-value="<%= (round.opened_at + definition.duration.seconds).iso8601 %>">
      <span data-countdown-target="label"><%= definition.duration %></span> s
    </p>
  <% end %>
  <% if answer %>
    <div class="lock lock-gold" role="status">
      <p class="place">¡Ya!</p>
      <p>El presentador cuenta.</p>
    </div>
  <% elsif round.open? %>
    <%= form_with url: night_round_run_answer_path(night.code, round), class: "hunt-form" do %>
      <input type="hidden" name="body" value="¡Ya!">
      <button class="buzz hunt-btn" type="submit">
        <%= picto("speak", size: "xl") %>
        <span>¡YA!</span>
      </button>
    <% end %>
    <p class="hint">Gritad. Luego golpead.</p>
  <% else %>
    <%= render "shared/wait", message: "Abrid la boca. El presentador va a abrir." %>
  <% end %>
<% end %>
