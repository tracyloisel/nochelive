<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(night) %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: night, title: "#{night.code} · #{night_title(night)}", ticks: false, live: false, close: true %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "open", mid: 0.62, handle: false, reel_class: "is-pick" do %>
  <h1><%= t("play.pick_team") %></h1>

  <% last_id = current_player&.person&.last_ward_team_id %>
  <% if night.teams.chapel.any? %>
    <ul class="team-list">
      <% night.teams.chapel.includes(:players, :ward_team).each do |team| %>
        <% yours = last_id.present? && team.ward_team_id == last_id %>
        <li>
          <%= button_to night_team_memberships_path(night.code, team), class: "team-pick #{'is-yours' if yours}" do %>
            <span class="emblem emblem-lg emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
            <strong><%= team.name %></strong>
            <small>
              <%= t("play.players", count: team.players.size) %>
              <% if team.ward_team %>
                · <%= t("play.season", rank: rank_name(team.ward_team.season_rank_label)) %>
              <% end %>
              <% if yours %>
                · <%= t("play.your_team") %>
              <% end %>
            </small>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2 class="subhead"><%= t("play.create_team") %></h2>
  <%= form_with url: night_teams_path(night.code), class: "join-form" do %>
    <label for="team_name"><%= t("play.team_name") %></label>
    <input id="team_name" name="name" maxlength="28" required class="code-input" placeholder="<%= t("play.team_ph") %>" autocomplete="off">
    <fieldset class="emblem-pick">
      <legend><%= t("play.emblem") %></legend>
      <% Team::EMBLEMS.each do |key, _label| %>
        <label class="emblem-choice">
          <input type="radio" name="emblem" value="<%= key %>" <%= "checked" if key == "leon" %>>
          <span class="emblem emblem-lg emblem-<%= key %>"><%= render "shared/emblem", key: key %></span>
          <em><%= emblem_name(key) %></em>
        </label>
      <% end %>
    </fieldset>
    <button type="submit" class="btn btn-gold"><%= picto("plus") %><%= t("play.create") %></button>
  <% end %>
<% end %>
