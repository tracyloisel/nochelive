<main class="noche-team-pick" style="--team-art: url('<%= night_still_src(night) %>')">
  <section class="noche-team-pick-panel">
    <header><span class="noche-live-brand"><%= picto("crown") %> Noche Live</span><p><%= night.ward.name %></p><h1><%= t("nights.choose_team") %></h1></header>
    <% last_id = current_player&.person&.last_ward_team_id %>
    <ul class="team-list">
      <% night.teams.includes(:players, :ward_team).order(:name).each do |team| %>
        <% yours = last_id.present? && team.ward_team_id == last_id %>
        <li>
          <%= button_to night_team_memberships_path(night.code, team), class: "team-pick #{'is-yours' if yours}" do %>
            <span class="emblem emblem-lg emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
            <strong><%= team.name %></strong>
            <small><%= t("nights.players_count", count: team.players.size) %><%= " · #{t('nights.your_team')}" if yours %></small>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</main>
