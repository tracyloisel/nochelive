<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(night), icon: "sparkle" %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: night, title: night_title(night), team: team, player: player, ticks: false, live: false, close: true %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "open", mid: 0.62, handle: false, reel_class: "is-rank peak" do %>
  <div class="rank-up" role="status">
    <p class="eyebrow"><%= t("play.rank_new") %></p>
    <h1><%= rank_name(team.pending_rank_up) %></h1>
    <p class="lede"><%= t("play.rank_changed", name: team.name) %></p>
    <% if team.rey? %>
      <div class="role-gift" role="status">
        <%= picto("trophy") %>
        <p class="stand-up"><%= t("play.you_are_king") %></p>
        <p class="lede"><%= t("play.next_double") %></p>
      </div>
    <% end %>
    <%= button_to night_rank_up_path(night.code), class: "btn btn-gold" do %>
      <%= picto("sparkle") %><%= t("play.continue") %>
    <% end %>
  </div>
<% end %>
