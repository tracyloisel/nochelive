<% targets = burger_cheer_targets(night) %>
<% sent = layer_cheers(round).find { |cheer| cheer.player_id == player.id } %>
<% if targets[:mode] == :empty %>
  <p class="lede">Nadie en la sala. El burger es vuestro.</p>
<% elsif sent %>
  <p class="sent" role="status">¡<%= sent.to_player.name %> te oye!</p>
<% else %>
  <div class="cheer-dock">
    <div class="cheer-faces">
      <% if targets[:mode] == :faces %>
        <% targets[:faces].each do |face| %>
          <%= button_to night_round_run_cheer_path(night.code, round),
                params: { to_player_id: face.id },
                class: "picture-card team-pick" do %>
            <%= render "shared/avatar", player: face %>
            <span class="word">Anima a <%= face.name %></span>
          <% end %>
        <% end %>
      <% else %>
        <% targets[:teams].each do |row| %>
          <% explainer = team_explainer(row) %>
          <% next unless explainer %>
          <%= button_to night_round_run_cheer_path(night.code, round),
                params: { to_player_id: explainer.id },
                class: "emblem-choice" do %>
            <span class="emblem emblem-<%= row.emblem %>"><%= render "shared/emblem", key: row.emblem %></span>
            <em><%= row.name %></em>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
