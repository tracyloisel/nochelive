<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% else %>
  <div class="put-down-art" aria-hidden="true"><%= picto("search", size: "xl") %></div>
  <p class="prompt put-down"><%= t("play.hunt") %></p>
  <% if player_remote?(player) && definition.remote_variant %>
    <p class="lede"><%= definition.remote_instructions %></p>
  <% else %>
    <p class="lede"><%= definition.copy(:instructions) %></p>
  <% end %>
  <% if answer %>
    <div class="lock lock-gold" role="status">
      <%= picto("found", size: "lg") %>
      <p class="place"><%= t("play.we_have_it") %></p>
      <p><%= t("play.show_it") %></p>
    </div>
  <% elsif round.open? %>
    <%= form_with url: night_round_run_answer_path(night.code, round), class: "hunt-form" do %>
      <input type="hidden" name="body" value="¡Lo tenemos!">
      <button class="buzz hunt-btn" type="submit">
        <%= picto("found", size: "xl") %>
        <span><%= t("play.we_have_shout") %></span>
      </button>
    <% end %>
    <p class="hint"><%= t("play.run_then") %></p>
  <% else %>
    <%= render "shared/wait", message: t("play.hunt_wait") %>
  <% end %>
<% end %>
