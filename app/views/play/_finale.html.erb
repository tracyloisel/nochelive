<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(night), sparks: true, icon: "trophy" %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: night, title: night_title(night), team: team, player: player %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "mid", mid: 0.46, reel_class: "is-finale peak" do %>
  <%= render "shared/ceremony", night: night, you: team %>
<% end %>
