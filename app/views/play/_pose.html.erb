<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif player_remote?(player) %>
  <% if hold&.finished? %>
    <div class="lock lock-gold" role="status">
      <%= picto("statue", size: "lg") %>
      <p class="place">¡Plantados!</p>
      <p>Habéis sostenido la estatua.</p>
    </div>
  <% elsif round.open? %>
    <p class="prompt put-down">David frente a Goliat.</p>
    <p class="lede">Mantén la pose. No sueltes.</p>
    <div data-controller="pose"
         data-pose-url-value="<%= night_round_run_pose_hold_path(night.code, round) %>"
         data-pose-goal-value="<%= PoseHold::GOAL_MS %>">
      <button type="button" class="buzz sling-btn" data-pose-target="button" data-action="pointerdown->pose#hold pointerup->pose#release pointerleave->pose#release pointercancel->pose#release">
        <%= picto("statue", size: "xl") %>
        <span>Sostener</span>
      </button>
      <p class="hint"><span data-pose-target="count">0</span> / 8 s</p>
    </div>
  <% else %>
    <%= render "shared/wait", message: "Esperad la señal para la estatua." %>
  <% end %>
<% else %>
  <div class="put-down-art" aria-hidden="true"><%= picto("phone", size: "xl") %></div>
  <p class="prompt put-down">DEJAD EL TELÉFONO.</p>
  <p class="lede"><%= definition.instructions %></p>
  <% if round.open? && round.opened_at %>
    <p class="countdown" data-controller="countdown" data-countdown-end-value="<%= (round.opened_at + definition.duration.seconds).iso8601 %>">
      <span data-countdown-target="label"><%= definition.duration %></span> s
    </p>
  <% end %>
  <p class="hint">El presentador ve la sala y anota.</p>
<% end %>
