<div class="progress" role="status">
  <p class="rank"><%= t("play.xp", rank: rank_name(team.rank_key), xp: team.xp) %></p>
  <div class="xp" aria-label="<%= t("play.progress", rank: rank_name(team.next_rank_label)) %>">
    <span style="width: <%= team.xp_progress %>%"></span>
  </div>
  <p class="quiet tiny"><%= t("play.next_rank", rank: rank_name(team.next_rank_label)) %></p>
  <% if team.ward_team %>
    <p class="quiet tiny"><%= t("play.season_rank", rank: rank_name(team.ward_team.season_rank_label)) %></p>
  <% end %>
  <% if team.rey? %>
    <p class="role" role="status"><%= t("play.king_next") %></p>
  <% end %>
</div>
