<p class="prompt"><%= definition.copy(:question) %></p>

<% if round.open? && buzz.nil? %>
  <%= button_to night_round_run_buzz_path(night.code, round), class: "buzz", data: { controller: "buzzer", action: "buzzer#lock" } do %>
    <%= picto("bell", size: "xl") %>
    <span><%= t("play.buzz") %></span>
  <% end %>
  <p class="hint"><%= t("play.first_hint") %></p>
<% elsif buzz %>
  <div class="lock <%= "lock-gold" if buzz.first? %>" role="status">
    <% if buzz.first? %>
      <div class="mini-crown" aria-hidden="true"><%= picto("trophy", size: "lg") %></div>
      <span class="sparks" aria-hidden="true"></span>
    <% end %>
    <p class="place"><%= buzz.medal %></p>
    <p class="delay"><%= latency_label(buzz.latency_ms) %></p>
    <p><%= buzz.first? ? t("play.buzzed_first") : t("play.buzzed_late") %></p>
  </div>
  <% if round.accepting_answers? && (round.answering_team.nil? || round.answering_team == team) && answer.nil? %>
    <% if definition.has_choices? %>
      <%= render "play/choice_list", night: night, round: round, choices: definition.choices, definition: definition %>
    <% else %>
      <%= form_with url: night_round_run_answer_path(night.code, round), class: "answer-form" do %>
        <label for="body"><%= t("play.team_answer") %></label>
        <input id="body" name="body" maxlength="140" required class="code-input" placeholder="<%= t("play.answer_ph") %>" autocomplete="off" enterkeyhint="send" autocapitalize="sentences">
        <button class="btn btn-gold picto-btn" type="submit"><%= picto("send") %><%= t("play.send") %></button>
      <% end %>
    <% end %>
  <% elsif answer %>
    <% if definition.has_choices? %>
      <div class="play-sent" role="status">
        <p class="pick-chip"><%= answer_body_label(round, answer) %></p>
        <%= render "shared/wait", message: t("play.picked_wait") %>
      </div>
    <% else %>
      <%= render "shared/wait", message: t("play.sent_wait") %>
    <% end %>
  <% end %>
<% elsif round.open? %>
  <%= render "shared/wait", message: t("play.buzzer_open") %>
<% elsif round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% else %>
  <%= render "shared/wait", message: t("play.buzzer_closing") %>
<% end %>
