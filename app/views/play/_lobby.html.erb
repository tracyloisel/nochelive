<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(night) %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: night, title: night_title(night), team: team, player: player %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "mid", reel_class: "is-lobby" do %>
  <div class="wait-toy" role="status">
    <span class="emblem emblem-xl emblem-<%= team.emblem %> bob"><%= render "shared/emblem", key: team.emblem %></span>
    <span class="wait-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <p class="lede">Esperad. El presentador va a abrir la primera ronda.</p>
  </div>
  <p class="quiet">
    <%= night.teams.chapel.count %> equipos
    <% if night.teams.solos.any? %>
      · <%= night.teams.solos.count %> en casa
    <% end %>
  </p>
<% end %>
