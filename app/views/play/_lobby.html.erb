<% seat_label = player_remote?(player) ? t("play.casa_team") : team.name %>
<section class="play-card play-round play-reel is-lobby is-night-live is-dock"
         data-controller="story"
         data-story-exit-url-value="<%= root_path %>"
         data-story-index-value="0"
         data-story-live-index-value="0"
         data-action="pointerdown->story#start sheet:dismiss->story#exit">
  <p class="skip"><%= t("chrome.skip_play") %></p>
  <header class="night-quiz-head">
    <%= render "shared/story_close", action: "click->story#exit" %>
    <div class="street-quiz-lockup">
      <p class="street-quiz-lockup-name">Noche Live</p>
    </div>
  </header>
  <div class="play-shot">
    <%= render "shared/still", src: night_still_src(night) %>
    <div class="play-shot-seat" aria-hidden="true">
      <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
      <span class="word"><%= seat_label %></span>
    </div>
  </div>

  <div class="play-chrome">
    <div class="story-meta">
      <div class="story-cluster">
        <p class="story-night"><%= night_title(night) %></p>
        <button type="button"
                class="story-score btn"
                data-action="click->story#toggleScore"
                aria-controls="play_score"
                aria-expanded="false"
                data-story-target="scoreBtn"
                aria-label="<%= t("chrome.points", score: team.cached_score) %>">
          <%= picto("star") %>
          <span><%= team.cached_score %></span>
        </button>
      </div>
    </div>

    <div class="score-pop"
         id="play_score"
         hidden
         data-story-target="score"
         role="dialog"
         aria-label="<%= t("chrome.your_team") %>">
      <header class="team-bar">
        <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
        <div>
          <p class="eyebrow"><%= t("play.your_team") %></p>
          <h1><%= team.name %></h1>
        </div>
        <div class="who">
          <%= render "shared/avatar", player: player %>
          <p class="score" aria-label="<%= t("chrome.points_word") %>"><%= picto("star") %><%= team.cached_score %></p>
        </div>
        <%= render "play/progress", team: team %>
      </header>
      <% if team.streak.to_i >= 2 %>
        <p class="streak" role="status"><%= t("chrome.streak", count: team.streak) %></p>
      <% end %>
    </div>
  </div>

  <div class="play-sheet story-sheet"
       data-controller="sheet"
       data-story-target="sheet"
       data-sheet-snap="mid"
       data-sheet-snap-value="mid"
       data-sheet-peek-ratio-value="0.18"
       data-sheet-mid-ratio-value="0.42"
       data-sheet-open-label-value="<%= t("chrome.grip_open") %>"
       data-sheet-mid-label-value="<%= t("chrome.grip_mid") %>"
       data-sheet-peek-label-value="<%= t("chrome.grip_peek") %>"
       data-action="pointerdown->sheet#start">
    <span class="night-quiz-apex" aria-hidden="true"><%= picto("star4") %></span>
    <div class="play-sheet-body" data-sheet-target="body">
      <div class="lobby-wait" role="status">
        <p class="eyebrow"><%= t("play.lobby_kicker") %></p>
        <span class="emblem emblem-<%= team.emblem %> bob"><%= render "shared/emblem", key: team.emblem %></span>
        <h1 class="lobby-title"><%= t("play.lobby_title") %></h1>
        <p class="lobby-team-name"><%= seat_label %></p>
        <% teammates = team.players.select(&:participant?) %>
        <% if teammates.any? %>
          <div class="lobby-teammates" aria-label="<%= t("play.lobby_teammates") %>">
            <% teammates.first(6).each do |member| %>
              <span class="lobby-teammate">
                <%= render "shared/avatar", player: member %>
                <span><%= member.name %></span>
              </span>
            <% end %>
          </div>
        <% end %>
        <p class="prompt"><%= t("play.wait_open") %></p>
        <p class="lobby-presence">
          <%= picto("tick") %>
          <%= t("play.teams", count: night.teams.chapel.count) %>
          <% if night.teams.solos.any? %>
            · <%= t("play.remote_teams", count: night.teams.solos.count) %>
          <% end %>
        </p>
        <p class="lobby-resume"><%= picto("sparkle") %><span><%= t("play.lobby_resume") %></span></p>
      </div>
    </div>
  </div>
</section>
