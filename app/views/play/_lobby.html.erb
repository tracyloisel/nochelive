<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(night) %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: night, title: night_title(night), team: team, player: player, ticks: false, live: false, close: true %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "mid", handle: false, reel_class: "is-lobby" do %>
  <div class="wait-toy" role="status">
    <span class="emblem emblem-xl emblem-<%= team.emblem %> bob"><%= render "shared/emblem", key: team.emblem %></span>
    <span class="wait-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <p class="lede"><%= t("play.wait_open") %></p>
  </div>
  <p class="quiet">
    <%= t("play.teams", count: night.teams.chapel.count) %>
    <% if night.teams.solos.any? %>
      · <%= t("play.remote_teams", count: night.teams.solos.count) %>
    <% end %>
  </p>
<% end %>
