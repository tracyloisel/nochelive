<div class="crown-desk">
  <p class="stand-up">¡TODOS DE PIE!</p>
  <% if line = night_leader_line(night) %>
    <p class="lede"><%= line %></p>
  <% end %>

  <% if round.revealed? %>
    <%= render "play/reveal", definition: definition, team: team, round: round %>
  <% elsif round.open? && buzz.nil? %>
    <p class="prompt"><%= definition.question %></p>
    <%= button_to night_round_run_buzz_path(night.code, round), class: "buzz hunt-btn", data: { controller: "buzzer", action: "buzzer#lock" } do %>
      <%= picto("trophy", size: "xl") %>
      <span>¡LA CORONA!</span>
    <% end %>
    <p class="hint">La última palabra. El primero cierra.</p>
  <% elsif buzz %>
    <div class="lock <%= 'lock-gold' if buzz.first? %>" role="status" <%= %(data-stage-sfx-value="buzzer_hit" data-stage-fx-value="gold").html_safe if buzz.first? %>>
      <% if buzz.first? %>
        <div class="mini-crown" aria-hidden="true"><%= render "illustrations/crown" %></div>
      <% end %>
      <p class="place"><%= buzz.medal %></p>
      <p class="delay"><%= latency_label(buzz.latency_ms) %></p>
      <p><%= buzz.first? ? "¡Gritadlo! La noche os escucha." : "Otros llegaron antes. Escuchad." %></p>
    </div>
    <% if round.accepting_answers? && (round.answering_team.nil? || round.answering_team == team) && answer.nil? %>
      <%= form_with url: night_round_run_answer_path(night.code, round), class: "answer-form" do %>
        <label for="body">O escribidlo</label>
        <input id="body" name="body" maxlength="140" required class="code-input" placeholder="Eliseo…">
        <button class="btn btn-gold picto-btn" type="submit"><%= picto("send") %>Enviar</button>
      <% end %>
    <% elsif answer %>
      <p class="sent" role="status">La palabra está dicha. Esperad la corona.</p>
    <% end %>
  <% elsif round.open? %>
    <p class="wait">La corona está abierta…</p>
  <% else %>
    <p class="lede"><%= definition.instructions %></p>
    <p class="wait">La última palabra llega.</p>
  <% end %>
</div>
