<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif answer %>
  <p class="prompt"><%= definition.copy(:question) %></p>
  <p class="sent" role="status"><%= t("play.order_sent", order: definition.order_labels(answer.body).join(" → ")) %></p>
<% else %>
  <p class="prompt"><%= definition.copy(:question) %></p>
  <p class="lede"><%= definition.copy(:instructions) %></p>
  <% items = definition.shuffled_items(round.id) %>
  <% if round.open? %>
    <div class="order-desk"
         data-controller="order"
         data-order-url-value="<%= night_round_run_answer_path(night.code, round) %>"
         data-order-needed-value="<%= items.size %>">
      <ol class="order-trail cluster" data-order-target="trail" aria-live="polite"></ol>
      <div class="choices">
        <% items.each_with_index do |item, index| %>
          <% mark = choice_mark(index) %>
          <button type="button"
                  class="choice-btn choice-<%= mark[:tone] %>"
                  data-order-target="pick"
                  data-order-key-param="<%= item['key'] %>"
                  data-order-label-param="<%= item['label'] %>"
                  data-action="order#pick">
            <span class="choice-mark" aria-hidden="true"><%= picto(mark[:shape]) %></span>
            <span class="word"><%= item["label"] %></span>
          </button>
        <% end %>
      </div>
      <button type="button" class="btn btn-ghost picto-btn" data-action="order#undo"><%= picto("undo") %><%= t("play.undo") %></button>
    </div>
  <% else %>
    <ul class="cluster order-preview">
      <% items.each_with_index do |item, index| %>
        <% mark = choice_mark(index) %>
        <li class="choice-token choice-<%= mark[:tone] %>">
          <span class="choice-mark" aria-hidden="true"><%= picto(mark[:shape]) %></span>
          <span class="word"><%= item["label"] %></span>
        </li>
      <% end %>
    </ul>
    <%= render "shared/wait", message: t("play.read_names") %>
  <% end %>
<% end %>
