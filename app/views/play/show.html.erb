<% content_for :title, @street.pack.copy(:title) %>
<% content_for :body_class, "is-kid is-street-play is-night-live" %>
<% surface_stylesheet("duel_campus") %>
<% declare_frontend_resources(
     context: @street.asking? ? "live.quiz.ask" : "live.quiz.result",
     styles: %w[shell gameplay street_play live_play],
     controllers: %w[loading press quiz countdown] + (@street.done? ? %w[street-motion] : []),
     media: { lcp: street_still_src(@street.question), next: street_next_still(@street) },
     audio: { unlock: true, cues: %w[celestial_breath round_start correct_gold fire_whoosh street_wrong_soft street_royal_fanfare chest], bed: (@street.done? ? nil : "timer_tension") },
     motion: @street.done? ? %w[ceremony-enter] : []
   ) %>
<%= turbo_stream_from @night.locale_stream(current_locale) %>
<% menu_chrome = @street.done? ? Quizzes::Chrome.ceremony(outcomes: []) : Quizzes::Chrome.call(question: @street.question) %>
<% page_hud(theme: "celestial-#{menu_chrome.mode}") { site_menu } %>
<%= render "home/street", street: @street, standings: nil, play_context: :live, duel_campus: nil, chrome: menu_chrome, night: @night, player: @player %>
