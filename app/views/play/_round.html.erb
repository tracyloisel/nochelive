<% definition = round.definition %>
<% buzz = team.buzzes.find_by(round_run: round) %>
<% answer = team.answers.find_by(round_run: round) %>
<% tap = team.tap_runs.find_by(round_run: round) %>
<% hold = team.pose_holds.find_by(round_run: round) %>
<% live_index = night.round_runs.find_index { |tick| tick.id == round.id }.to_i %>

<% quiz_phone = phone_quiz?(round, player) %>
<section class="play-card play-round play-reel <%= "peak" if definition.finale? %> <%= "is-quiz" if quiz_phone %>"
         data-controller="story"
         data-story-exit-url-value="<%= root_path %>"
         data-story-index-value="<%= live_index %>"
         data-story-live-index-value="<%= live_index %>"
         data-action="pointerdown->story#start sheet:dismiss->story#exit">
  <p class="skip"><%= t("chrome.skip_play") %></p>
  <div class="play-shot">
    <%= render "shared/story_pages", night: night, current: round, reveal_future: false, pulse: local_assigns[:pulse] %>
  </div>

  <div class="play-chrome">
    <%= render "shared/story_ticks", night: night, current: round %>
    <%= render "play/timer", round: round %>
    <div class="story-meta">
      <%= render "shared/story_close", action: "click->story#exit" %>
      <div class="story-cluster">
        <p class="story-night"><%= night_title(night) %></p>
        <button type="button"
                class="story-score btn"
                data-action="click->story#toggleScore"
                aria-controls="play_score"
                aria-expanded="false"
                data-story-target="scoreBtn"
                aria-label="<%= t("chrome.points", score: team.cached_score) %>">
          <%= picto("star") %>
          <span><%= team.cached_score %></span>
        </button>
      </div>
    </div>
    <%= render "shared/presence", night: night, team: team, compact: true, variant: "stage" %>

    <div class="score-pop"
         id="play_score"
         hidden
         data-story-target="score"
         role="dialog"
         aria-label="<%= t("chrome.your_team") %>">
      <header class="team-bar">
        <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
        <div>
          <p class="eyebrow"><%= t("play.round_band", n: round.position, band: band_label(round.position)) %></p>
          <h1><%= team.name %></h1>
        </div>
        <div class="who">
          <%= render "shared/avatar", player: player %>
          <p class="score" aria-label="<%= t("chrome.points_word") %>"><%= picto("star") %><%= team.cached_score %></p>
        </div>
        <%= render "play/progress", team: team %>
      </header>
      <% if team.streak >= 2 %>
        <p class="streak" role="status"><%= t("chrome.streak", count: team.streak) %></p>
      <% end %>
    </div>
  </div>

  <div class="play-sheet story-sheet"
       data-controller="sheet"
       data-story-target="sheet"
       data-sheet-snap="<%= quiz_phone ? "open" : (round.revealed? || answer.present? ? "open" : "mid") %>"
       data-sheet-snap-value="<%= quiz_phone ? "open" : (round.revealed? || answer.present? ? "open" : "mid") %>"
       data-sheet-peek-ratio-value="0.18"
       data-sheet-mid-ratio-value="<%= quiz_phone ? 0.52 : 0.40 %>"
       data-sheet-open-label-value="<%= t("chrome.grip_open") %>"
       data-sheet-mid-label-value="<%= t("chrome.grip_mid") %>"
       data-sheet-peek-label-value="<%= t("chrome.grip_peek") %>"
       data-action="pointerdown->sheet#start">
    <button type="button"
            class="play-sheet-grip"
            data-sheet-target="handle"
            data-action="click->sheet#cycle"
            aria-label="<%= t("chrome.grip") %>"
            aria-valuetext="<%= t("chrome.grip_mid") %>">
      <span class="play-sheet-pip" aria-hidden="true"></span>
    </button>

    <div class="play-sheet-body" data-sheet-target="body">
      <div class="play-stage">
        <p class="round-title">
          <%= render "shared/round_icon", key: definition.icon %>
          <span><%= definition.copy(:title) %></span>
        </p>

        <% if definition.taboo? %>
          <%= render "play/taboo", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.ordering? %>
          <%= render "play/order", night: night, team: team, round: round, definition: definition, answer: answer %>
        <% elsif definition.scavenger? %>
          <%= render "play/scavenger", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.category? %>
          <%= render "play/category", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.vote? %>
          <%= render "play/vote", night: night, team: team, player: player, round: round, definition: definition %>
        <% elsif definition.freeze? %>
          <%= render "play/freeze", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.finale? %>
          <%= render "play/burger", night: night, team: team, player: player, round: round, definition: definition, buzz: buzz, answer: answer %>
        <% elsif round.intro? %>
          <p class="band"><%= band_label(round.position) %></p>
          <p class="prompt"><%= round_prompt(round) %></p>
          <%= render "shared/wait", message: t("play.wait_intro") %>
        <% elsif definition.pose? %>
          <%= render "play/pose", night: night, team: team, player: player, round: round, definition: definition, hold: hold %>
        <% elsif definition.mime? %>
          <%= render "play/mime", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.physical? && !player_remote?(player) %>
          <%= render "play/physical", night: night, team: team, round: round, definition: definition %>
        <% elsif definition.rapid_tap? || (definition.physical? && definition.remote_variant) %>
          <%= render "play/rapid_tap", night: night, team: team, round: round, definition: definition, tap: tap %>
        <% elsif quiz_phone %>
          <%= render "play/choice", night: night, team: team, player: player, round: round, definition: definition, answer: answer %>
        <% elsif definition.buzzer? %>
          <%= render "play/buzzer", night: night, team: team, round: round, definition: definition, buzz: buzz, answer: answer %>
        <% else %>
          <%= render "play/hosted", night: night, team: team, player: player, round: round, definition: definition %>
        <% end %>
      </div>

      <% if grant = team.ready_chest %>
        <%= render "play/chest", night: night, grant: grant, compact: !round.revealed? %>
      <% elsif opened = team.opened_rewards.order(updated_at: :desc).first %>
        <div class="loot" role="status">
          <p class="eyebrow"><%= t("play.reward") %></p>
          <h2><%= opened.reward_title %></h2>
          <p><%= opened.reward_detail %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
