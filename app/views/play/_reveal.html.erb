<div class="reveal is-arriving" role="status">
  <div class="put-down-art" aria-hidden="true"><%= picto("check", size: "lg") %></div>
  <p class="eyebrow">Respuesta</p>
  <p class="answer-line"><%= definition.answer %></p>
  <% if definition.reference %>
    <p class="ref"><%= definition.reference %></p>
  <% end %>
  <% event = team.score_events.find_by(round_run: round, kind: "correct") %>
  <% if event %>
    <p class="score-fly"><%= picto("sparkle") %>+<%= event.points %></p>
  <% end %>
</div>
