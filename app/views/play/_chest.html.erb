<div class="chest <%= "is-compact" if local_assigns[:compact] %>" data-controller="chest">
  <p class="eyebrow"><%= t("play.chest_ready") %></p>
  <% unless local_assigns[:compact] %>
    <div class="art"><%= picto("chest", size: "xl") %></div>
  <% end %>
  <h2><%= grant.chest_title %></h2>
  <% unless local_assigns[:compact] %>
    <p><%= t("play.chest_hint") %></p>
  <% end %>
  <%= button_to night_chest_path(night.code, grant), class: "btn btn-gold", data: { action: "chest#open" } do %>
    <%= picto("chest") %><%= t("play.open_chest") %>
  <% end %>
</div>
