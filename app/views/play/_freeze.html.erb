<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif player_remote?(player) %>
  <% if answer %>
    <div class="lock lock-gold" role="status">
      <%= picto("dancer", size: "lg") %>
      <p class="place"><%= answer.body.to_i <= definition.freeze_window ? t("play.planted") : t("play.late") %></p>
      <p><%= answer.body.to_i <= definition.freeze_window ? t("play.doll_still") : t("play.doll_moved") %></p>
    </div>
  <% elsif round.locked? %>
    <div class="freeze-desk">
      <p class="prompt put-down"><%= t("play.frozen") %></p>
      <%= render "shared/dancer", frozen: true %>
      <%= form_with url: night_round_run_freeze_path(night.code, round), class: "hunt-form" do %>
        <button class="buzz hunt-btn" type="submit">
          <%= picto("statue", size: "xl") %>
          <span><%= t("play.i_froze") %></span>
        </button>
      <% end %>
    </div>
  <% elsif round.open? %>
    <div class="freeze-desk">
      <p class="prompt put-down"><%= t("play.dance") %></p>
      <p class="lede"><%= definition.remote_variant ? (definition.remote_instructions.presence || definition.copy(:instructions)) : definition.copy(:instructions) %></p>
      <%= render "shared/dancer", frozen: false %>
      <%= render "shared/wait", message: t("play.wait_tap") %>
    </div>
  <% else %>
    <p class="lede"><%= definition.copy(:instructions) %></p>
    <%= render "shared/wait", message: t("play.doll_dances") %>
  <% end %>
<% else %>
  <% if round.locked? %>
    <div class="lock lock-gold" role="status">
      <p class="place"><%= t("play.frozen") %></p>
      <%= render "shared/dancer", frozen: true %>
      <p><%= t("play.dont_move") %></p>
    </div>
  <% elsif round.open? %>
    <div class="freeze-desk">
      <p class="prompt put-down"><%= t("play.dance") %></p>
      <p class="lede"><%= definition.copy(:instructions) %></p>
      <%= render "shared/dancer", frozen: false %>
      <p class="hint"><%= t("play.phone_down") %></p>
    </div>
  <% else %>
    <p class="lede"><%= definition.copy(:instructions) %></p>
    <%= render "shared/wait", message: t("play.go_dance") %>
  <% end %>
<% end %>
