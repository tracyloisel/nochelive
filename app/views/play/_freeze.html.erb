<% if round.revealed? %>
  <%= render "play/reveal", definition: definition, team: team, round: round %>
<% elsif player_remote?(player) %>
  <% if answer %>
    <div class="lock lock-gold" role="status">
      <%= picto("dancer", size: "lg") %>
      <p class="place"><%= answer.body.to_i <= definition.freeze_window ? "¡Plantado!" : "Tarde" %></p>
      <p><%= answer.body.to_i <= definition.freeze_window ? "El muñeco se quedó." : "El muñeco se movió." %></p>
    </div>
  <% elsif round.locked? %>
    <div class="freeze-desk">
      <p class="prompt put-down">¡CONGELADOS!</p>
      <%= render "shared/dancer", frozen: true %>
      <%= form_with url: night_round_run_freeze_path(night.code, round), class: "hunt-form" do %>
        <button class="buzz hunt-btn" type="submit">
          <%= picto("statue", size: "xl") %>
          <span>¡ME QUEDÉ!</span>
        </button>
      <% end %>
    </div>
  <% elsif round.open? %>
    <div class="freeze-desk">
      <p class="prompt put-down">¡BAILAD!</p>
      <p class="lede"><%= definition.remote_variant&.fetch("instructions", definition.instructions) %></p>
      <%= render "shared/dancer", frozen: false %>
      <%= render "shared/wait", message: "Espera. No pulses todavía." %>
    </div>
  <% else %>
    <p class="lede"><%= definition.instructions %></p>
    <%= render "shared/wait", message: "El muñeco va a bailar." %>
  <% end %>
<% else %>
  <% if round.locked? %>
    <div class="lock lock-gold" role="status">
      <p class="place">¡CONGELADOS!</p>
      <%= render "shared/dancer", frozen: true %>
      <p>No os mováis. El presentador mira.</p>
    </div>
  <% elsif round.open? %>
    <div class="freeze-desk">
      <p class="prompt put-down">¡BAILAD!</p>
      <p class="lede"><%= definition.instructions %></p>
      <%= render "shared/dancer", frozen: false %>
      <p class="hint">Dejad el teléfono en la mesa.</p>
    </div>
  <% else %>
    <p class="lede"><%= definition.instructions %></p>
    <%= render "shared/wait", message: "Id a bailar. El presentador va a abrir." %>
  <% end %>
<% end %>
