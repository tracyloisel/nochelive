<% remote = player_remote?(player) %>
<% layer = round.current_layer %>
<div class="burger-desk">
  <%= render "shared/burger_stack", round: round %>

  <% if round.intro? && round.layer_index.to_i.zero? %>
    <p class="stand-up"><%= remote ? "La capilla se pone de pie. Vosotros también." : "¡TODOS DE PIE!" %></p>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>
    <% unless remote %>
      <%= render "shared/wait", message: "Escuchad." %>
    <% end %>

  <% elsif round.intro? && !round.last_layer? %>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="prompt is-arriving"><%= layer && layer["text"] %></p>
    <% if remote %>
      <%= render "play/cheer_dock", night: night, round: round, player: player %>
    <% else %>
      <p class="hint">Escuchad el burger.</p>
      <% if (line = cheer_to_you_line(layer_cheers(round).select { |cheer| cheer.to_player_id == player.id }.map { |cheer| cheer.player.name })) %>
        <p class="cheer-fire" role="status"><%= picto("sparkle") %><span><%= line %></span></p>
      <% end %>
    <% end %>

  <% elsif round.intro? && round.last_layer? %>
    <p class="stand-up">¡TODOS DE PIE!</p>
    <p class="prompt is-arriving">La salsa.</p>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>

  <% elsif round.revealed? %>
    <%= render "play/reveal", definition: definition, team: team, round: round %>

  <% elsif remote %>
    <p class="prompt"><%= definition.question %></p>
    <% if round.chapel_correct? %>
      <p class="lede" role="status">La sala acertó.</p>
      <%= render "play/choice_tokens", choices: definition.choices %>
    <% elsif round.finale_steal_open? %>
      <p class="shout is-arriving">¡Ahora vosotros!</p>
      <% if answer %>
        <div class="play-sent" role="status">
          <p class="pick-chip"><%= answer_body_label(round, answer) %></p>
          <p class="sent">La palabra está dicha. Esperad la corona.</p>
        </div>
      <% else %>
        <%= render "play/choice_list", night: night, round: round, choices: definition.choices %>
      <% end %>
    <% elsif round.answering_team %>
      <p class="lede"><%= round.answering_team.name %> responde.</p>
      <%= render "play/choice_tokens", choices: definition.choices %>
    <% else %>
      <p class="lede">Esperad el slam.</p>
      <%= render "play/choice_tokens", choices: definition.choices %>
    <% end %>

  <% elsif round.open? && buzz.nil? %>
    <p class="prompt"><%= definition.question %></p>
    <%= button_to night_round_run_buzz_path(night.code, round), class: "buzz hunt-btn", data: { controller: "buzzer", action: "buzzer#lock" } do %>
      <%= picto("trophy", size: "xl") %>
      <span>¡LA CORONA!</span>
    <% end %>
    <p class="hint">La última palabra. El primero cierra.</p>

  <% elsif buzz %>
    <div class="lock <%= 'lock-gold' if buzz.first? %>" role="status" <%= %(data-stage-sfx-value="buzzer_hit" data-stage-fx-value="gold").html_safe if buzz.first? %>>
      <% if buzz.first? %>
        <div class="mini-crown" aria-hidden="true"><%= picto("trophy", size: "lg") %></div>
      <% end %>
      <p class="place"><%= buzz.medal %></p>
      <p class="delay"><%= latency_label(buzz.latency_ms) %></p>
      <p><%= buzz.first? ? "¡Gritadlo! La noche os escucha." : "Otros llegaron antes. Escuchad." %></p>
    </div>
    <% if round.accepting_answers?(player: player) && (round.answering_team.nil? || round.answering_team == team) && answer.nil? %>
      <%= render "play/choice_list", night: night, round: round, choices: definition.choices %>
    <% elsif answer %>
      <div class="play-sent" role="status">
        <p class="pick-chip"><%= answer_body_label(round, answer) %></p>
        <p class="sent">La palabra está dicha. Esperad la corona.</p>
      </div>
    <% end %>

  <% elsif round.open? %>
    <p class="wait">La corona está abierta…</p>
  <% else %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>
  <% end %>
</div>
