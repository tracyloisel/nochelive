<% remote = player_remote?(player) %>
<% layer = round.current_layer %>
<div class="burger-desk">
  <%= render "shared/burger_stack", round: round %>

  <% if round.intro? && round.layer_index.to_i.zero? %>
    <p class="stand-up"><%= remote ? t("play.stand_remote") : t("play.stand_all") %></p>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>
    <% unless remote %>
      <%= render "shared/wait", message: t("play.listen") %>
    <% end %>

  <% elsif round.intro? && !round.last_layer? %>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="prompt is-arriving"><%= layer && definition.layer_copy(layer, "text") %></p>
    <% if remote %>
      <%= render "play/cheer_dock", night: night, round: round, player: player %>
    <% else %>
      <p class="hint"><%= t("play.listen_burger") %></p>
      <% if (line = cheer_to_you_line(layer_cheers(round).select { |cheer| cheer.to_player_id == player.id }.map { |cheer| cheer.player.name })) %>
        <p class="cheer-fire" role="status"><%= picto("sparkle") %><span><%= line %></span></p>
      <% end %>
    <% end %>

  <% elsif round.intro? && round.last_layer? %>
    <p class="stand-up"><%= t("play.stand_all") %></p>
    <p class="prompt is-arriving"><%= layer ? definition.layer_copy(layer, "text") : t("play.salsa") %></p>
    <% if line = night_leader_line(night) %>
      <p class="lede"><%= line %></p>
    <% end %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>

  <% elsif round.revealed? %>
    <%= render "play/reveal", definition: definition, team: team, round: round %>

  <% elsif remote %>
    <p class="prompt"><%= definition.copy(:question) %></p>
    <% if round.chapel_correct? %>
      <p class="lede" role="status"><%= t("play.chapel_right") %></p>
      <%= render "play/choice_tokens", choices: definition.choices, definition: definition %>
    <% elsif round.finale_steal_open? %>
      <p class="shout is-arriving"><%= t("play.now_you") %></p>
      <% if answer %>
        <div class="play-sent" role="status">
          <p class="pick-chip"><%= answer_body_label(round, answer) %></p>
          <p class="sent"><%= t("play.word_said") %></p>
        </div>
      <% else %>
        <%= render "play/choice_list", night: night, round: round, choices: definition.choices, definition: definition %>
      <% end %>
    <% elsif round.answering_team %>
      <p class="lede"><%= t("play.team_answers", name: round.answering_team.name) %></p>
      <%= render "play/choice_tokens", choices: definition.choices, definition: definition %>
    <% else %>
      <p class="lede"><%= t("play.wait_slam") %></p>
      <%= render "play/choice_tokens", choices: definition.choices, definition: definition %>
    <% end %>

  <% elsif round.open? && buzz.nil? %>
    <p class="prompt"><%= definition.copy(:question) %></p>
    <%= button_to night_round_run_buzz_path(night.code, round), class: "buzz hunt-btn", data: { controller: "buzzer", action: "buzzer#lock" } do %>
      <%= picto("trophy", size: "xl") %>
      <span><%= t("play.the_crown") %></span>
    <% end %>
    <p class="hint"><%= t("play.last_word") %></p>

  <% elsif buzz %>
    <div class="lock <%= 'lock-gold' if buzz.first? %>" role="status">
      <% if buzz.first? %>
        <div class="mini-crown" aria-hidden="true"><%= picto("trophy", size: "lg") %></div>
      <% end %>
      <p class="place"><%= buzz.medal %></p>
      <p class="delay"><%= latency_label(buzz.latency_ms) %></p>
      <p><%= buzz.first? ? t("play.shout_it") : t("play.others_first") %></p>
    </div>
    <% if round.accepting_answers?(player: player) && (round.answering_team.nil? || round.answering_team == team) && answer.nil? %>
      <%= render "play/choice_list", night: night, round: round, choices: definition.choices, definition: definition %>
    <% elsif answer %>
      <div class="play-sent" role="status">
        <p class="pick-chip"><%= answer_body_label(round, answer) %></p>
        <p class="sent"><%= t("play.word_said") %></p>
      </div>
    <% end %>

  <% elsif round.open? %>
    <p class="wait"><%= t("play.crown_open") %></p>
  <% else %>
    <p class="lede"><%= burger_stakes_line(night, team) %></p>
  <% end %>
</div>
