<% definition = round.definition %>
<% nxt = night.round_runs.find_by(position: round.position + 1) %>
<% right = answer && answer.body.to_s == definition.correct_choice.to_s %>
<div id="quiz_board"
     class="quiz-board <%= "is-settled" if answer %>"
     data-controller="quiz"
     data-quiz-play-url-value="<%= night_play_path(night.code) %>"
     data-quiz-correct-value="<%= definition.correct_choice %>"
     data-quiz-next-image-value="<%= challenge_story(nxt) if nxt %>"
     data-action="click->quiz#pick turbo:submit-start->quiz#lock">
  <% if answer %>
    <%= render "play/quiz_result", night: night, round: round, team: team, definition: definition, answer: answer, right: right %>
  <% elsif round.revealed? %>
    <%= render "play/reveal", definition: definition, team: team, round: round %>
  <% elsif phone_quiz_asking?(round, local_assigns[:player]) %>
    <%= render "play/choice_list", night: night, round: round, choices: definition.choices, definition: definition %>
  <% else %>
    <%= render "shared/wait", message: t("play.wait_answer") %>
  <% end %>
</div>
