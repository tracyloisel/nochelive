<% content_for :title, t("study.title") %>
<% content_for :body_class, "is-study-program is-celestial-dark" %>
<main id="study_program" class="study-world" data-controller="study-timeline" style="--study-art:url('<%= media_src("media/study/psalms-refuge-2026.png") %>')">
  <% page_hud(hud: true) { site_menu } %>
  <%= render "study_programs/lockup" %>
  <nav class="study-path-nav" aria-label="<%= t("study.title") %>">
    <%= link_to study_history_path do %><%= picto("stats-path") %><span><%= t("study.my_journey") %></span><% end %>
    <% if current_street_person&.ward %>
      <%= link_to study_community_path(ward_code: current_street_person.ward.code) do %><%= picto("people") %><span><%= t("study.ward") %></span><% end %>
    <% end %>
    <% if current_street_person&.ward&.scripture_circle_readable? %>
      <%= link_to scripture_circle_path do %><%= picto("conversation") %><span><%= t("scripture_circle.hub_link") %></span><% end %>
    <% end %>
  </nav>
  <% if current_street_person.nil? %>
    <%= link_to street_profile_path(fresh: 1), class: "study-profile-invite" do %>
      <span class="study-profile-invite-mark"><%= picto("person") %></span>
      <span><strong><%= t("study.profile_invite_title") %></strong><small><%= t("study.profile_invite_lede") %></small></span>
      <b><%= t("study.profile_invite_cta") %></b><i aria-hidden="true">›</i>
    <% end %>
  <% end %>
  <%= render "shared/quiz_reading_suggestions", suggestions: @quiz_reading_suggestions, surface: :study %>
  <% if @week %>
    <section class="study-current">
      <p class="study-kicker"><%= t("study.current_week") %></p>
      <h2><%= t("study.psalms_theme") %></h2>
      <p><%= @week.display_scripture_refs.first %></p>
      <% if @run %>
        <%= link_to t("study.continue"), study_run_path(@run), class: "btn btn-gold" %>
      <% elsif @week.published_quiz %>
        <%= link_to t("study.begin"), study_unit_path(@week), class: "btn btn-gold" %>
      <% else %>
        <span class="study-awaiting"><%= t("study.awaiting_quiz") %></span>
      <% end %>
    </section>
  <% end %>
  <section class="study-year" id="mi-recorrido">
    <header><div><p class="study-kicker"><%= t("study.annual_program") %></p><h2><%= @program.display_title %></h2></div><strong><%= @weeks.size %></strong></header>
    <div class="study-week-list" role="region" tabindex="0" aria-label="<%= t("study.timeline_label") %>" data-study-timeline-target="container">
      <% @weeks.each do |week| %>
        <% completed = @completed_unit_ids.include?(week.id) %>
        <%= link_to study_unit_path(week), class: "study-week-row#{" is-current" if week == @week}#{" is-complete" if completed}", data: ({ study_timeline_target: "current" } if week == @week) do %>
          <time><%= l(week.starts_on, format: "%d/%m") %></time>
          <span><strong><%= week.display_heading %></strong><small><%= week.starts_on == @week&.starts_on ? t("study.this_week") : week.display_period %></small></span>
          <b><%= completed ? "✓" : (week.published_quiz ? "✦" : "›") %></b>
        <% end %>
      <% end %>
    </div>
  </section>
  <section class="study-appendices">
    <header><p class="study-kicker"><%= t("study.permanent_resources") %></p><h2><%= t("study.appendices") %></h2></header>
    <% @appendices.each do |appendix| %>
      <% appendix_code = appendix.display_title[/\b([A-D])\b/, 1] %>
      <%= link_to appendix.source_url, class: "study-appendix-row", target: "_blank", rel: "noopener" do %>
        <b><%= appendix_code %></b><span><%= appendix.display_heading %></span><i>↗</i>
      <% end %>
    <% end %>
  </section>
<% page_dock(active: :word) %>
</main>
