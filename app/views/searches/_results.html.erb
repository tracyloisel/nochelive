<% extras = { pick: params[:pick].presence || @picker_pick, cambiar: ("1" if @changing_ward || params[:cambiar].present?) }.compact %>

<div class="ward-picker-results">
  <% listed = Array(@wards) %>
  <% if @query.to_s.strip.length >= 2 && listed.blank? %>
    <section class="ward-picker-missing" aria-labelledby="ward-picker-missing-title">
      <span class="ward-picker-missing-mark" aria-hidden="true"><%= picto("pin") %></span>
      <h2 id="ward-picker-missing-title"><%= t("street.gate_missing_title") %></h2>
      <p><%= t("home.empty") %></p>
      <p class="ward-picker-missing-location"><%= t("street.gate_missing_location") %></p>
      <div class="ward-picker-missing-actions">
        <%= link_to t("street.gate_official_locator"), "https://maps.churchofjesuschrist.org/",
              class: "btn btn-navy", target: "_blank", rel: "noreferrer" %>
        <%= link_to t("street.gate_continue_without_ward"), root_path,
              class: "quiet-link", data: { turbo_frame: "_top" } %>
      </div>
    </section>
  <% elsif @search&.nearby? && listed.any? %>
    <p class="ward-picker-stake"><%= t("street.gate_nearby") %></p>
    <ul class="ward-picker-list">
      <li>
        <%= render "searches/ward_row", ward: listed.first, pick_url: @pick_url || enter_ward_path %>
      </li>
    </ul>
  <% else %>
    <% listed.group_by { |ward| ward.stake_name.presence || t("street.gate_no_stake") }.each do |stake, rows| %>
      <% if listed.size > 1 || stake != t("street.gate_no_stake") %>
        <p class="ward-picker-stake"><%= stake %></p>
      <% end %>
      <ul class="ward-picker-list">
        <% rows.each do |ward| %>
          <li>
            <%= render "searches/ward_row", ward: ward, pick_url: @pick_url || enter_ward_path %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
