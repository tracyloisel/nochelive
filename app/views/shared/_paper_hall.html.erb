<section id="<%= hall_id %>" class="home-paper hall-paper<%= " #{extra_class}" if extra_class.present? %>">
  <header class="home-brand">
    <div class="street-hub-lockup">
      <div class="street-hub-lockup-wordmark">
        <span class="street-hub-lockup-star" aria-hidden="true"><%= picto("star8") %></span>
        <p class="street-hub-lockup-name">Noche Live</p>
      </div>
      <p class="street-temple-pill street-temple-hub-title">
        <span class="street-hub-rule" aria-hidden="true"></span>
        <span class="street-hub-kicker"><%= kicker %></span>
        <span class="street-hub-rule" aria-hidden="true"></span>
      </p>
    </div>
  </header>

  <% if sheet %>
    <article class="hall-sheet<%= " #{sheet_class}" if sheet_class.present? %>">
      <span class="hall-sheet-apex street-quien-apex" aria-hidden="true"><%= picto("star4") %></span>
      <%= body %>
    </article>
  <% else %>
    <%= body %>
  <% end %>
</section>
