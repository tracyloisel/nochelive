<% compact = local_assigns.fetch(:compact, false) %>
<% assign_locale = local_assigns.fetch(:assign_locale, false) %>
<div class="roster-board <%= "is-compact" if compact %>">
  <% Array(night.teams).sort_by { |team| team.name.to_s }.each do |team| %>
    <section class="roster-team">
      <header class="roster-team-head">
        <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
        <h3><%= team.name %></h3>
      </header>
      <ul class="roster-people">
        <% Array(team.players).select(&:participant?).each do |player| %>
          <li class="roster-person">
            <% src = avatar_mark(player) %>
            <% if src %>
              <img src="<%= src %>" alt="" class="avatar-img" width="48" height="48">
            <% else %>
              <span class="avatar-fallback" aria-hidden="true"><%= player.name.to_s.first %></span>
            <% end %>
            <span><%= player_label(player) %></span>
            <% if assign_locale %>
              <%= render "shared/lang_assign", url: presenter_player_locale_path(night.code, player), current: player.locale, name: player.name %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% extras = Array(night.players).select { |player| player.participant? && player.team.nil? } %>
  <% if extras.any? %>
    <section class="roster-team">
      <h3><%= t("presenter.no_team") %></h3>
      <ul class="roster-people">
        <% extras.each do |player| %>
          <li class="roster-person">
            <% src = avatar_mark(player) %>
            <% if src %>
              <img src="<%= src %>" alt="" class="avatar-img" width="48" height="48">
            <% else %>
              <span class="avatar-fallback" aria-hidden="true"><%= player.name.to_s.first %></span>
            <% end %>
            <span><%= player_label(player) %></span>
            <% if assign_locale %>
              <%= render "shared/lang_assign", url: presenter_player_locale_path(night.code, player), current: player.locale, name: player.name %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% spectators = Array(night.players).select(&:spectator?) %>
  <% if assign_locale && spectators.any? %>
    <section class="roster-team">
      <header class="roster-team-head">
        <h3><%= t("presenter.spectators") %></h3>
      </header>
      <ul class="roster-people">
        <% spectators.each do |player| %>
          <li class="roster-person">
            <% src = avatar_mark(player) %>
            <% if src %>
              <img src="<%= src %>" alt="" class="avatar-img" width="48" height="48">
            <% else %>
              <span class="avatar-fallback" aria-hidden="true"><%= player.name.to_s.first %></span>
            <% end %>
            <span><%= player_label(player) %></span>
            <%= render "shared/lang_assign", url: presenter_player_locale_path(night.code, player), current: player.locale, name: player.name %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if Array(night.missionaries).any? %>
    <section class="roster-missionaries">
      <p class="eyebrow"><%= t("presenter.missionaries") %></p>
      <p class="lede"><%= missionary_line(night) %></p>
      <p class="quiet"><%= t("presenter.no_play") %></p>
    </section>
  <% end %>
</div>
