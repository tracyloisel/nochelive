<% person = current_street_person %>
<% ward = current_ward %>
<% in_run = controller_name.in?(%w[street_plays street_challenges]) %>
<nav class="home-menu-nav" aria-label="<%= t("chrome.menu") %>">
  <% if person %>
    <%= link_to street_profile_path,
          class: [ "home-menu-me", ("is-current" if current_page?(street_profile_path)) ],
          aria: { current: ("page" if current_page?(street_profile_path)) } do %>
      <span class="home-menu-face">
        <% src = avatar_mark(person) %>
        <% if src %>
          <img src="<%= src %>" alt="" class="avatar-img" width="40" height="40">
        <% else %>
          <span class="avatar-fallback" aria-hidden="true"><%= person.given_name.to_s.first %></span>
        <% end %>
      </span>
      <span class="home-menu-me-copy">
        <strong><%= person.given_name %></strong>
        <% if ward %>
          <small><%= ward.name %></small>
        <% end %>
      </span>
    <% end %>
  <% else %>
    <%= link_to root_path(ficha: 1), class: "home-menu-me is-guest" do %>
      <span class="home-menu-ico" aria-hidden="true"><%= picto("person") %></span>
      <span class="home-menu-label"><%= t("street.pick_profile") %></span>
    <% end %>
  <% end %>

  <div class="home-menu-list">
    <% unless current_page?(root_path) %>
      <%= render "shared/menu_row",
            path: root_path,
            icon: "compass",
            label: in_run ? t("street.ceremony_back_map") : t("street.nav_hub") %>
    <% end %>
    <%= render "shared/menu_row",
          path: street_history_path,
          icon: "scroll",
          label: t("street.history_menu") %>
  </div>

  <div class="home-menu-block">
    <p class="home-menu-kicker"><%= t("home.program") %></p>
    <%= render "shared/night_code" %>
    <div class="home-menu-list">
      <%= render "shared/menu_row",
            path: search_path,
            icon: "search",
            label: t("home.menu_search") %>
      <%= render "shared/menu_row",
            path: nights_path,
            icon: "sofa",
            label: t("home.nights") %>
    </div>
  </div>

  <div class="home-menu-list">
    <%= render "shared/menu_row",
          path: about_path,
          icon: "temple",
          label: t("home.who") %>
  </div>
</nav>
