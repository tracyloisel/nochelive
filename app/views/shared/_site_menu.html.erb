<% in_run = controller_name.in?(%w[street_plays street_challenges]) %>
<% tools = local_assigns.fetch(:tools, false) %>
<nav class="home-menu-nav" aria-label="<%= t("chrome.menu") %>">
  <% if tools %>
    <div class="home-menu-block">
      <button type="button"
              class="home-menu-row mute"
              data-action="stage#toggleMute"
              data-stage-target="mute"
              aria-pressed="false"
              aria-label="<%= t("chrome.sound_on") %>"
              data-sound-on="<%= t("chrome.sound_on") %>"
              data-sound-off="<%= t("chrome.sound_off") %>">
        <span class="home-menu-ico mute-ico" aria-hidden="true">
          <%= picto("sound") %>
          <%= picto("sound-off") %>
        </span>
        <span class="home-menu-label word"><%= t("chrome.sound_on") %></span>
        <span class="home-menu-row-caret" aria-hidden="true"><%= picto("arrow") %></span>
      </button>
      <%= render "shared/lang_switch", drawer: true %>
    </div>
  <% end %>

  <div class="home-menu-list">
    <button type="button"
            class="home-menu-row pwa-install-action"
            data-pwa-install-target="action"
            data-action="pwa-install#install"
            hidden>
      <span class="home-menu-ico" aria-hidden="true"><%= picto("sparkle") %></span>
      <span class="home-menu-label"><%= t("pwa.install") %></span>
      <span class="home-menu-row-caret" aria-hidden="true"><%= picto("arrow") %></span>
    </button>
    <% unless current_page?(root_path) %>
      <%= render "shared/menu_row",
            path: root_path,
            icon: "house",
            label: t("street.nav_hub") %>
    <% end %>
    <% if Notifications::Feature.enabled? %>
      <%= render "shared/menu_row",
            path: notification_settings_path,
            icon: "bell",
            label: t("notifications.settings.menu") %>
    <% end %>
    <% unless controller_name == "street_hub" && action_name == "map" %>
      <%= render "shared/menu_row",
            path: street_map_path,
            icon: "compass",
            label: in_run ? t("street.ceremony_back_map") : t("street.world_map") %>
    <% end %>
    <%= render "shared/menu_row",
          path: study_program_path,
          icon: "scroll",
          label: t("study.title") %>
    <%= render "shared/menu_row",
          path: jugar_path,
          icon: "sparkle",
          label: t("street.menu_play") %>
    <%= render "shared/menu_row",
          path: street_leaderboard_path,
          icon: "trophy",
          label: t("street.nav_ranking") %>
    <%= render "shared/menu_row",
          path: street_map_path(anchor: "historial"),
          icon: "scroll",
          label: t("street.history_menu") %>
  </div>

  <div class="home-menu-block">
    <p class="home-menu-kicker"><%= t("home.ward_menu") %></p>
    <div class="home-menu-list">
      <%= render "shared/night_code" %>
    </div>
  </div>

  <div class="home-menu-block">
    <p class="home-menu-kicker"><%= t("church.menu") %></p>
    <div class="home-menu-list">
      <%= render "shared/menu_row",
            path: search_path,
            icon: "search",
            label: t("home.menu_search") %>
      <%= render "shared/menu_row",
            path: church_path,
            icon: "house",
            label: t("church.title") %>
    </div>
  </div>

  <div class="home-menu-block">
    <p class="home-menu-kicker"><%= t("home.about_menu") %></p>
    <div class="home-menu-list">
      <%= render "shared/menu_row",
            path: about_path,
            icon: "temple",
            label: t("home.who") %>
      <%= render "shared/menu_row",
            path: platform_stats_path,
            icon: "podium",
            label: t("stats.menu") %>
      <%= render "shared/menu_row",
            path: legal_path,
            icon: "scroll",
            label: t("legal.title") %>
      <%= render "shared/menu_row",
            path: privacy_path,
            icon: "hush",
            label: t("privacy.title") %>
    </div>
  </div>
</nav>
