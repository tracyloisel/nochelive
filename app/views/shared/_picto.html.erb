<% name = local_assigns.fetch(:name).to_s.tr("_", "-") %>
<% size = local_assigns[:size] %>
<svg class="picto picto-<%= name %> <%= "picto-#{size}" if size %>" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <% case name %>
  <% when "door" %>
    <rect x="16" y="10" width="32" height="46" rx="6" fill="#1a2744"/>
    <rect x="20" y="16" width="24" height="36" rx="3" fill="#f6f3ec"/>
    <circle cx="38" cy="36" r="3" fill="#d4a017"/>
    <path d="M32 6l14 8H18z" fill="#d4a017"/>
  <% when "eye" %>
    <ellipse cx="32" cy="32" rx="24" ry="14" fill="#1a2744"/>
    <circle cx="32" cy="32" r="10" fill="#f6f3ec"/>
    <circle cx="32" cy="32" r="5" fill="#d4a017"/>
  <% when "wand" %>
    <rect x="30" y="18" width="4" height="36" rx="2" fill="#1a2744"/>
    <polygon points="32,6 36,16 48,18 38,26 40,38 32,30 24,38 26,26 16,18 28,16" fill="#d4a017"/>
  <% when "person" %>
    <circle cx="32" cy="20" r="10" fill="#d4a017"/>
    <path d="M16 54c2-14 10-20 16-20s14 6 16 20" fill="#1a2744"/>
  <% when "people" %>
    <circle cx="22" cy="22" r="8" fill="#d4a017"/>
    <path d="M8 54c2-12 8-17 14-17s12 5 14 17" fill="#1a2744"/>
    <circle cx="44" cy="20" r="8" fill="#f2c14e"/>
    <path d="M32 54c2-12 8-17 14-17s12 5 14 17" fill="#1a2744"/>
  <% when "sofa" %>
    <rect x="8" y="28" width="48" height="18" rx="8" fill="#d4a017"/>
    <rect x="14" y="20" width="36" height="14" rx="6" fill="#f2c14e"/>
    <rect x="10" y="44" width="8" height="10" rx="2" fill="#1a2744"/>
    <rect x="46" y="44" width="8" height="10" rx="2" fill="#1a2744"/>
  <% when "house" %>
    <path d="M8 30 L32 10 L56 30 V54 H8Z" fill="#1a2744"/>
    <rect x="26" y="36" width="12" height="18" fill="#f2c14e"/>
    <rect x="16" y="34" width="10" height="10" fill="#f6f3ec"/>
  <% when "check" %>
    <circle cx="32" cy="32" r="24" fill="#d4a017"/>
    <path d="M18 33 l10 10 18-20" fill="none" stroke="#1a2744" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  <% when "hourglass" %>
    <path d="M20 8h24v10L36 32l8 14v10H20V46l8-14-8-14z" fill="#d4a017"/>
    <path d="M24 12h16v4L32 28 24 16z" fill="#f6f3ec"/>
    <path d="M26 48h12v4H26z" fill="#1a2744"/>
  <% when "bell" %>
    <path d="M16 28c0-10 7-18 16-18s16 8 16 18v12H16z" fill="#d4a017"/>
    <rect x="14" y="38" width="36" height="8" rx="4" fill="#f2c14e"/>
    <circle cx="32" cy="50" r="4" fill="#1a2744"/>
    <rect x="28" y="6" width="8" height="8" rx="4" fill="#1a2744"/>
  <% when "send" %>
    <path d="M10 32 L54 12 L40 52 L30 36z" fill="#d4a017"/>
    <path d="M30 36 L54 12 L24 28z" fill="#f2c14e"/>
  <% when "statue", "statue" %>
    <circle cx="32" cy="14" r="8" fill="#d4a017"/>
    <rect x="24" y="22" width="16" height="22" rx="4" fill="#1a2744"/>
    <rect x="18" y="26" width="8" height="16" rx="3" fill="#1a2744"/>
    <rect x="38" y="26" width="8" height="16" rx="3" fill="#1a2744"/>
    <rect x="22" y="42" width="8" height="16" rx="3" fill="#1a2744"/>
    <rect x="34" y="42" width="8" height="16" rx="3" fill="#1a2744"/>
  <% when "stone" %>
    <circle cx="44" cy="22" r="10" fill="#d4a017"/>
    <path d="M12 48c8-18 22-22 40-10" fill="none" stroke="#1a2744" stroke-width="5" stroke-linecap="round"/>
    <path d="M14 46 l-6 8 12-2" fill="none" stroke="#1a2744" stroke-width="4" stroke-linecap="round"/>
  <% when "search" %>
    <circle cx="26" cy="26" r="14" fill="none" stroke="#1a2744" stroke-width="6"/>
    <path d="M36 36 L52 54" stroke="#d4a017" stroke-width="8" stroke-linecap="round"/>
  <% when "found" %>
    <circle cx="32" cy="32" r="24" fill="#d4a017"/>
    <circle cx="32" cy="32" r="12" fill="none" stroke="#1a2744" stroke-width="4"/>
    <path d="M22 33 l8 8 14-16" fill="none" stroke="#1a2744" stroke-width="5" stroke-linecap="round"/>
  <% when "phone" %>
    <rect x="20" y="8" width="24" height="44" rx="6" fill="#1a2744"/>
    <rect x="24" y="14" width="16" height="28" fill="#f6f3ec"/>
    <circle cx="32" cy="46" r="2.5" fill="#d4a017"/>
    <path d="M14 18 L50 50" stroke="#e4572e" stroke-width="5" stroke-linecap="round"/>
  <% when "speak" %>
    <ellipse cx="26" cy="32" rx="14" ry="12" fill="#d4a017"/>
    <path d="M36 26 L50 16 V48 L36 38Z" fill="#1a2744"/>
  <% when "ear" %>
    <path d="M40 12c-12 0-20 10-20 22s8 20 18 20c8 0 12-6 12-12 0-8-8-8-8-14 0-6 6-8 6-14 0-4-4-2-8-2z" fill="#d4a017"/>
    <path d="M34 24c-4 2-6 6-6 10" fill="none" stroke="#1a2744" stroke-width="3" stroke-linecap="round"/>
  <% when "hush" %>
    <circle cx="32" cy="32" r="24" fill="#fff1ec" stroke="#e4572e" stroke-width="4"/>
    <path d="M20 20 L44 44 M44 20 L20 44" stroke="#e4572e" stroke-width="5" stroke-linecap="round"/>
  <% when "chest" %>
    <rect x="10" y="28" width="44" height="24" rx="4" fill="#d4a017"/>
    <path d="M10 30 Q32 8 54 30" fill="#f2c14e"/>
    <rect x="8" y="28" width="48" height="8" fill="#1a2744"/>
    <circle cx="32" cy="40" r="5" fill="#f6f3ec"/>
  <% when "sound" %>
    <path d="M14 26h10l12-10v32L24 38H14z" fill="#1a2744"/>
    <path d="M42 22c6 6 6 14 0 20 M48 16c10 10 10 22 0 32" fill="none" stroke="#d4a017" stroke-width="4" stroke-linecap="round"/>
  <% when "sound-off" %>
    <path d="M14 26h10l12-10v32L24 38H14z" fill="#1a2744"/>
    <path d="M44 22 L56 42 M56 22 L44 42" stroke="#e4572e" stroke-width="4" stroke-linecap="round"/>
  <% when "circle" %>
    <circle cx="32" cy="32" r="22" fill="currentColor"/>
  <% when "square" %>
    <rect x="12" y="12" width="40" height="40" rx="6" fill="currentColor"/>
  <% when "triangle" %>
    <polygon points="32,10 54,52 10,52" fill="currentColor"/>
  <% when "star" %>
    <polygon points="32,8 38,24 56,24 42,36 48,54 32,42 16,54 22,36 8,24 26,24" fill="currentColor"/>
  <% when "plus" %>
    <circle cx="32" cy="32" r="24" fill="#d4a017"/>
    <rect x="28" y="16" width="8" height="32" rx="3" fill="#1a2744"/>
    <rect x="16" y="28" width="32" height="8" rx="3" fill="#1a2744"/>
  <% when "undo" %>
    <path d="M20 28a16 16 0 1 1 4 16" fill="none" stroke="#1a2744" stroke-width="6" stroke-linecap="round"/>
    <path d="M12 16 L20 30 L32 22" fill="#d4a017"/>
  <% when "hands" %>
    <circle cx="22" cy="28" r="10" fill="#d4a017"/>
    <circle cx="42" cy="28" r="10" fill="#f2c14e"/>
    <path d="M14 40c4 10 14 16 18 16s14-6 18-16" fill="#1a2744"/>
  <% when "sparkle" %>
    <polygon points="32,6 36,26 56,32 36,38 32,58 28,38 8,32 28,26" fill="#d4a017"/>
    <circle cx="50" cy="16" r="4" fill="#f2c14e"/>
    <circle cx="14" cy="48" r="3" fill="#f2c14e"/>
  <% when "trophy" %>
    <rect x="20" y="40" width="24" height="8" fill="#1a2744"/>
    <rect x="26" y="48" width="12" height="8" fill="#1a2744"/>
    <path d="M18 12h28v16c0 10-6 16-14 16s-14-6-14-16z" fill="#d4a017"/>
    <path d="M18 16h-8c0 10 6 14 10 14 M46 16h8c0 10-6 14-10 14" fill="none" stroke="#1a2744" stroke-width="4"/>
  <% when "dancer" %>
    <circle cx="32" cy="12" r="7" fill="#d4a017"/>
    <path d="M32 20 L20 36 L28 36 L24 56 L32 44 L40 56 L36 36 L44 36Z" fill="#1a2744"/>
  <% when "wave" %>
    <path d="M6 28c6-10 12-10 18 0s12 10 18 0 12-10 16 0" fill="none" stroke="#1a2744" stroke-width="5" stroke-linecap="round"/>
    <path d="M6 42c6-10 12-10 18 0s12 10 18 0 12-10 16 0" fill="none" stroke="#d4a017" stroke-width="5" stroke-linecap="round"/>
  <% when "fish" %>
    <ellipse cx="30" cy="32" rx="18" ry="12" fill="#d4a017"/>
    <path d="M46 32 L58 18 V46Z" fill="#1a2744"/>
    <circle cx="24" cy="28" r="3" fill="#1a2744"/>
  <% when "land" %>
    <circle cx="44" cy="18" r="8" fill="#f2c14e"/>
    <path d="M6 44 Q20 28 32 40 T58 36 V54 H6Z" fill="#d4a017"/>
    <rect x="8" y="50" width="48" height="8" fill="#1a2744"/>
  <% else %>
    <polygon points="32,8 38,24 56,24 42,36 48,54 32,42 16,54 22,36 8,24 26,24" fill="#d4a017"/>
  <% end %>
</svg>
