<% current = Locale.cast(local_assigns[:current] || I18n.locale) %>
<% url = local_assigns[:url] || locale_path_for %>
<% drawer = local_assigns[:drawer] %>
<details class="lang-switch<%= " is-drawer" if drawer %>">
  <summary class="<%= "home-menu-row" if drawer %>" aria-label="<%= t("locale.label") %>">
    <% if drawer %>
      <span class="home-menu-ico" aria-hidden="true">
        <span class="lang-flag"><%= locale_flag(current) %></span>
      </span>
      <span class="home-menu-label word"><%= t("locale.names.#{current}") %></span>
      <span class="home-menu-caret" aria-hidden="true"><%= picto("arrow") %></span>
    <% else %>
      <span class="lang-flag" aria-hidden="true"><%= locale_flag(current) %></span>
      <span class="word"><%= t("locale.names.#{current}") %></span>
    <% end %>
  </summary>
  <div class="lang-menu" role="list">
    <% Locale::AVAILABLE.each do |code| %>
      <%= button_to url,
            method: :patch,
            params: { locale: code },
            class: [ "lang-opt", ("is-on" if code == current) ],
            form_class: "lang-form" do %>
        <span class="lang-flag" aria-hidden="true"><%= locale_flag(code) %></span>
        <span class="lang-name"><%= t("locale.names.#{code}") %></span>
      <% end %>
    <% end %>
  </div>
</details>
