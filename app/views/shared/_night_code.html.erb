<details class="home-code">
  <summary class="home-menu-row">
    <span class="home-menu-ico" aria-hidden="true"><%= picto("door") %></span>
    <span class="home-menu-label"><%= t("home.night_code") %></span>
  </summary>
  <p class="lede"><%= t("home.night_code_hint") %></p>
  <%= form_with url: join_path, method: :post, class: "join-form home-join" do %>
    <label for="code"><%= t("home.code") %></label>
    <input id="code" name="code" inputmode="text" autocomplete="off" autocapitalize="characters" maxlength="8" required class="code-input" placeholder="DEMO">
    <button type="submit" class="btn btn-navy"><%= picto("door") %><%= t("home.enter") %></button>
    <p class="door-links">
      <button type="submit" name="as" value="present" class="quiet-link"><%= t("home.presenter") %></button>
      <button type="submit" name="as" value="watch" class="quiet-link"><%= t("home.watch") %></button>
    </p>
  <% end %>
</details>
