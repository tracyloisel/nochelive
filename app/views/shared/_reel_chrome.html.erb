<% night = local_assigns[:night] %>
<% current = local_assigns[:current] %>
<% team = local_assigns[:team] %>
<% player = local_assigns[:player] %>
<% title = local_assigns[:title] %>
<% close = local_assigns.fetch(:close, false) %>
<% ticks = local_assigns[:ticks] %>
<% live = local_assigns.fetch(:live, false) %>

<% if ticks == true && night && night.round_runs.any? %>
  <%= render "shared/story_ticks", night: night, current: current %>
<% end %>

<% if close || title.present? || team || (live && night) %>
<div class="story-meta">
  <% if close %>
    <%= render "shared/story_close", action: "click->story#exit" %>
  <% end %>
  <div class="story-cluster">
    <% if title.present? %>
      <p class="story-night"><%= title %></p>
    <% end %>
    <% if team %>
      <button type="button"
              class="story-score btn"
              data-action="click->story#toggleScore"
              aria-controls="play_score"
              aria-expanded="false"
              data-story-target="scoreBtn"
              aria-label="<%= t("chrome.points", score: team.cached_score) %>">
        <%= picto("star") %>
        <span><%= team.cached_score %></span>
      </button>
    <% end %>
    <% if live && night %>
      <%= render "shared/presence", night: night, team: team, compact: true, variant: "stage" %>
    <% end %>
  </div>
</div>
<% end %>

<% if team %>
  <div class="score-pop"
       id="play_score"
       hidden
       data-story-target="score"
       role="dialog"
       aria-label="<%= t("chrome.your_team") %>">
    <header class="team-bar">
      <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
      <div>
        <p class="eyebrow"><%= night&.code %></p>
        <h1><%= team.name %></h1>
      </div>
      <div class="who">
        <%= render "shared/avatar", player: player %>
        <p class="score" aria-label="<%= t("chrome.points_word") %>"><%= picto("star") %><%= team.cached_score %></p>
      </div>
      <%= render "play/progress", team: team %>
    </header>
    <% if team.streak.to_i >= 2 %>
      <p class="streak" role="status"><%= t("chrome.streak", count: team.streak) %></p>
    <% end %>
  </div>
<% end %>
