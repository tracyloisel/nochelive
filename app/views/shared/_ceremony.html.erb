<% you = local_assigns[:you] %>
<% champs = night.scored_finale? ? night.first_place_teams : [] %>
<% champ = night.scored_finale? ? night.champion : nil %>
<div class="ceremony <%= "is-empty" unless night.scored_finale? %>">
  <% if champ %>
    <div class="ceremony-hero">
      <span class="emblem emblem-xl emblem-<%= champ.emblem %>"><%= render "shared/emblem", key: champ.emblem %></span>
      <h1><%= champ.name %></h1>
      <p class="score" aria-label="<%= t("chrome.points_word") %>"><%= picto("trophy") %><%= champ.cached_score %></p>
      <% if line = roster_line(champ) %>
        <p class="roster"><%= line %></p>
      <% end %>
    </div>
    <p class="shout"><%= t("ceremony.wins", name: champ.name) %></p>
  <% elsif night.scored_finale? && night.tied_finale? %>
    <div class="ceremony-hero is-tie">
      <h1><%= t("ceremony.tie") %></h1>
      <ul class="tie-lockup">
        <% champs.each do |team| %>
          <li>
            <span class="emblem emblem-lg emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
            <strong><%= team.name %></strong>
            <em><%= team.cached_score %></em>
          </li>
        <% end %>
      </ul>
    </div>
    <p class="shout"><%= t("ceremony.tie_kings") %></p>
    <p class="lede"><%= champs.map(&:name).to_sentence %></p>
  <% else %>
    <p class="lede"><%= t("ceremony.closes") %></p>
  <% end %>

  <% if night.scored_finale? && night.visual_podium.any? && night.visual_podium.size > 1 %>
    <ol class="podium-steps">
      <% night.visual_podium.each do |other| %>
        <% place = night.place_for(other) %>
        <li class="step step-<%= place %> <%= "is-you" if you && other.id == you.id %> <%= "is-hero" if champ && other.id == champ.id %>">
          <p class="step-place"><%= picto(place == 1 ? "trophy" : "star") %><%= medal_label(place) %></p>
          <span class="emblem emblem-<%= other.emblem %>"><%= render "shared/emblem", key: other.emblem %></span>
          <strong><%= other.name %></strong>
          <em><%= other.cached_score %></em>
          <% if line = roster_line(other) %>
            <small><%= line %></small>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <p class="blessing"><%= finale_blessing %></p>

  <% if line = missionary_line(night) %>
    <p class="lede"><%= t("ceremony.with", names: line) %></p>
  <% end %>

  <% night.teams.select { |team| team.season_rank_up.present? }.each do |team| %>
    <p class="season-rise"><%= t("ceremony.season", name: team.name, rank: rank_name(team.season_rank_up)) %></p>
  <% end %>

  <% if you && night.scored_finale? && (place = night.place_for(you)) %>
    <% if champ&.id == you.id %>
      <p class="you-are"><%= t("ceremony.champions") %></p>
    <% elsif night.tied_finale? && champs.any? { |team| team.id == you.id } %>
      <p class="you-are"><%= t("ceremony.share_crown") %></p>
    <% else %>
      <p class="you-are"><%= t("ceremony.you_place", place: medal_label(place)) %></p>
    <% end %>
  <% end %>
</div>
