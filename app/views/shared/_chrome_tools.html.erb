<div class="chrome-tools">
  <button type="button" class="mute" data-action="stage#toggleMute" data-stage-target="mute" aria-pressed="false" aria-label="<%= t("chrome.sound_on") %>" data-sound-on="<%= t("chrome.sound_on") %>" data-sound-off="<%= t("chrome.sound_off") %>">
    <%= picto("sound") %>
    <%= picto("sound-off") %>
    <span class="word"><%= t("chrome.sound_on") %></span>
  </button>
  <%= render "shared/lang_switch" %>
</div>
