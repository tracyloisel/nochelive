<% current = local_assigns[:current] %>
<ol class="stage-ticks story-ticks" aria-label="<%= t("chrome.rounds") %>">
  <% night.round_runs.each_with_index do |tick, index| %>
    <li class="<%= "is-done" if tick.completed? %> <%= "is-now" if current&.id == tick.id %>" title="<%= tick.definition.copy(:title) %>">
      <button type="button"
              class="story-tick"
              data-story-target="tick"
              data-action="story#jump"
              data-story-index="<%= index %>"
              aria-label="<%= t("chrome.round_n", n: tick.position) %> · <%= tick.definition.copy(:title) %>"
              aria-current="<%= current&.id == tick.id ? "step" : "false" %>">
      </button>
    </li>
  <% end %>
</ol>
