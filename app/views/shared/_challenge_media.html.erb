<% story = challenge_story(round) %>
<% clip_rel = challenge_clip(round) %>
<% clip_src = clip_rel && (clip_rel.start_with?("/") ? clip_rel : "/#{clip_rel}") %>
<% burger = round&.definition&.layered_finale? %>
<% cinema = local_assigns[:cinema] %>
<% kind = burger ? burger_garnish_kind(round) : nil %>
<% count = burger ? burger_garnish_count(round, cinema: cinema) : 0 %>
<% burst = local_assigns.dig(:pulse, :kind).to_s == "cheer" %>
<% if story || clip_src %>
  <%= tag.div class: [ "challenge-media", ("is-cinema" if cinema), ("is-burger" if burger), ("is-arriving" if burger && round.layer_index.to_i.positive?) ],
              data: (burger ? {
                controller: "garnish",
                garnish_kind_value: kind,
                garnish_count_value: count,
                garnish_burst_value: burst
              } : {}) do %>
    <% if clip_src %>
      <video class="challenge-clip" autoplay loop muted playsinline poster="<%= story %>" src="<%= clip_src %>"></video>
    <% elsif story %>
      <img src="<%= story %>" alt="" class="challenge-story">
    <% end %>
    <% if burger %>
      <div class="garnish" data-garnish-target="rain" aria-hidden="true"></div>
    <% end %>
  <% end %>
<% end %>
