<% layers = round.definition.layers %>
<ol class="burger-stack" aria-label="<%= t("chrome.burger_layers") %>">
  <% layers.each_with_index do |layer, index| %>
    <% number = index + 1 %>
    <% state = if round.layer_index.to_i <= 0
                 "is-todo"
               elsif round.last_layer? || round.phase.in?(%w[open locked answering revealed])
                 "is-done"
               elsif number < round.layer_index
                 "is-done"
               elsif number == round.layer_index
                 "is-now"
               else
                 "is-todo"
               end %>
    <li class="burger-tick <%= state %>">
      <%= picto(layer["picto"]) %>
      <span class="word"><%= round.definition.layer_copy(layer, "label") %></span>
    </li>
  <% end %>
</ol>
