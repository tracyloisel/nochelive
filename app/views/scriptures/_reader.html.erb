<aside class="scripture-veil"
       role="dialog"
       aria-modal="true"
       aria-labelledby="scripture-title"
       data-stage-bed-value="study_refuge"
       <% if @chapter %>data-scripture-reference="<%= @study %>" data-scripture-read-url="<%= scripture_reads_path %>"<% end %>>
  <div class="scripture-sheet">
    <header class="scripture-head">
      <button type="button"
              class="story-close scripture-close"
              data-action="click->scripture#close"
              data-scripture-close
              aria-label="<%= t("quiz.scripture_close") %>">
        <%= picto("close") %>
      </button>
      <div class="scripture-head-copy">
        <h1 id="scripture-title"><%= @chapter&.title.presence || @cite.presence || t("quiz.read_more") %></h1>
        <% if @chapter %>
          <p class="scripture-read-count"
             data-scripture-read-count
             aria-live="polite"
             <%= "hidden" unless @scripture_reads_count.to_i.positive? %>><%= scripture_read_count_label(@scripture_reads_count) %></p>
        <% end %>
      </div>
    </header>

    <div class="scripture-body">
      <% if @chapter %>
        <% if @chapter.summary.present? %>
          <p class="scripture-summary"><%= @chapter.summary %></p>
        <% end %>
        <% illustrations = Array(@scripture_illustrations).index_by(&:anchor_verse) %>
        <% @chapter.verses.each do |verse| %>
          <% focused = @chapter.focus.include?(verse.number) %>
          <p class="scripture-verse <%= "is-focus" if focused %>"
             <% if focused && verse.number == @chapter.focus.first %>data-scripture-focus<% end %>>
            <span class="scripture-verse-n"><%= verse.number %></span>
            <%= verse.text %>
          </p>
          <%= render "scriptures/illustration", illustration: illustrations[verse.number] if illustrations[verse.number] %>
        <% end %>
      <% else %>
        <p class="scripture-error"><%= t("quiz.scripture_error") %></p>
      <% end %>
    </div>

    <footer class="scripture-foot">
      <p class="scripture-source"><%= t("quiz.scripture_source") %></p>
      <%= link_to t("quiz.scripture_open_site"), @source_url, class: "quiet-link", target: "_blank", rel: "noopener" %>
    </footer>
  </div>
</aside>
