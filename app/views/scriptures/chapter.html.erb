<% content_for :body_class, "is-kid is-scripture-passage" %>
<% page_hud(hud: true, tools: false) { site_menu(tools: false) } %>

<article class="scripture-seo-page scripture-chapter-page">
  <nav class="seo-breadcrumbs" aria-label="<%= t("seo.scripture.breadcrumbs") %>">
    <%= link_to scripture_corpus_label(@reference), scripture_corpus_path(@reference) %>
    <span aria-hidden="true">/</span>
    <%= link_to @reference.book_label, scripture_book_path(**Scriptures::Reference.book_path_options(@reference, @reference.locale)) %>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= @reference.chapter %></span>
  </nav>
  <header class="scripture-seo-head">
    <p class="scripture-seo-kicker"><%= t("seo.scripture.kicker") %></p>
    <h1><%= @reference.citation %></h1>
    <% if @chapter.summary.present? %><p><%= @chapter.summary %></p><% end %>
  </header>

  <section class="scripture-seo-reading" aria-label="<%= t("seo.scripture.read_chapter", reference: @reference.citation) %>">
    <% illustrations = Array(@scripture_illustrations).index_by(&:anchor_verse) %>
    <% @chapter.verses.each do |verse| %>
      <% verse_reference = Scriptures::Reference.resolve(locale: @reference.route_locale, section: @reference.section,
            book: @reference.book, chapter: @reference.chapter, verse: verse.number) %>
      <p class="scripture-verse" id="verse-<%= verse.number %>">
        <%= link_to scripture_passage_path(**Scriptures::Reference.path_options(verse_reference, @reference.locale)),
              class: "scripture-verse-link", aria: { label: verse_reference.citation } do %>
          <span class="scripture-verse-n"><%= verse.number %></span><%= verse.text %>
        <% end %>
      </p>
      <%= render "scriptures/illustration", illustration: illustrations[verse.number] if illustrations[verse.number] %>
    <% end %>
  </section>

  <nav class="scripture-seo-neighbors" aria-label="<%= t("seo.scripture.chapter_navigation") %>">
    <% if @previous_chapter %>
      <%= link_to t("seo.scripture.previous_chapter", reference: @previous_chapter.citation),
            scripture_chapter_path(**Scriptures::Reference.chapter_path_options(@previous_chapter, @reference.locale)) %>
    <% end %>
    <% if @next_chapter %>
      <%= link_to t("seo.scripture.next_chapter", reference: @next_chapter.citation),
            scripture_chapter_path(**Scriptures::Reference.chapter_path_options(@next_chapter, @reference.locale)) %>
    <% end %>
  </nav>
  <footer class="scripture-seo-foot">
    <%= link_to t("seo.scripture.source"), @chapter.source_url, target: "_blank", rel: "noopener", class: "quiet-link" %>
    <%= link_to t("seo.scripture.play"), jugar_path, class: "btn btn-gold" %>
  </footer>
</article>
<% page_dock(active: :word) %>
