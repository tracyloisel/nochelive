<h1><%= t("join.homonyms_title") %></h1>
<p class="lede"><%= t("join.homonyms_lede", name: @given_name) %></p>
<p class="hint"><%= t("join.homonyms_hint") %></p>

<ul class="team-list person-list">
  <% cards.each do |card| %>
    <% on_device = @people_on_device.any? { |row| row.id == card.person.id } %>
    <li>
      <% if on_device %>
        <%= button_to street_profile_path, params: { person_id: card.person.id }, class: "team-pick person-pick is-here" do %>
          <%= render "people/card", person: card.person, show_year: true, hint: t("join.this_phone") %>
        <% end %>
      <% else %>
        <%= link_to street_profile_path(person_id: card.person.id), class: "team-pick person-pick is-away" do %>
          <%= render "people/card", person: card.person, show_year: true, hint: t("join.other_phone") %>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= link_to street_profile_path(fresh: 1, name: @given_name), class: "btn btn-ghost" do %>
  <%= picto("plus") %><%= t("join.new_person") %>
<% end %>
