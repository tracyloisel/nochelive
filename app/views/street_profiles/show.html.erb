<% content_for :title, t("street.profile_title") %>
<% content_for :body_class, "is-kid is-paper-hall is-street-profile" %>
<%= chrome_menu(face: false, hud: false) { site_menu } %>

<section id="street_quien" class="profile-world">
  <div class="profile-rays" aria-hidden="true"></div>
  <header class="profile-stage">
    <span class="profile-star" aria-hidden="true"><%= picto("star8") %></span>
    <p class="profile-brand">Noche Live</p>
    <h1><%= @screen == :edit ? t("street.edit_profile_title") : (@screen == :device ? t("join.device_title") : t("street.quick_profile_title")) %></h1>
    <% if current_ward %>
      <p class="profile-rama"><%= picto("church") %><%= current_ward.name %></p>
    <% end %>
  </header>

  <main class="profile-panel <%= "is-edit" if @screen == :edit %>">
    <% case @screen %>
    <% when :edit %>
      <%= render "street_profiles/edit", person: @person %>
    <% when :welcome %>
      <%= render "street_profiles/welcome", person: @welcome_person %>
    <% when :device %>
      <%= render "street_profiles/device_people", people: @listed_people, current_person: @person %>
    <% when :homonyms %>
      <%= render "street_profiles/homonyms", cards: @homonym_cards %>
    <% when :claim %>
      <%= render "street_profiles/claim", person: @claim_person %>
    <% else %>
      <%= render "street_profiles/form" %>
    <% end %>

    <nav class="profile-actions">
      <% if @person %>
        <%= button_to street_profile_path, params: { logout: 1 }, class: "quiet-link street-sign-out" do %>
          <%= picto("door") %><%= t("street.sign_out") %>
        <% end %>
      <% end %>
    </nav>
  </main>
</section>

<%= render Navigation::DockComponent.new(active: :profile) %>
