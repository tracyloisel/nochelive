<% content_for :title, @screen == :profile ? t("street.profile_dashboard.page_title") : t("street.profile_title") %>
<% content_for :body_class, "is-kid is-paper-hall is-street-profile#{" is-profile-editor" if @editor_key.present?}" %>
<% enable_frontend_audio unless @screen == :profile %>
<% page_hud(face: false, hud: false) { site_menu } %>

<section id="street_quien" class="profile-world">
  <div class="profile-rays" aria-hidden="true"></div>
  <header class="profile-stage">
    <span class="profile-star" aria-hidden="true"><%= picto("star8") %></span>
    <p class="profile-brand">Noche Live</p>
    <h1><%= @screen == :profile ? t("street.profile_dashboard.title") : (@screen == :device ? t("join.device_title") : t("street.quick_profile_title")) %></h1>
    <% if @screen == :profile %>
      <%= link_to street_profile_path(not_me: 1), class: "profile-glass-secondary profile-switch-player" do %>
        <%= picto("person") %><%= t("street.switch_profile") %>
      <% end %>
    <% end %>
    <% if current_ward && @screen != :profile %>
      <div class="profile-rama-switcher">
        <div class="profile-rama profile-rama-current"><%= picto("church") %><span><%= current_ward.name %></span></div>
        <%= link_to search_path(cambiar: 1),
              class: "btn btn-ghost profile-rama-change",
              "aria-label": t("street.change_ward") do %>
          <span><%= t("street.change_ward_short") %></span>
        <% end %>
      </div>
    <% end %>
  </header>

  <main class="profile-panel <%= "is-dashboard" if @screen == :profile %>">
    <% case @screen %>
    <% when :profile %>
      <%= render "street_profiles/profile", snapshot: @snapshot, editor_key: @editor_key %>
    <% when :welcome %>
      <%= render "street_profiles/welcome", person: @welcome_person %>
    <% when :device %>
      <%= render "street_profiles/device_people", people: @listed_people, current_person: @person %>
    <% when :homonyms %>
      <%= render "street_profiles/homonyms", cards: @homonym_cards %>
    <% when :claim %>
      <%= render "street_profiles/claim", person: @claim_person %>
    <% else %>
      <%= render "street_profiles/form" %>
    <% end %>

    <nav class="profile-actions">
      <% if @person %>
        <%= button_to street_profile_path, params: { logout: 1 }, class: "profile-glass-secondary street-sign-out" do %>
          <%= picto("door") %><%= t("street.sign_out") %>
        <% end %>
      <% end %>
    </nav>
  </main>
</section>

<% page_dock(active: :profile) %>
