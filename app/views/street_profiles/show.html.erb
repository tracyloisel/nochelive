<% content_for :title, t("street.profile_title") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>

<%= paper_hall id: "street_quien", kicker: t("street.profile_title"), extra_class: "street-quien", sheet_class: "street-quien-sheet" do %>
    <% if @person && @screen != :welcome %>
      <div class="street-quien-session">
        <p class="eyebrow"><%= t("street.signed_in_as") %> <strong><%= @person.given_name %></strong></p>
        <%= render "street_profiles/ward_switch" %>
        <% unless @screen == :form %>
          <%= button_to street_profile_path, params: { guest: 1 }, class: "quiet-link" do %>
            <%= t("street.sign_out") %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% case @screen %>
    <% when :welcome %>
      <%= render "street_profiles/welcome", person: @welcome_person %>
    <% when :device %>
      <%= render "street_profiles/device_people", people: @listed_people %>
    <% when :homonyms %>
      <%= render "street_profiles/homonyms", cards: @homonym_cards %>
    <% when :claim %>
      <%= render "street_profiles/claim", person: @claim_person %>
    <% else %>
      <%= render "street_profiles/form" %>
    <% end %>

    <nav class="street-quien-foot hall-sheet-foot">
      <% if @person && @screen == :welcome %>
        <%= button_to street_profile_path, params: { guest: 1 }, class: "quiet-link" do %>
          <%= t("street.sign_out") %>
        <% end %>
      <% elsif @screen == :form %>
        <%= button_to street_profile_path, params: { guest: 1 }, class: "quiet-link", formnovalidate: true do %>
          <%= t("street.continue_guest") %>
        <% end %>
      <% end %>

      <%= link_to root_path, class: "quiet-link" do %>
        <%= t("street.back_quiz") %>
      <% end %>
    </nav>
<% end %>
