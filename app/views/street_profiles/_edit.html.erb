<section class="street-profile-portrait" aria-labelledby="profile-player-name">
  <div class="profile-hero-seal">
    <span class="profile-hero-orbit" aria-hidden="true"></span>
    <% if (src = avatar_mark(person)) %>
      <img src="<%= src %>" alt="" class="avatar-img avatar-hero" width="160" height="160">
    <% end %>
    <span class="profile-hero-star" aria-hidden="true"><%= picto("star8") %></span>
  </div>
  <div class="profile-hero-copy">
    <p class="profile-hero-kicker"><%= t("street.current_profile") %></p>
    <h2 id="profile-player-name"><%= person.given_name %></h2>
    <p><%= t("street.edit_profile_lede", name: person.given_name) %></p>
  </div>
</section>

<%= form_with url: street_profile_path, method: :patch, class: "join-form profile-edit-form" do %>
  <div class="profile-name-field">
    <label for="profile_name"><%= t("street.edit_name") %></label>
    <input id="profile_name" name="name" maxlength="24" required autocomplete="given-name" class="code-input" value="<%= person.given_name %>">
  </div>

  <fieldset class="emblem-pick avatar-pick profile-gate-avatars">
    <legend><span><%= t("street.edit_avatar") %></span></legend>
    <% Player::AVATARS.each do |key| %>
      <label class="emblem-choice avatar-choice">
        <input type="radio" name="avatar_key" value="<%= key %>" <%= "checked" if key == person.avatar_key %> required>
        <span class="avatar-seal" aria-hidden="true">
          <img src="<%= avatar_mark(key) %>" alt="" class="avatar-img avatar-img-lg">
        </span>
        <span class="avatar-selected" aria-hidden="true"><%= picto("check") %></span>
        <em><%= avatar_name(key) %></em>
      </label>
    <% end %>
  </fieldset>

  <button type="submit" class="btn btn-gold"><%= picto("check") %><%= t("street.save_profile") %></button>
<% end %>

<%= render "street_profiles/merge_candidates", cards: @merge_candidates if @merge_candidates.present? %>

<%= link_to street_profile_path(not_me: 1), class: "quiet-link" do %>
  <%= picto("person") %><%= t("street.switch_profile") %>
<% end %>
