<h2><%= @needs_family ? t("join.family") : t("street.create_title") %></h2>
<% unless @needs_family %>
  <p class="lede"><%= t(current_ward ? "street.profile_one_step" : "street.quick_profile_lede", ward: current_ward&.name) %></p>
<% end %>

<%= form_with url: street_profile_path(quick: params[:quick].presence, ward_next: params[:ward_next].presence), method: :post, class: "join-form profile-gate-new" do %>
  <% if @needs_family %>
    <input type="hidden" name="name" value="<%= @given_name %>">
    <input type="hidden" name="avatar_key" value="<%= @avatar_key.presence || "delfin" %>">
    <input type="hidden" name="favorite_year" value="<%= @favorite_year %>">
    <input type="hidden" name="soy_nueva" value="1">
    <label for="family_name"><%= t("join.family") %></label>
    <input id="family_name" name="family_name" maxlength="24" required class="code-input" placeholder="<%= t("join.family_ph") %>" value="<%= @family_name %>" autocomplete="family-name">
    <button type="submit" class="btn btn-gold"><%= picto("check") %><%= t("join.save_ficha") %></button>
  <% else %>
    <label for="name"><%= t("street.create_who") %></label>
    <input id="name" name="name" maxlength="24" required autocomplete="given-name" class="code-input" placeholder="Pili" value="<%= @given_name %>">

    <button type="submit" class="btn btn-gold"><%= picto("arrow") %><%= t("street.quick_profile_cta") %></button>
    <p class="profile-later"><%= t("street.avatar_automatic") %></p>
  <% end %>
<% end %>
