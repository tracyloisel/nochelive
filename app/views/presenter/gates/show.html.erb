<% content_for :title, t("presenter.title") %>
<% shot = capture do %>
  <%= render "shared/still", src: night_still_src(@night), poster: true %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: @night, title: "#{@night.code} · #{@night.ward.name}", close: true %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "mid", handle: false, reel_class: "is-join" do %>
  <div id="night_presenter_gate">
    <h1><%= t("presenter.console") %></h1>
    <p class="lede"><%= t("presenter.gate_lede") %></p>

    <%= button_to presenter_claim_path(@night.code), class: "btn btn-gold" do %>
      <%= picto("wand") %><%= t("presenter.i_am") %>
    <% end %>
  </div>
<% end %>
