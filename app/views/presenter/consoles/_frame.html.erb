<% round = night.current_round_run %>
<% live_index = night.round_runs.find_index { |tick| round && tick.id == round.id }.to_i %>
<%= tag.section class: "console is-stage",
                id: "night_presenter",
                data: stage_audio_data(round, night: night).merge(
                  controller: "story",
                  story_exit_url_value: root_path,
                  story_index_value: live_index,
                  story_live_index_value: live_index,
                  action: "pointerdown->story#start sheet:dismiss->story#exit"
                ) do %>
  <% if (claim = night.pending_presenter_claim) %>
    <%= render "presenter/claims/challenge", night: night, claim: claim %>
  <% end %>
  <p class="skip"><%= t("chrome.skip_presenter") %></p>
  <div class="stage-reel">
    <div class="stage-shot">
      <% if night.finished? %>
        <%= render "shared/still", src: ceremony_still_src(night), icon: "trophy" %>
      <% elsif round %>
        <%= render "shared/story_pages", night: night, current: round, reveal_future: true, cinema: true, pulse: local_assigns[:pulse] %>
      <% else %>
        <%= render "shared/still", src: night_still_src(night), poster: true %>
      <% end %>
    </div>

    <div class="stage-overlay">
      <header class="stage-chrome">
        <div class="story-bar">
          <%= render "shared/story_close", action: "click->story#exit" %>
          <% unless night.finished? %>
            <%= render "shared/story_ticks", night: night, current: round %>
          <% end %>
        </div>
        <div class="stage-bar">
          <p class="code-chip"><%= night.code %></p>
        </div>
      </header>

      <div class="stage-caption">
        <% if night.finished? %>
          <p class="eyebrow"><%= t("presenter.night_end") %></p>
        <% elsif round %>
          <p class="eyebrow"><%= t("chrome.round_of", n: round.position, total: night.round_runs.size) %></p>
          <h1 class="stage-title">
            <%= render "shared/round_icon", key: round.definition.icon %>
            <span><%= round.definition.copy(:title) %></span>
          </h1>
          <% if round.definition.layered_finale? %>
            <%= render "shared/burger_stack", round: round %>
          <% end %>
          <% if round.definition.layered_finale? %>
            <% if round.intro? && round.layer_index.to_i.zero? %>
              <p class="lede"><%= t("presenter.stand_wait") %></p>
            <% elsif round.intro? && (layer = round.current_layer) %>
              <p class="lede"><%= round.definition.layer_copy(layer, "label") %></p>
              <p class="lede"><%= round.definition.layer_copy(layer, "host") %></p>
              <% layer_cheers(round).each do |cheer| %>
                <p class="quiet"><%= t("presenter.cheer_line", from: cheer.player.name, to: cheer.to_player.name) %></p>
              <% end %>
            <% elsif round.phase.in?(%w[open locked answering]) %>
              <p class="lede"><%= round.definition.copy(:question) %></p>
              <p class="lede"><%= burger_host_value_line(night, round) %></p>
            <% end %>
          <% else %>
            <p class="lede"><%= round_prompt(round) %></p>
          <% end %>
          <% if round.definition.mime? && round.definition.story_path? %>
            <p class="lede"><%= t("presenter.jonah_home") %></p>
          <% end %>
        <% end %>
      </div>

      <% unless night.finished? %>
        <nav class="stage-dock" aria-label="<%= t("presenter.controls") %>">
          <div class="console-actions stage-dock-main">
            <% if (action = presenter_next_action(night, round)) %>
              <%= button_to action[:label], action[:url], class: "btn btn-gold" %>
            <% end %>
          </div>
          <details class="stage-more">
            <summary class="quiet-link"><%= t("presenter.more") %></summary>
            <div class="cluster stage-dock-more">
              <% if night.playing? %>
                <%= button_to t("presenter.pause"), presenter_pause_path(night.code), class: "btn btn-ghost btn-tiny" %>
              <% end %>
              <%= button_to t("presenter.end_night"), presenter_finish_path(night.code), class: "btn btn-ghost btn-tiny", form: { data: { turbo_confirm: t("presenter.end_confirm") } } %>
              <%= link_to t("presenter.list"), presenter_roster_path(night.code), class: "quiet-link" %>
              <%= link_to t("presenter.fichas"), presenter_fichas_path(night.code), class: "quiet-link" %>
            </div>
          </details>
        </nav>
      <% end %>
    </div>
  </div>

  <% guests = night.ward ? night.players.participants.where(person_id: nil).to_a : [] %>
  <% play_desk = round&.live? || (round && !round.completed?) %>
  <% grades = play_desk ? round.score_events.select { |event| event.kind.in?(%w[correct incorrect]) }.index_by(&:team_id) : {} %>
  <% pending = play_desk ? round.answers.count { |answer| grades[answer.team_id].blank? } : 0 %>
  <% burger_quiet = play_desk && round.definition.layered_finale? && !round.phase.in?(%w[open locked answering revealed]) %>
  <% desk_tab = if burger_quiet
                  "marcador"
                elsif pending.positive? || (play_desk && (round.answers.any? || round.buzzes.any?))
                  "respuestas"
                else
                  "marcador"
                end %>
  <div class="stage-desk desk-sheet story-sheet"
       data-controller="sheet desk"
       data-story-target="sheet"
       data-sheet-snap="<%= night.finished? ? "mid" : "peek" %>"
       data-sheet-snap-value="<%= night.finished? ? "mid" : "peek" %>"
       data-sheet-open-label-value="<%= t("chrome.grip_open") %>"
       data-sheet-mid-label-value="<%= t("chrome.grip_mid") %>"
       data-sheet-peek-label-value="<%= t("chrome.grip_peek") %>"
       data-desk-night-value="<%= night.code %>"
       data-desk-tab-value="<%= desk_tab %>"
       data-action="pointerdown->sheet#start">
    <% unless night.finished? %>
    <button type="button"
            class="play-sheet-grip"
            data-sheet-target="handle"
            data-action="click->sheet#cycle"
            aria-label="<%= t("chrome.grip_desk") %>"
            aria-valuetext="<%= t("chrome.grip_desk_value") %>">
      <span class="play-sheet-pip" aria-hidden="true"></span>
    </button>
    <% end %>
    <div class="play-sheet-body" data-sheet-target="body">
    <p class="desk-tools">
      <%= link_to t("presenter.list"), presenter_roster_path(night.code), class: "quiet-link" %>
      <%= link_to t("presenter.fichas"), presenter_fichas_path(night.code), class: "quiet-link" %>
    </p>
    <% if night.finished? %>
      <%= render "shared/ceremony", night: night %>
    <% else %>
      <nav class="desk-tabs" role="tablist" aria-label="<%= t("presenter.desk") %>">
        <button type="button" class="btn btn-tiny desk-tab" role="tab" data-desk-target="tab" data-action="desk#show" data-desk-pane="respuestas" aria-controls="desk_respuestas">
          <%= t("presenter.answers") %><% if pending.positive? %><span class="desk-count"><%= pending %></span><% end %>
        </button>
        <button type="button" class="btn btn-tiny desk-tab" role="tab" data-desk-target="tab" data-action="desk#show" data-desk-pane="marcador" aria-controls="desk_marcador">
          <%= t("presenter.scoreboard") %>
        </button>
      </nav>

    <div class="desk-pane" id="desk_respuestas" role="tabpanel" data-desk-target="pane" data-desk-pane="respuestas">
  <% if play_desk %>
    <article class="console-round">
      <% if play_desk && round.definition.layered_finale? && round.phase.in?(%w[open locked answering]) %>
        <p class="quiet"><%= round.definition.copy(:answer) %></p>
        <p class="lede"><%= burger_host_value_line(night, round) %></p>
      <% end %>
      <% if round.buzzes.any? %>
        <h3><%= t("presenter.buzz") %></h3>
        <ol class="buzz-board">
          <% round.buzzes.includes(:team, :player).each do |buzz| %>
            <%= render "shared/buzz_line", buzz: buzz, show_player: true %>
          <% end %>
        </ol>
      <% end %>

      <% if round.answers.any? %>
        <% if round.answers.size >= 2 %>
          <label class="desk-search">
            <input type="search" data-desk-target="query" data-action="input->desk#filter" value="" autocomplete="off" enterkeyhint="search" aria-label="<%= t("presenter.search") %>" placeholder="<%= t("presenter.search") %>">
          </label>
        <% end %>
        <ul class="answer-list">
          <% round.answers.includes(:team).sort_by { |answer|
            grade = grades[answer.team_id]
            rank = if grade.nil? then 0
                    elsif grade.kind == "incorrect" then 1
                    else 2
                    end
            [ rank, answer.created_at.to_i ]
          }.each do |answer| %>
            <% label = answer_body_label(round, answer) %>
            <% grade = grades[answer.team_id] %>
            <li class="desk-answer <%= "is-yes" if grade&.kind == "correct" %> <%= "is-no" if grade&.kind == "incorrect" %>" data-desk-target="row" data-desk-hay="<%= answer.team.name %> <%= label %>">
              <div class="desk-answer-copy">
                <p class="eyebrow"><%= answer.team.name %></p>
                <p class="desk-answer-body"><%= label %></p>
              </div>
              <% if grade %>
                <% yes = grade.kind == "correct" %>
                <span class="cluster desk-grade">
                  <p class="desk-mark <%= yes ? "is-yes" : "is-no" %>">
                    <%= picto(yes ? "tick" : "cross") %>
                    <span class="word"><%= yes ? t("presenter.correct") : t("presenter.incorrect") %></span>
                  </p>
                  <% if yes %>
                    <%= button_to t("presenter.incorrect"), presenter_scores_path(night.code), params: { team_id: answer.team_id, round_run_id: round.id, kind: "incorrect" }, class: "btn btn-ghost btn-tiny" %>
                  <% else %>
                    <%= button_to t("presenter.correct"), presenter_scores_path(night.code), params: { team_id: answer.team_id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold btn-tiny" %>
                  <% end %>
                </span>
              <% else %>
                <span class="cluster desk-grade">
                  <%= button_to t("presenter.correct"), presenter_scores_path(night.code), params: { team_id: answer.team_id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold btn-tiny" %>
                  <%= button_to t("presenter.incorrect"), presenter_scores_path(night.code), params: { team_id: answer.team_id, round_run_id: round.id, kind: "incorrect" }, class: "btn btn-ghost btn-tiny" %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
        <p class="quiet" data-desk-target="empty" hidden><%= t("presenter.no_match") %></p>
      <% else %>
        <p class="quiet"><%= t("presenter.no_answers") %></p>
      <% end %>

      <% if round.definition.taboo? %>
        <div class="taboo-desk">
          <p class="eyebrow"><%= t("presenter.story") %></p>
          <p class="secret-target"><%= round.definition.copy(:target) %></p>
          <p class="eyebrow"><%= t("presenter.if_said") %></p>
          <ul class="forbidden">
            <% round.definition.forbidden_copy.each do |word| %>
              <li><%= word %></li>
            <% end %>
          </ul>
          <% night.teams.each do |team| %>
            <%= button_to t("presenter.guessed", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold" %>
            <%= button_to t("presenter.said_word", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "incorrect" }, class: "btn btn-ghost" %>
          <% end %>
        </div>
      <% end %>

      <% if round.definition.freeze? %>
        <div class="freeze-desk hunt-desk">
          <p class="eyebrow"><%= t("presenter.dance") %></p>
          <% if round.open? %>
            <p class="lede"><%= t("presenter.room_dances") %></p>
          <% else %>
            <p class="lede"><%= t("presenter.who_still") %></p>
          <% end %>
          <% night.teams.each do |team| %>
            <% caught = round.answers.find { |row| row.team_id == team.id } %>
            <p>
              <span><%= team.name %> · <span class="quiet"><%= caught ? "#{caught.body.to_i} ms" : t("presenter.in_room") %></span></span>
              <span class="cluster">
                <%= button_to t("presenter.still", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold btn-tiny" %>
                <%= button_to t("presenter.moved", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "incorrect" }, class: "btn btn-ghost btn-tiny" %>
              </span>
            </p>
          <% end %>
        </div>
      <% end %>

      <% if round.definition.vote? %>
        <div class="hunt-desk">
          <p class="eyebrow"><%= t("presenter.judgment") %></p>
          <p class="lede"><%= round.definition.copy(:question) %></p>
          <% if line = vote_tally_line(round) %>
            <p class="shout"><%= line %></p>
          <% end %>
          <ul class="answer-list">
            <% night.teams.order(:name).each do |team| %>
              <li>
                <strong><%= team.name %></strong>
                <p><%= t("presenter.votes", count: round.ballots.where(choice_team: team).count) %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if round.definition.category? %>
        <div class="hunt-desk">
          <p class="eyebrow"><%= t("presenter.prophets") %></p>
          <p class="lede"><%= t("presenter.three_names") %></p>
          <ul class="cluster order-preview">
            <% round.definition.guess_keys.each do |name| %>
              <li><%= name %></li>
            <% end %>
          </ul>
          <% claims = round.answers.includes(:team, :player).order(:created_at) %>
          <% if claims.any? %>
            <ol class="buzz-board">
              <% claims.each_with_index do |claim, index| %>
                <li>
                  <span><%= medal_label(index + 1) %></span>
                  <%= claim.team.name %>
                  · <%= claim.player.remote? ? t("presenter.n_names", count: round.definition.matching_names(claim.body).size) : t("presenter.in_room") %>
                </li>
              <% end %>
            </ol>
          <% end %>
          <% night.teams.each do |team| %>
            <% claimed = claims.any? { |claim| claim.team_id == team.id } %>
            <p>
              <span><%= team.name %> · <span class="quiet"><%= claimed ? t("presenter.already") : t("presenter.still_going") %></span></span>
              <%= button_to t("presenter.said_it", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold" %>
            </p>
          <% end %>
        </div>
      <% end %>

      <% if round.definition.scavenger? %>
        <div class="hunt-desk">
          <p class="eyebrow"><%= t("presenter.hunt") %></p>
          <p class="lede"><%= t("presenter.sound_item") %></p>
          <% claims = round.answers.includes(:team).order(:created_at) %>
          <% if claims.any? %>
            <ol class="buzz-board">
              <% claims.each_with_index do |claim, index| %>
                <li><span><%= medal_label(index + 1) %></span> <%= claim.team.name %></li>
              <% end %>
            </ol>
          <% end %>
          <% night.teams.each do |team| %>
            <% claimed = claims.any? { |claim| claim.team_id == team.id } %>
            <p>
              <span><%= team.name %> · <span class="quiet"><%= claimed ? t("presenter.they_have_it") : t("presenter.still_looking") %></span></span>
              <%= button_to t("presenter.they_have", name: team.name), presenter_scores_path(night.code), params: { team_id: team.id, round_run_id: round.id, kind: "correct" }, class: "btn btn-gold" %>
            </p>
          <% end %>
        </div>
      <% end %>

      <% if round.definition.physical? || round.definition.pose? || round.definition.mime? || round.definition.taboo? || round.definition.scavenger? || round.definition.freeze? || round.definition.category? %>
        <h3><%= t("presenter.room_points") %></h3>
        <% night.teams.each do |team| %>
          <%= render "presenter/consoles/team_score", night: night, team: team, filterable: true %>
        <% end %>
      <% end %>
    </article>
  <% else %>
    <p class="quiet"><%= t("presenter.no_answers") %></p>
  <% end %>
    </div>

    <% unless night.finished? %>
    <div class="desk-pane" id="desk_marcador" role="tabpanel" data-desk-target="pane" data-desk-pane="marcador" hidden>
      <aside class="desk-board" aria-label="<%= t("presenter.scoreboard") %>">
        <% night.teams.order(cached_score: :desc).each do |team| %>
          <%= render "presenter/consoles/team_score", night: night, team: team %>
        <% end %>
      </aside>

      <% if night.score_events.any? %>
        <details class="ledger desk-ledger">
          <summary><%= t("presenter.ledger") %></summary>
          <ul>
            <% night.score_events.includes(:team).order(created_at: :desc).limit(12).each do |event| %>
              <li><%= event.team.name %>: <%= event.points %> · <%= score_reason_label(event.reason) %></li>
            <% end %>
          </ul>
        </details>
      <% end %>

      <% if guests.any? %>
        <details class="desk-ledger">
          <summary><%= t("presenter.guests", count: guests.size) %></summary>
          <p class="quiet"><%= t("presenter.guests_hint") %></p>
          <div class="desk-board">
            <% guests.each do |player| %>
              <% matches = night.ward.people.named(player.name) %>
              <article class="desk-link">
                <p class="desk-team-name"><%= t("presenter.no_ficha", name: player.name) %></p>
                <% if matches.any? %>
                  <span class="cluster">
                    <% matches.each do |person| %>
                      <%= button_to t("presenter.is_person", name: person.display_name), presenter_person_link_path(night.code, person), params: { player_id: player.id }, class: "btn btn-tiny btn-ghost" %>
                    <% end %>
                  </span>
                <% end %>
                <% if night.ward.people.any? %>
                  <%= form_with url: presenter_people_link_path(night.code), class: "desk-link-form" do %>
                    <input type="hidden" name="player_id" value="<%= player.id %>">
                    <label class="quiet" for="person_id_<%= player.id %>"><%= t("presenter.ficha") %></label>
                    <select id="person_id_<%= player.id %>" name="person_id">
                      <% night.ward.people.order(:given_name, :family_name).each do |person| %>
                        <option value="<%= person.id %>"><%= person.display_name %></option>
                      <% end %>
                    </select>
                    <button type="submit" class="btn btn-tiny btn-gold"><%= t("presenter.link") %></button>
                  <% end %>
                <% end %>
              </article>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
    <% end %>
    <% end %>
  </div>
  </div>
<% end %>
