<% content_for :title, t("presenter.table") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>

<%= paper_hall id: "claim_wait", kicker: t("presenter.table") do %>
  <% case claim.status %>
  <% when "granted" %>
    <section data-controller="visit" data-visit-url-value="<%= presenter_console_path(night.code) %>">
      <%= render "shared/wait", message: t("presenter.yours") %>
    </section>
  <% when "blocked" %>
    <%= render "shared/wait", message: t("presenter.blocked") %>
    <%= link_to t("presenter.back"), presenter_gate_path(night.code), class: "btn btn-ghost" %>
  <% when "refused" %>
    <%= render "shared/wait", message: t("presenter.still_holder") %>
    <%= link_to t("presenter.ask_again"), presenter_gate_path(night.code), class: "btn btn-navy" %>
  <% else %>
    <%= render "shared/wait", message: t("presenter.waiting") %>
    <p class="lede"><%= t("presenter.wait_minute") %></p>
    <div class="play-timer"
         data-controller="countdown"
         data-countdown-end-value="<%= claim.expires_at.iso8601 %>"
         data-countdown-duration-value="<%= PresenterClaim::TIMEOUT %>"
         data-countdown-reload-url-value="<%= presenter_claim_path(night.code) %>">
      <div class="play-timer-track"><span class="play-timer-bar" data-countdown-target="bar"></span></div>
      <p class="play-timer-count" data-countdown-target="label"><%= PresenterClaim::TIMEOUT %></p>
    </div>
  <% end %>
<% end %>
