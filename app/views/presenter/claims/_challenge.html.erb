<aside class="claim-veil" role="dialog" aria-modal="true" aria-labelledby="claim-title">
  <div class="claim-modal">
    <p class="eyebrow">La mesa</p>
    <h2 id="claim-title">¿Ceder la consola?</h2>
    <p class="lede"><%= claim.name %> quiere presentar esta noche. Si no respondes, en un minuto cedes.</p>
    <div class="play-timer"
         data-controller="countdown"
         data-countdown-end-value="<%= claim.expires_at.iso8601 %>"
         data-countdown-duration-value="<%= PresenterClaim::TIMEOUT %>">
      <div class="play-timer-track"><span class="play-timer-bar" data-countdown-target="bar"></span></div>
      <p class="play-timer-count" data-countdown-target="label"><%= PresenterClaim::TIMEOUT %></p>
    </div>
    <%= button_to "Ceder la mesa", presenter_claim_resolve_path(night.code, claim), params: { decision: "grant" }, class: "btn btn-gold" %>
    <%= button_to "Seguir yo", presenter_claim_resolve_path(night.code, claim), params: { decision: "refuse" }, class: "btn btn-navy" %>
    <%= button_to "Nunca esta persona", presenter_claim_resolve_path(night.code, claim), params: { decision: "block" }, class: "btn btn-ghost" %>
    <p class="quiet">Nunca = solo esta noche, para este teléfono.</p>
  </div>
</aside>
