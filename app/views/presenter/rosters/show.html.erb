<% content_for :title, "#{t("presenter.list")} · #{@night.code}" %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>

<%= paper_hall id: "night_roster", kicker: "#{t("presenter.title")} · #{@night.code}" do %>
  <%= render "shared/hall_still", src: night_still_src(@night) %>
  <section class="roster-desk">
    <h1><%= t("presenter.roster_title") %></h1>
    <p class="lede"><%= t("presenter.roster_lede") %></p>

    <%= render "shared/roster", night: @night, assign_locale: true %>

    <article class="missionary-card">
      <h2><%= t("presenter.missionaries") %></h2>
      <p class="quiet"><%= t("presenter.missionaries_hint") %></p>
      <ul class="missionary-list">
        <% @missionaries.each do |missionary| %>
          <li class="missionary-row">
            <strong><%= missionary.name %></strong>
            <%= button_to t("presenter.remove"), presenter_missionary_path(@night.code, missionary), method: :delete, class: "btn btn-tiny btn-ghost" %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: presenter_missionaries_path(@night.code), class: "join-form" do %>
        <label for="name"><%= t("presenter.name") %></label>
        <input id="name" name="name" maxlength="32" required class="code-input" placeholder="Élder Soto" autocomplete="name">
        <button type="submit" class="btn btn-gold"><%= t("presenter.add_night") %></button>
      <% end %>
    </article>

    <nav class="hall-sheet-foot">
      <%= link_to t("presenter.console_link"), presenter_console_path(@night.code), class: "btn btn-navy" %>
      <%= link_to t("presenter.fichas"), presenter_fichas_path(@night.code), class: "quiet-link" %>
    </nav>
  </section>
<% end %>
