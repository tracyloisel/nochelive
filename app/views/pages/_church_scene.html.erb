<section class="church-scene church-scene--<%= scene %>" style="--church-scene: url('/media/church/journey/<%= scene %>-v2.png')">
  <div class="church-scene-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="church-scene-head">
    <%= link_to church_path, class: "church-back", aria: { label: t("church.back") } do %><%= picto("arrow") %><% end %>
    <span><%= t("church.kicker") %></span>
    <span class="church-chapter"><%= chapter %> / 4</span>
  </div>
  <div class="church-scene-copy">
    <p class="church-scene-kicker"><%= kicker %></p>
    <h1><%= title %></h1>
    <%= yield %>
  </div>
  <%= render Navigation::DockComponent.new(active: :church) %>
</section>
