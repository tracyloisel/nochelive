<% content_for :title, t("legal.title") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>
<%= charter_hall id: "legal_charter", kicker: t("legal.kicker") do %>
  <h1><%= t("legal.title") %></h1>
  <p class="charter-updated"><%= t("legal.updated") %></p>

  <section class="charter-block">
    <h2><%= t("legal.nature_title") %></h2>
    <p><%= t("legal.nature") %></p>
    <p><%= t("legal.status") %></p>
  </section>

  <dl class="paper-facts">
    <div>
      <dt><%= t("legal.editor") %></dt>
      <dd><%= t("legal.editor_name") %></dd>
    </div>
    <div>
      <dt><%= t("legal.contact") %></dt>
      <dd><%= mail_to t("legal.email") %></dd>
    </div>
    <div>
      <dt><%= t("legal.host") %></dt>
      <dd>
        <%= t("legal.host_name") %><br>
        <%= t("legal.host_address") %><br>
        <%= link_to t("legal.host_site"), "https://render.com", target: "_blank", rel: "noreferrer", class: "quiet-link" %>
      </dd>
    </div>
  </dl>

  <section class="charter-block">
    <h2><%= t("legal.law_title") %></h2>
    <p><%= t("legal.law") %></p>
  </section>

  <nav class="hall-sheet-foot">
    <%= link_to t("legal.privacy_link"), privacy_path, class: "quiet-link" %>
  </nav>
<% end %>
