<% content_for :title, t("stats.title") %>
<% content_for :body_class, "is-kid is-paper-hall is-celestial-dark is-stats" %>
<% enable_frontend_audio %>
<% declare_frontend_resources(
     context: "platform.stats",
     styles: %w[shell stats],
     controllers: %w[loading press stats-reveal],
     audio: { unlock: true, cues: %w[question_change correct_gold stake_gain] },
     motion: %w[result-reveal list-enter],
     classes: {
       "style.shell" => "critical",
       "style.stats" => "critical",
       "controller.stats_reveal" => "contextual",
       "audio.stats" => "interaction",
       "motion.stats" => "contextual"
     }
   ) %>
<% page_hud(
      hud: true,
      bar: @screen.hud
    ) { site_menu } %>

<section id="stats_page"
         class="stats-page"
         data-controller="stats-reveal"
         data-stats-reveal-countdown-value="1200"
         style="--stats-path-share: <%= (@stats.path_share * 100).round %>%">
  <header class="stats-header">
    <h1>
      <span class="stats-header-rule stats-header-rule-l" aria-hidden="true"></span>
      <%= t("stats.title") %>
      <span class="stats-header-rule stats-header-rule-r" aria-hidden="true"></span>
    </h1>
    <span class="stats-header-star" aria-hidden="true"><%= picto("star4") %></span>
    <p class="stats-header-lede"><%= t("stats.lede") %></p>
  </header>

  <!-- Chapter 1: La Maison -->
  <section class="stats-chapter stats-house"
           data-stats-reveal-target="chapter"
           data-chapter="house">
    <h2>
      <span class="stats-chapter-icon" aria-hidden="true"><%= picto("stats-house") %></span>
      <span class="stats-chapter-num" aria-hidden="true">1</span>
      <%= t("stats.house.title") %>
    </h2>
    <p class="stats-chapter-lede"><%= t("stats.house.lede") %></p>

    <div class="stats-house-grid">
      <div class="stats-tiles stats-tiles-trio">
        <% [
          [ "stats-player", @stats.people, "stats.people" ],
          [ "stats-parish", @stats.wards, "stats.wards" ],
          [ "stats-globe", @stats.countries, "stats.countries" ]
        ].each do |icon, value, key| %>
          <article class="stats-tile" data-stat-value="<%= value %>">
            <span class="stats-tile-ico" aria-hidden="true"><%= picto(icon) %></span>
            <p class="stats-tile-value" data-stat-counter>
              <span class="stats-tile-current" data-stat-current>0</span>
            </p>
            <p class="stats-tile-label"><%= t(key) %></p>
          </article>
        <% end %>
      </div>

      <div class="stats-langs" aria-label="<%= t("stats.languages") %>">
        <p class="stats-langs-title"><%= picto("stats-language") %><span><%= t("stats.languages") %></span></p>
        <% @stats.languages.each_with_index do |lang, idx| %>
          <article class="stats-lang" data-lang-index="<%= idx %>" data-stat-lang="item" data-stat-value="<%= lang.count %>">
            <p class="stats-lang-row">
              <span class="stats-lang-dot" aria-hidden="true">
                <span class="stats-lang-dot-fill"></span>
              </span>
              <span class="stats-lang-name"><%= t("locale.names.#{lang.code}") %></span>
              <span class="stats-lang-count" data-stat-counter><span class="stats-tile-current" data-stat-current>0</span></span>
            </p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Chapter 2: Le Chemin -->
  <section class="stats-chapter stats-path"
           data-stats-reveal-target="chapter"
           data-chapter="path">
    <h2>
      <span class="stats-chapter-icon" aria-hidden="true"><%= picto("stats-path") %></span>
      <span class="stats-chapter-num" aria-hidden="true">2</span>
      <%= t("stats.path.title") %>
    </h2>
    <p class="stats-chapter-lede"><%= t("stats.path.lede") %></p>

    <div class="stats-path-grid">
    <div class="stats-path-hero">
      <article class="stats-tile stats-tile-hero" data-stat-value="<%= @stats.answers %>">
        <span class="stats-tile-ico" aria-hidden="true"><%= picto("stats-question") %></span>
        <p class="stats-tile-value" data-stat-counter>
          <span class="stats-tile-current" data-stat-current>0</span>
        </p>
        <p class="stats-tile-label"><%= t("stats.answers") %></p>
      </article>
    </div>

    <div class="stats-path-row">
      <article class="stats-tile stats-tile-inline" data-stat-value="<%= @stats.correct %>">
        <span class="stats-tile-ico" aria-hidden="true"><%= picto("stats-correct") %></span>
        <p class="stats-tile-value" data-stat-counter>
          <span class="stats-tile-current" data-stat-current>0</span>
        </p>
        <p class="stats-tile-label"><%= t("stats.correct") %></p>
      </article>
      <article class="stats-tile stats-tile-inline" data-stat-value="<%= @stats.wrong %>">
        <span class="stats-tile-ico" aria-hidden="true"><%= picto("stats-wrong") %></span>
        <p class="stats-tile-value" data-stat-counter>
          <span class="stats-tile-current" data-stat-current>0</span>
        </p>
        <p class="stats-tile-label"><%= t("stats.wrong") %></p>
      </article>
    </div>

    <div class="stats-path-circle"
         style="--stats-path-share: <%= (@stats.path_share * 100).round %>%"
         role="img"
         aria-label="<%= t("stats.path.ratio", correct: number_with_delimiter(@stats.correct), total: number_with_delimiter(@stats.answers)) %>">
      <svg viewBox="0 0 120 120" class="stats-path-svg" aria-hidden="true">
        <circle class="stats-path-bg" cx="60" cy="60" r="50" stroke-width="8" fill="none"/>
        <circle class="stats-path-ring" cx="60" cy="60" r="50" stroke-width="8" fill="none"
                stroke-dasharray="314.159"
                stroke-dashoffset="314.159"/>
      </svg>
      <p class="stats-path-pct" data-stat-counter>
        <span class="stats-tile-current" data-stat-current>0</span><span class="stats-path-pct-sym">%</span>
      </p>
      <p class="stats-tile-label"><%= t("stats.success_rate") %></p>
    </div>
    </div>
  </section>

  <!-- Chapter 3: Rencontres -->
  <section class="stats-chapter stats-meet"
           data-stats-reveal-target="chapter"
           data-chapter="meet">
    <h2>
      <span class="stats-chapter-icon" aria-hidden="true"><%= picto("stats-team") %></span>
      <span class="stats-chapter-num" aria-hidden="true">3</span>
      <%= t("stats.meet.title") %>
    </h2>
    <p class="stats-chapter-lede"><%= t("stats.meet.lede") %></p>

    <div class="stats-tiles stats-tiles-trio">
      <% [
        [ "stats-duel", @stats.duels, "stats.duels" ],
        [ "stats-night", @stats.nights, "stats.nights" ],
        [ "stats-team", @stats.teams, "stats.teams" ]
      ].each do |icon, value, key| %>
        <article class="stats-tile stats-tile-meet" data-stat-value="<%= value %>">
          <span class="stats-tile-ico" aria-hidden="true"><%= picto(icon) %></span>
          <p class="stats-tile-value" data-stat-counter>
            <span class="stats-tile-current" data-stat-current>0</span>
          </p>
          <p class="stats-tile-label"><%= t(key) %></p>
        </article>
      <% end %>
    </div>
  </section>

  <!-- Chapter 4: Invitations -->
  <section class="stats-chapter stats-invitations"
           data-stats-reveal-target="chapter"
           data-chapter="invitations">
    <h2>
      <span class="stats-chapter-icon stats-invitations-medallion" aria-hidden="true">
        <%= noche_media_picture("media/social/icon-share-medallion-v1.png", alt: "", loading: "lazy") %>
      </span>
      <span class="stats-chapter-num" aria-hidden="true">4</span>
      <%= t("stats.invitations.title") %>
    </h2>
    <p class="stats-chapter-lede"><%= t("stats.invitations.lede") %></p>

    <div class="stats-invitations-funnel" aria-label="<%= t("stats.invitations.funnel_label") %>">
      <% [
        [ @stats.invitations_sent, "sent" ],
        [ @stats.invitations_opened, "opened" ],
        [ @stats.friends_joined, "joined" ],
        [ @stats.invitation_duels_completed, "completed" ]
      ].each_with_index do |(value, state), index| %>
        <article class="stats-invitation-step is-<%= state %>" data-stat-value="<%= value %>">
          <span class="stats-invitation-order" aria-hidden="true"><%= index + 1 %></span>
          <p class="stats-tile-value" data-stat-counter><span class="stats-tile-current" data-stat-current>0</span></p>
          <p class="stats-tile-label"><%= t("stats.invitations.#{state}") %></p>
        </article>
      <% end %>
    </div>

    <p class="stats-invitations-conversion">
      <strong><%= number_to_percentage(@stats.invitation_share * 100, precision: 0) %></strong>
      <span><%= t("stats.invitations.conversion") %></span>
    </p>
  </section>

  <!-- Chapter 5: Ligue mondiale -->
  <section class="stats-chapter stats-world"
           data-stats-reveal-target="chapter"
           data-chapter="world">
    <h2>
      <span class="stats-chapter-icon" aria-hidden="true"><%= picto("stats-trophy") %></span>
      <span class="stats-chapter-num" aria-hidden="true">5</span>
      <%= t("stats.world.title") %>
    </h2>
    <p class="stats-chapter-lede"><%= t("stats.world.lede") %></p>

    <% if @stats.world.empty? %>
      <p class="stats-empty"><%= t("stats.world.empty") %></p>
    <% else %>
      <ol class="stats-world-list" aria-label="<%= t("stats.world.title") %>">
        <% @stats.world.select { |row| row.rank.between?(1, 5) }.each do |row| %>
          <%= render "pages/stats_world_row", row:, ranked: true %>
        <% end %>
      </ol>

      <% if @stats.world.size > 5 %>
        <details class="stats-world-expand">
          <summary class="stats-world-summary"
                  data-action="click->stats-reveal#openExpand"
                  aria-label="<%= t("stats.see_all") %>">
            <span><%= t("stats.see_all") %></span>
            <span class="stats-world-chevron" aria-hidden="true"><%= picto("stats-chevron") %></span>
          </summary>
          <ol class="stats-world-list stats-world-list-full">
            <% @stats.world.select { |row| row.rank.between?(6, 20) }.each do |row| %>
              <%= render "pages/stats_world_row", row:, ranked: false %>
            <% end %>
          </ol>
        </details>
      <% end %>
    <% end %>
  </section>

  <!-- Qui sommes-nous ? -->
  <a href="<%= about_path %>"
     class="stats-about"
     data-action="click->stats-reveal#aboutClick"
     aria-label="<%= t("stats.about.label") %>">
    <span class="stats-about-icon" aria-hidden="true"><%= picto("stats-team") %></span>
    <span class="stats-about-text">
      <span class="stats-about-title"><%= t("stats.about.title") %></span>
      <span class="stats-about-desc"><%= t("stats.about.desc") %></span>
    </span>
    <span class="stats-about-chevron" aria-hidden="true"><%= picto("stats-chevron") %></span>
  </a>

</section>
<% page_dock(active: :home) %>
