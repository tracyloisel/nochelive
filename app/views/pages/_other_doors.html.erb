<% except = local_assigns.fetch(:except).to_sym %>
<nav class="paper-other-doors" aria-label="<%= t("church.doors") %>">
  <% [
    [ :meet, church_meet_path, "people", "church.meet_title" ],
    [ :beliefs, church_beliefs_path, "star8", "church.beliefs_title" ],
    [ :missionaries, church_missionaries_path, "person", "church.missionaries_title" ],
    [ :worship, church_worship_path, "temple", "church.worship_title" ]
  ].reject { |key,| key == except }.each do |_, path, icon, title_key| %>
    <%= link_to path, class: "btn btn-navy" do %>
      <%= picto(icon) %><%= t(title_key) %>
    <% end %>
  <% end %>
</nav>
