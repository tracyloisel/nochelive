<% content_for :title, t("home.who") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<%= chrome_menu { site_menu } %>

<%= paper_hall id: "ward_add", kicker: t("home.who"), extra_class: "is-about" do %>
  <% portrait = about_portrait_src %>
  <% if portrait %>
    <figure class="about-face">
      <img src="<%= portrait %>" alt="<%= t("about.portrait_alt") %>" width="640" height="640">
      <figcaption>
        <strong>Tracy Loisel</strong>
        <span><%= t("about.role") %></span>
      </figcaption>
    </figure>
  <% end %>
  <h1><%= t("about.title") %></h1>
  <p class="lede"><%= t("about.gift") %></p>
  <p class="lede"><%= t("about.born") %></p>
  <%= render "shared/hall_still", src: night_poster_src("reyes_y_profetas") %>
  <p class="lede"><%= t("about.source") %></p>
  <%= link_to t("about.github"), source_repo_url, class: "quiet-link", target: "_blank", rel: "noreferrer" %>
  <p class="lede"><%= t("about.purse") %></p>
  <p class="lede"><%= t("about.association") %></p>
  <p class="lede"><%= t("about.disclaimer") %></p>
<% end %>
