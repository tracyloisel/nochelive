<%= chrome_menu { site_menu } %>
<% content_for :title, t("home.who") %>
<% shot = capture do %>
  <%= render "shared/still", src: night_poster_src("reyes_y_profetas"), poster: true %>
<% end %>
<%= story_reel shot: shot, chrome: nil, snap: "open", mid: 0.55, handle: false, reel_class: "is-join", skip: t("chrome.skip_home") do %>
  <h1><%= t("ward.add_title") %></h1>
  <p class="lede"><%= t("ward.add_lede") %></p>
  <p class="lede"><%= t("ward.add_run") %></p>
  <% if @ward %>
    <p class="lede"><%= t("ward.add_ask", name: @ward.name) %></p>
  <% end %>
  <p class="lede"><%= t("ward.add_fork") %></p>
  <%= link_to t("ward.add_source"), source_repo_url, class: "quiet-link", target: "_blank", rel: "noreferrer" %>
  <% if @ward %>
    <%= link_to ward_profile_path(@ward.code), class: "btn btn-gold" do %>
      <%= picto("door") %><%= t("ward.add_see", name: @ward.name) %>
    <% end %>
  <% else %>
    <%= link_to t("presenter.back"), root_path, class: "btn btn-gold" %>
  <% end %>
<% end %>
