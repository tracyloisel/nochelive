<% hero = screen.hero %>
<% voyage = screen.voyage %>
<% themed_hero = screen.backdrop.hero %>
<% reward_chest_src = street_ceremony_asset_src("reward-chest") %>
<% play_inner = capture do %>
  <span class="hub-play__seal" aria-hidden="true"><%= picto("compass") %></span>
  <span class="hub-play__label"><%= t("street.world_play") %></span>
  <span class="hub-play__arrow" aria-hidden="true"><%= picto("arrow") %></span>
<% end %>
<article class="hub-hero hub-hero--themed"
         data-controller="hub-voyage hub-portal"
         data-hub-portal-target="hero"
         aria-label="<%= t("hub.continue") %>">
  <div class="hub-hero-stage">
    <div class="hub-voyage" data-hub-voyage-target="track">
      <% [ voyage.previous, voyage.current, voyage.next ].compact.each do |slide| %>
        <% current = slide.kind == :current %>
        <% kicker = current ? hero.kicker : slide.kicker %>
        <% pack_name = current ? hero.title : slide.title %>
        <% lede = current ? hero.lede : slide.lede %>
        <% step_n = current ? hero.step_n : slide.step_n %>
        <% step_total = current ? hero.step_total : slide.step_total %>
        <% reward = current ? hero.reward : slide.reward %>
        <% play_method = current ? hero.method : slide.method %>
        <% play_path = current ? hero.path : slide.path %>
        <% still_source = current && themed_hero.present? ? themed_hero : (current ? hero.still : slide.still) %>
        <% progress_percent = step_total.to_i.positive? ? (((step_n.to_i - 1).clamp(0, step_total.to_i) * 100.0) / step_total.to_i).round : 0 %>
        <section class="hub-slide is-<%= slide.kind %><%= " is-locked" if slide.state == :locked %>"
                 data-kind="<%= slide.kind %>">
          <span class="hub-hero-worldmark" aria-hidden="true">
            <strong>Noche</strong>
            <span class="hub-hero-worldmark__sub">Live Hub</span>
            <span class="hub-hero-worldmark__tagline"><%= t("hub.continue") %></span>
          </span>
          <% if still_source.present? %>
            <%= noche_media_picture(
                  still_source,
                  alt: "",
                  class_name: "hub-slide-still",
                  loading: (current ? "eager" : "lazy"),
                  fetchpriority: ("high" if current),
                  sizes: "(max-width: 767px) 768px, 100vw"
                ) %>
          <% end %>
          <div class="hub-slide-copy">
            <div class="hub-slide-copy-top">
              <p class="hub-kicker hub-hero-continue"><%= t("hub.continue") %></p>
              <h2 class="hub-hero-title"><%= kicker %></h2>
              <div class="hub-hero-meta">
                <p class="hub-hero-step"><%= t("hub.step", n: step_n, total: step_total) %></p>
                <p class="hub-hero-name"><%= pack_name %></p>
              </div>
              <p class="hub-hero-lede"><%= lede %></p>
              <% if current %>
                <div class="hub-hero-progress"
                     role="progressbar"
                     aria-label="<%= t("hub.rank_progress") %>"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="<%= progress_percent %>">
                  <span class="hub-hero-progress__emblem" aria-hidden="true"><%= picto("crown") %></span>
                  <span class="hub-hero-progress__body">
                    <span class="hub-hero-progress__label"><%= pack_name %></span>
                    <span class="hub-hero-progress__rail" aria-hidden="true"><i style="width: <%= progress_percent %>%"></i></span>
                  </span>
                  <strong><%= progress_percent %> %</strong>
                </div>
              <% end %>
            </div>
            <div class="hub-hero-actions">
              <% if play_path.present? %>
                <% if play_method == :get %>
                  <%= link_to play_path,
                        class: "hub-play",
                        data: { action: "click->hub-portal#launch" } do %>
                    <%= play_inner %>
                  <% end %>
                <% else %>
                  <%= button_to play_path,
                        class: "hub-play",
                        form: {
                          data: {
                            turbo: false,
                            action: "submit->hub-portal#launch"
                          },
                          class: "hub-play-form"
                        } do %>
                    <%= play_inner %>
                  <% end %>
                <% end %>
              <% else %>
                <p class="hub-slide-wait">
                  <%= picto("lock") %>
                  <span><%= t("hub.voyage_next") %></span>
                </p>
              <% end %>
              <% if reward.to_i.positive? %>
                <span class="hub-reward">
                  <% if reward_chest_src %>
                    <%= noche_media_picture(
                          reward_chest_src,
                          alt: "",
                          class_name: "hub-reward-chest"
                        ) %>
                  <% else %>
                    <%= picto("chest") %>
                  <% end %>
                  <span class="hub-reward-copy">
                    <em class="hub-reward-label"><%= t("hub.reward") %></em>
                    <strong class="hub-reward-value">
                      <span>+<%= reward %></span>
                      <%= picto("crown") %>
                    </strong>
                  </span>
                </span>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </div>
    <%= link_to street_map_path, class: "hub-hero-info", aria: { label: t("hub.info") } do %>
      <%= picto("info") %>
    <% end %>
    <div class="hub-dots" data-hub-voyage-target="dots"></div>
  </div>
</article>
