<% hero = screen.hero %>
<% resumable = hero.state == :resume %>
<% reward_chest_src = street_ceremony_asset_src("reward-chest") %>
<% still_source = hero.still.presence || screen.backdrop.hero %>
<% eyebrow = t(resumable ? "hub.resume_eyebrow" : "hub.next_eyebrow") %>
<% action_label = resumable ? t("hub.resume_action", n: hero.step_n) : t("hub.start_action") %>
<% step_label = t("hub.question_step", n: hero.step_n, total: hero.step_total) %>
<% progress_percent = hero.step_total.to_i.positive? ? (((hero.step_n.to_i - 1).clamp(0, hero.step_total.to_i) * 100.0) / hero.step_total.to_i).round : 0 %>
<% play_inner = capture do %>
  <span class="hub-play__seal" aria-hidden="true"><%= picto("compass") %></span>
  <span class="hub-play__label"><%= action_label %></span>
  <span class="hub-play__arrow" aria-hidden="true"><%= picto("arrow") %></span>
<% end %>
<article class="hub-hero hub-hero--themed"
         data-controller="hub-portal"
         data-hub-portal-target="hero"
         data-hub-hero-art="<%= still_source %>"
         data-hero-state="<%= hero.state %>"
         aria-label="<%= action_label %>">
  <div class="hub-hero-stage">
    <%# This wrapper remains a layout hook, but the Home intentionally renders
        one action only. Browsing other packs belongs on the Adventure map. %>
    <div class="hub-voyage">
      <section class="hub-slide is-current" data-kind="current" aria-hidden="false">
        <span class="hub-hero-worldmark" aria-hidden="true">
          <strong>Noche</strong>
          <span class="hub-hero-worldmark__sub">Live Hub</span>
          <span class="hub-hero-worldmark__tagline"><%= eyebrow %></span>
        </span>
        <% if still_source.present? %>
          <%= noche_media_picture(
                still_source,
                alt: "",
                class_name: "hub-slide-still",
                loading: "eager",
                fetchpriority: "high",
                sizes: "(max-width: 767px) 768px, 100vw"
              ) %>
        <% end %>
        <div class="hub-slide-copy">
          <div class="hub-slide-copy-top">
            <p class="hub-kicker hub-hero-continue"><%= eyebrow %></p>
            <h2 class="hub-hero-title"><%= hero.kicker %></h2>
            <div class="hub-hero-meta">
              <p class="hub-hero-step"><%= step_label %></p>
              <p class="hub-hero-name"><%= hero.title %></p>
            </div>
            <p class="hub-hero-lede"><%= hero.lede %></p>
          </div>
          <div class="hub-hero-actions">
            <div class="hub-hero-cockpit__row">
              <div class="hub-hero-progress"
                   role="progressbar"
                   aria-label="<%= step_label %>"
                   aria-valuemin="0"
                   aria-valuemax="100"
                   aria-valuenow="<%= progress_percent %>">
                <span class="hub-hero-progress__emblem" aria-hidden="true"><%= picto("crown") %></span>
                <span class="hub-hero-progress__body">
                  <span class="hub-hero-progress__label"><%= step_label %></span>
                  <span class="hub-hero-progress__rail" aria-hidden="true"><i style="width: <%= progress_percent %>%"></i></span>
                </span>
                <strong><%= progress_percent %> %</strong>
              </div>
              <% if hero.method == :get %>
                <%= link_to hero.path,
                      class: "hub-play",
                      data: { action: "click->hub-portal#launch" } do %>
                  <%= play_inner %>
                <% end %>
              <% else %>
                <%= button_to hero.path,
                      class: "hub-play",
                      form: {
                        data: {
                          turbo: false,
                          action: "submit->hub-portal#launch"
                        },
                        class: "hub-play-form"
                      } do %>
                  <%= play_inner %>
                <% end %>
              <% end %>
            </div>
            <% if screen.league&.rank %>
              <div class="hub-hero-league-panel">
                <%= link_to street_leaderboard_path, class: "hub-hero-league", aria: { label: t("hub.hero_league_open") } do %>
                  <span class="hub-hero-league__rank"><%= picto("podium") %><strong>#<%= screen.league.rank %></strong></span>
                  <span class="hub-hero-league__copy">
                    <b><%= t("hub.hero_league_position", rank: screen.league.rank, players: screen.league.players) %></b>
                    <% if screen.league.rank == 1 %>
                      <small><%= t("hub.hero_league_top") %></small>
                    <% elsif screen.league.rival_name && screen.league.rival_gap %>
                      <small><%= t("hub.hero_league_rival", gap: screen.league.rival_gap, name: screen.league.rival_name) %></small>
                    <% end %>
                  </span>
                  <%= picto("arrow") %>
                <% end %>
                <% if screen.league.recent_gains.present? %>
                  <ol class="hub-hero-gains" aria-label="<%= t("hub.hero_recent_gains") %>">
                    <% screen.league.recent_gains.each do |gain| %>
                      <li>
                        <span class="hub-hero-gain__avatar" aria-hidden="true"><%= gain.name.to_s.first %></span>
                        <span><strong><%= gain.name %></strong> <%= t("hub.hero_gained", points: gain.points) %></span>
                        <time datetime="<%= gain.at.iso8601 %>"><%= l(gain.at, format: :short) %></time>
                      </li>
                    <% end %>
                  </ol>
                <% else %>
                  <p class="hub-hero-gains-empty"><%= t("hub.hero_gains_empty") %></p>
                <% end %>
              </div>
            <% end %>
            <% if hero.reward.to_i.positive? %>
              <span class="hub-reward">
                <% if reward_chest_src %>
                  <%= noche_media_picture(
                        reward_chest_src,
                        alt: "",
                        class_name: "hub-reward-chest"
                      ) %>
                <% else %>
                  <%= picto("chest") %>
                <% end %>
                <span class="hub-reward-copy">
                  <em class="hub-reward-label"><%= t("hub.reward") %></em>
                  <strong class="hub-reward-value">
                    <span>+<%= hero.reward %></span>
                    <%= picto("crown") %>
                  </strong>
                </span>
              </span>
            <% end %>
          </div>
        </div>
      </section>
    </div>
    <%= link_to street_map_path, class: "hub-hero-info", aria: { label: t("hub.info") } do %>
      <%= picto("info") %>
    <% end %>
  </div>
</article>
