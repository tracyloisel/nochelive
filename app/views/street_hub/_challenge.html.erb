<% challenge = local_assigns[:challenge] %>
<% social_ward = current_street_person&.ward %>
<% if !social_ward %>
  <article class="hub-panel hub-rail hub-challenge is-empty hub-challenge-empty is-ward-required">
    <div class="hub-challenge-empty-icon" aria-hidden="true">
      <%= picto("church") %>
    </div>
    <div class="hub-challenge-empty-body">
      <p class="hub-challenge-empty-title"><%= t("hub.social_ward_title") %></p>
      <p class="hub-challenge-empty-hint"><%= t("hub.challenge_pick_ward") %></p>
    </div>
    <%= link_to t("hub.pick_ward_action"), search_path(cambiar: 1), class: "hub-rail-go hub-challenge-empty-cta" %>
  </article>
<% elsif challenge&.path %>
  <% scored = challenge.scored? %>
  <% rival = challenge.other_display_name.presence || challenge.other_name %>
  <%= link_to challenge.path,
        class: "hub-panel hub-stack hub-challenge #{scored ? "is-scored" : "is-waiting"}",
        data: {
          controller: "hub-challenge",
          hub_challenge_target: "card",
          hub_challenge_you_score_value: challenge.you_score,
          hub_challenge_them_score_value: challenge.other_score
        },
        aria: { label: [ t("hub.challenge_now"), rival ].compact.join(" · ") } do %>
    <header class="hub-challenge-head">
      <p class="hub-kicker"><%= t("hub.challenge_now") %></p>
      <span class="hub-challenge-go" aria-hidden="true"></span>
    </header>
    <% if scored %>
      <div class="hub-challenge-who">
        <span class="hub-challenge-face is-gold" data-hub-challenge-target="themFace">
          <% if challenge.other_avatar_key && (src = avatar_mark(challenge.other_avatar_key)) %>
            <img src="<%= src %>" alt="" class="avatar-img" width="48" height="48">
          <% else %>
            <%= picto("sparkle") %>
          <% end %>
        </span>
        <div class="hub-challenge-who-copy">
          <p class="hub-challenge-name"><%= rival %></p>
          <% if challenge.other_streak.to_i >= 2 %>
            <p class="hub-challenge-sub"><%= t("hub.rival_streak", name: challenge.other_name, count: challenge.other_streak) %></p>
          <% else %>
            <p class="hub-challenge-sub"><%= t("hub.rival_finished", name: challenge.other_name) %></p>
          <% end %>
        </div>
      </div>
      <div class="hub-challenge-score">
        <span class="hub-challenge-pts is-you" data-hub-challenge-target="youScore"><%= challenge.you_score %></span>
        <div class="hub-challenge-bar" data-hub-challenge-target="bar" aria-hidden="true">
          <i class="is-you"></i>
          <i class="is-them"></i>
          <span class="hub-challenge-vs-chip"><%= t("street.duel_vs") %></span>
        </div>
        <span class="hub-challenge-pts is-them" data-hub-challenge-target="themScore"><%= challenge.other_score %></span>
      </div>
      <p class="hub-challenge-foot"><%= t("hub.finish_first") %></p>
    <% else %>
      <% if challenge.other_name.present? %>
        <p class="hub-challenge-name is-hero"><%= challenge.other_name %></p>
      <% end %>
      <div class="hub-challenge-capsule" aria-hidden="true">
        <span class="hub-challenge-face is-gold">
          <% if challenge.you_avatar_key && (src = avatar_mark(challenge.you_avatar_key)) %>
            <img src="<%= src %>" alt="" class="avatar-img" width="40" height="40">
          <% else %>
            <%= picto("sparkle") %>
          <% end %>
        </span>
        <span class="hub-challenge-vs-disc"><%= t("street.duel_vs") %></span>
        <span class="hub-challenge-face is-silver">
          <% if challenge.other_avatar_key && (src = avatar_mark(challenge.other_avatar_key)) %>
            <img src="<%= src %>" alt="" class="avatar-img" width="40" height="40">
          <% else %>
            <%= picto("sparkle") %>
          <% end %>
        </span>
      </div>
    <% end %>
  <% end %>
<% else %>
  <article class="hub-panel hub-rail hub-challenge is-empty hub-challenge-empty">
    <div class="hub-challenge-empty-icon" aria-hidden="true">
      <%= picto("trophy") %>
    </div>
    <div class="hub-challenge-empty-body">
      <p class="hub-challenge-empty-title"><%= t("hub.challenge_empty") %></p>
      <p class="hub-challenge-empty-hint"><%= t("hub.challenge_empty_hint") %></p>
    </div>
    <%= link_to t("hub.challenge_them"), street_challenges_path, class: "hub-rail-go hub-challenge-empty-cta" %>
  </article>
<% end %>
