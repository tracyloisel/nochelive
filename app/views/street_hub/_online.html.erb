<% rows = Array(local_assigns[:rows]) %>
<% count = local_assigns.fetch(:count, rows.size).to_i %>
<% social_ward = current_street_person&.ward %>
<article class="hub-panel hub-stack hub-online<%= " is-empty" if rows.empty? %>"
         data-controller="hub-online">
  <header class="hub-online-head">
    <p class="hub-kicker"><%= t("hub.online") %></p>
    <span class="hub-online-count"><%= t("hub.online_count", count: count) %></span>
  </header>
  <% if !social_ward %>
    <div class="hub-online-ward-required">
      <p class="hub-online-empty"><%= t("hub.online_pick_ward") %></p>
      <%= link_to t("hub.pick_ward_action"), search_path(cambiar: 1), class: "hub-online-ranking" %>
    </div>
  <% elsif rows.any? %>
    <ul class="hub-online-list">
      <% rows.each do |row| %>
        <li class="hub-online-row">
          <% src = avatar_mark(row.avatar_key) %>
          <span class="hub-online-face">
            <% if src %>
              <img src="<%= src %>" alt="" class="avatar-img" width="52" height="52">
            <% else %>
              <span class="avatar-fallback" aria-hidden="true"><%= row.name.to_s.first %></span>
            <% end %>
          </span>
          <div class="hub-online-meta">
            <span class="hub-online-name-line">
              <span class="hub-online-name"><%= row.name %></span>
              <span class="hub-online-presence"><%= street_live_dot(true) %></span>
            </span>
            <span class="hub-online-stats"
                  aria-label="<%= t("hub.online_meta", count: row.crowns, crowns: row.crowns) %>">
              <span aria-hidden="true"><%= number_with_delimiter(row.crowns) %></span>
              <span aria-hidden="true"><%= picto("crown") %></span>
            </span>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="hub-online-empty"><%= t("hub.online_empty") %></p>
  <% end %>
  <% if social_ward %>
    <%= link_to street_leaderboard_path,
          class: [ "hub-online-ranking", ("street-league" if current_street_person) ].compact.join(" ") do %>
      <span class="street-league-all"><%= t("hub.see_ranking") %></span>
      <%= picto("podium") %>
    <% end %>
  <% end %>
</article>
