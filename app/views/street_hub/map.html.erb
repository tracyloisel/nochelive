<% surface_stylesheet("pages/street_map") %>
<% content_for :title, t("street.mapa_title") %>
<% content_for :body_class, "is-kid is-street-hub is-street-map-page" %>
<% page_hud(
     hud: true,
     bar: Huds::Present.from_screen(screen: @screen, rank_up: params[:rank_up].present?)
   ) { site_menu } %>
<% page_dock(active: :adventure) %>

<% packs = @world.packs %>
<% finished = packs.count { |p| p.state == :finished } %>
<% total_packs = packs.size %>
<% questions_per_pack = QuizDefinition::QUESTIONS_PER_PACK %>
<% total_rewards = total_packs / 10 %>
<% play_pack_id = @open_run&.pack_id.presence || @world.current_pack_id %>
<% play_pack = packs.find { |pack| pack.id == play_pack_id } || packs.first %>
<% play_pack_number = play_pack ? play_pack.index + 1 : 1 %>
<% play_step_line = if @open_run.present? && play_pack && @open_run.pack_id == play_pack.id
  t("street.pack_here", n: play_pack_number, q: @open_run.position, total: play_pack.pack.questions.size)
else
  t("street.pack_step", n: play_pack_number)
end %>
<% progress_percent = total_packs.positive? ? (finished.to_f / total_packs * 100).round : 0 %>
<% active_category = play_pack&.category || "rois" %>

<section id="street_world"
         class="street-world street-map-page"
         data-controller="street-share hub-map"
         data-street-share-copied-value="<%= t("street.share_copied") %>"
         data-hub-map-category-value="<%= @world.current_pack_id ? Quizzes::World.category_for(@world.current_pack_id) : "all" %>"
         data-hub-map-current-pack-id-value="<%= @world.current_pack_id %>"
         data-hub-map-finished-count-value="<%= finished %>"
         data-hub-map-total-packs-value="<%= total_packs %>"
         <% if params[:rank_up].present? %>
         data-stage-sfx-value="level_up"
         data-stage-sfx-token-value="map:rank_up:<%= current_street_person&.id || "guest" %>"
         data-stage-fx-value="level"
         <% end %>
         style="view-transition-name: street-world">

  <header class="mapa-header">
    <div class="mapa-heading">
      <span class="mapa-heading-mark" aria-hidden="true"><%= picto("compass") %></span>
      <div>
        <h1 class="mapa-title"><%= t("street.mapa_title") %></h1>
        <p class="mapa-subtitle"><%= t("street.mapa_subtitle", total: total_packs, q: questions_per_pack) %></p>
      </div>
    </div>

    <nav class="mapa-mode-tabs" aria-label="<%= t("street.mapa_modes_label") %>">
      <%= link_to street_map_path(view: "journey"), class: "mapa-mode-tab#{" is-active" if @map_view == :journey}", aria: { current: (@map_view == :journey ? "page" : nil) } do %>
        <%= picto("mapa-crown") %>
        <span><strong><%= t("street.mapa_journey") %></strong><small><%= t("street.mapa_journey_hint", count: total_packs) %></small></span>
      <% end %>
      <%= link_to street_map_path(view: "expeditions", expedition: @selected_expedition&.study_unit_id), class: "mapa-mode-tab#{" is-active" if @map_view == :expeditions}", aria: { current: (@map_view == :expeditions ? "page" : nil) } do %>
        <%= picto("compass") %>
        <span><strong><%= t("street.mapa_expeditions") %></strong><small><%= t("street.mapa_expeditions_hint", count: @expeditions.size) %></small></span>
      <% end %>
    </nav>

    <% if @map_view == :journey && play_pack %>
      <article class="mapa-mission" aria-labelledby="mapa_mission_title">
        <span class="mapa-mission-medallion" aria-hidden="true">
          <%= picto("mapa-crown") %>
          <strong><%= play_pack_number %></strong>
        </span>

        <div class="mapa-mission-copy">
          <p class="mapa-mission-kicker"><%= play_pack.pack.copy(:kicker) %></p>
          <h2 id="mapa_mission_title"><%= play_pack.pack.copy(:title) %></h2>
          <p class="mapa-mission-step"><%= play_step_line %></p>
        </div>

        <% continue_inner = capture do %>
          <span><%= t("hub.continue") %></span>
          <%= picto("arrow") %>
        <% end %>
        <% if @open_run.present? && @open_run.pack_id == play_pack.id %>
          <%= link_to jugar_path, class: "mapa-continue", data: { turbo: false } do %>
            <%= continue_inner %>
          <% end %>
        <% else %>
          <%= button_to street_pack_start_path(play_pack.id),
                class: "mapa-continue",
                form: { class: "mapa-continue-form", data: { turbo: false } } do %>
            <%= continue_inner %>
          <% end %>
        <% end %>

        <div class="mapa-mission-progress"
             role="progressbar"
             aria-label="<%= t("street.mapa_progress_label", finished: finished, total: total_packs) %>"
             aria-valuenow="<%= finished %>"
             aria-valuemin="0"
             aria-valuemax="<%= total_packs %>">
          <span class="mapa-mission-rail" aria-hidden="true"><i style="width: <%= progress_percent %>%"></i></span>
          <span class="mapa-mission-progress-copy"><strong><%= finished %></strong>/<%= total_packs %> <%= t("street.stat_completed") %></span>
        </div>

        <div class="mapa-mission-rewards">
          <%= picto("mapa-chest") %>
          <span><strong><%= total_rewards %></strong> <%= t("street.stat_rewards") %></span>
        </div>
      </article>
    <% end %>
  </header>

  <% if @map_view == :journey %>
  <nav class="mapa-tabs" role="tablist">
    <button class="mapa-tab<%= " is-active" if active_category == "rois" %>"
            data-category="rois" data-action="hub-map#filter" role="tab" aria-selected="<%= active_category == "rois" %>">
      <span class="mapa-tab-icon"><%= picto("mapa-crown") %></span>
      <span class="mapa-tab-label"><%= t("street.category_rois") %></span>
    </button>
    <button class="mapa-tab<%= " is-active" if active_category == "prophetes" %>"
            data-category="prophetes" data-action="hub-map#filter" role="tab" aria-selected="<%= active_category == "prophetes" %>">
      <span class="mapa-tab-icon"><%= picto("mapa-key") %></span>
      <span class="mapa-tab-label"><%= t("street.category_prophetes") %></span>
    </button>
    <button class="mapa-tab<%= " is-active" if active_category == "sagesse" %>"
            data-category="sagesse" data-action="hub-map#filter" role="tab" aria-selected="<%= active_category == "sagesse" %>">
      <span class="mapa-tab-icon"><%= picto("mapa-tree") %></span>
      <span class="mapa-tab-label"><%= t("street.category_sagesse") %></span>
    </button>
    <button class="mapa-tab<%= " is-active" if active_category == "heros" %>"
            data-category="heros" data-action="hub-map#filter" role="tab" aria-selected="<%= active_category == "heros" %>">
      <span class="mapa-tab-icon"><%= picto("mapa-shield-cross") %></span>
      <span class="mapa-tab-label"><%= t("street.category_heros") %></span>
    </button>
  </nav>

  <div class="mapa-progression">
    <% Quizzes::World::TIER_BOUNDARIES.each do |tier_def| %>
      <% tier_packs = packs.select { |p| Quizzes::World.tier_for(p.index)&.fetch(:key) == tier_def[:key] } %>
      <% next if tier_packs.empty? && !tier_def[:collapsed] %>
      <% collapsed = tier_def[:collapsed] %>
      <% tier_label_key = Quizzes::World.tier_label_key(tier_def[:key]) %>
      <% flag_icon = case tier_def[:key]
        when "debutant" then "flag-green"
        when "apprenti" then "flag-blue"
        when "disciple" then "flag-purple"
        when "maitre" then "flag-orange"
        when "legende" then "flag-red"
        end %>
      <%= render "street_hub/map_tier",
            tier: tier_def,
            packs: tier_packs,
            collapsed: collapsed,
            category: active_category,
            unlock_pack_id: @unlock_pack_id,
            flag_icon: flag_icon,
            tier_label_key: tier_label_key %>
    <% end %>
  </div>

  <footer class="mapa-footer">
    <div class="mapa-progress">
      <div class="mapa-progress-bar">
        <div class="mapa-progress-fill" style="width: <%= progress_percent %>%"></div>
      </div>
      <span class="mapa-progress-label"><%= t("street.mapa_progress_label", finished: finished, total: total_packs) %></span>
    </div>
    <%= link_to street_leaderboard_path, class: "mapa-footer-cta" do %>
      <span class="mapa-cta-icon"><%= picto("mapa-trophy") %></span>
      <span class="mapa-cta-label"><%= t("street.mapa_view_leaderboard") %></span>
      <span class="mapa-cta-arrow">&#8250;</span>
    <% end %>
  </footer>
  <% else %>
    <%= render "street_hub/expedition_map", expedition: @selected_expedition, expeditions: @expeditions %>
  <% end %>
</section>
