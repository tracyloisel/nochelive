<% screen = local_assigns[:screen] %>
<% person = local_assigns[:person] %>
<% people = local_assigns[:people] || [] %>
<% not_me_path = local_assigns.fetch(:not_me_path) { root_path(ficha: 1, not_me: 1) } %>
<% someone_else_path = local_assigns.fetch(:someone_else_path) { root_path(ficha: 1, fresh: 1) } %>

<% case screen %>
<% when :welcome %>
  <div class="street-quien-ficha">
    <div class="team-pick person-pick is-here">
      <%= render "people/card", person: person, show_year: false %>
    </div>
  </div>
  <h1 id="profile-gate-title"><%= t("join.welcome_title") %></h1>
  <p class="street-quien-rule" aria-hidden="true"></p>
  <p class="lede"><%= t("street.welcome_lede", name: person.given_name) %></p>
  <%= render "street_profiles/ward_switch" %>
  <%= button_to street_profile_path, params: { person_id: person.id }, class: "btn btn-gold" do %>
    <%= picto("check") %><%= t("join.yes_name", name: person.given_name) %>
  <% end %>
  <%= link_to not_me_path, class: "btn btn-ghost" do %>
    <%= picto("person") %><%= t("join.not_me") %>
  <% end %>
<% when :device %>
  <h1 id="profile-gate-title"><%= t("join.device_title") %></h1>
  <p class="lede"><%= t("join.device_lede") %></p>
  <%= render "street_profiles/ward_switch" %>
  <ul class="team-list person-list profile-gate-people">
    <% people.each do |row| %>
      <li>
        <%= button_to street_profile_path, params: { person_id: row.id }, class: "team-pick person-pick is-here" do %>
          <%= render "people/card", person: row, show_year: false %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= link_to someone_else_path, class: "btn btn-ghost" do %>
    <%= picto("plus") %><%= t("join.none_of_these") %>
  <% end %>
<% else %>
  <h1 id="profile-gate-title"><%= t("street.create_title") %></h1>
  <p class="lede"><%= t("street.create_lede") %></p>
  <%= render "street_profiles/ward_switch" %>
  <%= form_with url: street_profile_path, method: :post, class: "join-form profile-gate-new" do %>
    <label for="gate_name"><%= t("street.create_who") %></label>
    <input id="gate_name" name="name" maxlength="24" required autocomplete="given-name" class="code-input" placeholder="Pili">
    <fieldset class="emblem-pick avatar-pick profile-gate-avatars">
      <legend><%= t("street.create_animal") %></legend>
      <% Player::AVATARS.each do |key| %>
        <label class="emblem-choice avatar-choice">
          <input type="radio" name="avatar_key" value="<%= key %>" <%= "checked" if key == "delfin" %>>
          <% src = avatar_mark(key) %>
          <% if src %>
            <span class="avatar-seal" aria-hidden="true">
              <img src="<%= src %>" alt="" class="avatar-img avatar-img-lg">
            </span>
          <% end %>
          <em><%= avatar_name(key) %></em>
        </label>
      <% end %>
    </fieldset>
    <%= render "shared/year_field", required: true %>
    <button type="submit" class="btn btn-gold"><%= picto("plus") %><%= t("street.gate_create") %></button>
  <% end %>
<% end %>

<%= button_to street_profile_path, params: { guest: 1 }, class: "quiet-link" do %>
  <%= t("street.continue_guest") %>
<% end %>
<% if current_street_person && screen != :welcome %>
  <%= link_to t("street.stay_as", name: current_street_person.given_name), root_path, class: "quiet-link" %>
<% end %>
