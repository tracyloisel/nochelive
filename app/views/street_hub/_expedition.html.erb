<% expedition = local_assigns.fetch(:expedition) %>
<% artwork = expedition.artwork.to_s.delete_prefix("/") %>

<section class="hub-expedition" aria-labelledby="hub-expedition-title">
  <span class="hub-expedition__art" aria-hidden="true">
    <%= noche_media_picture(artwork, alt: "", loading: "lazy") if artwork.present? %>
  </span>
  <span class="hub-expedition__veil" aria-hidden="true"></span>
  <div class="hub-expedition__copy">
    <p><%= t("hub.expedition.kicker") %></p>
    <h2 id="hub-expedition-title"><%= expedition.title %></h2>
    <% if expedition.subtitle.present? %><strong><%= expedition.subtitle %></strong><% end %>
    <span><%= expedition.promise %></span>
    <div class="hub-expedition__progress">
      <span><i style="--hub-expedition-progress:<%= expedition.progress_percent %>%"></i></span>
      <b><%= t("hub.expedition.progress", done: expedition.completed_count, total: expedition.total_count) %></b>
    </div>
    <ol aria-label="<%= t("hub.expedition.doors") %>">
      <% expedition.packs.each do |pack| %>
        <li class="is-<%= pack.state %>"><span><%= pack.title %></span><% if pack.state == :finished %><b>✓</b><% end %></li>
      <% end %>
    </ol>
    <%= link_to street_map_path(view: "expeditions", expedition: expedition.study_unit_id), class: "hub-expedition__cta" do %>
      <%= t("hub.expedition.open") %><%= picto("arrow") %>
    <% end %>
  </div>
</section>
