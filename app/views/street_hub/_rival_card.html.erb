<% rival = local_assigns[:rival] %>
<% compact = local_assigns.fetch(:compact, true) %>

<article class="street-card is-rival<%= " is-compact" if compact %>">
  <% src = avatar_mark(rival.person) %>
  <% if src %><img src="<%= src %>" alt="" class="avatar-img" width="<%= compact ? 28 : 36 %>" height="<%= compact ? 28 : 36 %>"><% end %>
  <div class="street-rival-body">
    <span class="street-rival-name"><%= rival.person.given_name %></span>
    <span class="street-rival-meta">#<%= rival.rank %> · <%= rival.score %></span>
    <% if rival.gap.positive? %>
      <span class="street-rival-gap"><%= t("street.rival_gap", points: rival.gap) %></span>
    <% end %>
  </div>
</article>
