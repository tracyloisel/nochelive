<% content_for :title, "Noche Live" %>
<% content_for :body_class, "is-kid is-street-hub" %>
<%= chrome_menu { site_menu } %>

<section id="street_world"
         class="street-world<%= " is-profile-gate" if @profile_gate %>"
         data-controller="street-hub street-share"
         data-street-share-copied-value="<%= t("street.share_copied") %>"
         data-street-hub-current-pack-value="<%= @world.current_pack_id %>"
         <% if params[:rank_up].present? %>
         data-stage-sfx-value="level_up"
         data-stage-sfx-token-value="hub:rank_up:<%= current_street_person&.id || "guest" %>"
         data-stage-fx-value="level"
         <% end %>
         style="view-transition-name: street-world">
  <%= render "street_hub/profile_wizard",
        profile_gate: @profile_gate,
        gate_ward: @gate_ward,
        gate_screen: @gate_screen,
        gate_person: @gate_person,
        gate_people: @gate_people,
        featured_ward: @featured_ward %>

  <% if @pending_duel %>
    <%= render "street_hub/duel_banner", duel: @pending_duel %>
  <% end %>

  <header class="street-hub-brand">
    <div class="street-hub-lockup">
      <div class="street-hub-lockup-wordmark">
        <span class="street-hub-lockup-star" aria-hidden="true"><%= picto("star8") %></span>
        <p class="street-hub-lockup-name">Noche Live</p>
      </div>
    </div>
  </header>

    <%= render "street_hub/player_card",
          person: current_street_person,
          standings: @standings,
          streak: @streak,
          rank_up: params[:rank_up].present? %>

  <%= render "street_hub/map_path", world: @world, unlock_pack_id: @unlock_pack_id %>

  <% if @standings %>
    <%= render "street_hub/league_strip", board: @standings.total_board, rank_title: @standings.rank_title %>
  <% end %>

  <%= render "street_hub/friend_rail", rival: @rival, standings: @standings %>

  <footer class="street-world-dock">
    <div class="street-world-dock-cta">
      <% if @open_run %>
        <%= link_to jugar_path, class: "btn btn-gold street-play-cta" do %>
          <span class="street-cta-star" aria-hidden="true"><%= picto("star8") %></span>
          <span class="street-cta-label"><%= t("street.world_continue") %></span>
          <span class="street-cta-star" aria-hidden="true"><%= picto("star8") %></span>
        <% end %>
      <% elsif @world.current_pack_id %>
        <%= button_to street_pack_start_path(@world.current_pack_id),
              class: "btn btn-gold street-play-cta",
              form: { data: { turbo: false } } do %>
          <span class="street-cta-star" aria-hidden="true"><%= picto("star8") %></span>
          <span class="street-cta-label"><%= t("street.world_play") %></span>
          <span class="street-cta-star" aria-hidden="true"><%= picto("star8") %></span>
        <% end %>
      <% end %>
    </div>
  </footer>
</section>
