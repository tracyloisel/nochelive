<% content_for :title, "Noche Live" %>
<% screen = @screen %>
<% art = screen.backdrop %>
<% art_src = media_src(art.src) || art.src %>
<% hero_lcp = art.hero.presence || screen.hero.still %>
<% content_for :body_class, "is-kid is-street-hub is-game-hub-page is-celestial-#{art.theme.mode}" %>
<% content_for :head do %>
  <%= noche_picture_preload(hero_lcp) || tag.link(rel: "preload", as: "image", href: hero_lcp, fetchpriority: "high") %>
<% end %>
<% declare_frontend_resources(
     context: "hub.home",
     # The Home no longer renders the historical study tile. Keeping that
     # surface here let its legacy tile rules restyle the cinematic hero after
     # the Hub stylesheet had loaded.
     styles: %w[shell hub],
     controllers: %w[loading press chrome-menu hub-scroll hub-voyage hub-portal presence],
     media: { lcp: hero_lcp },
     audio: { unlock: true, cues: %w[celestial_breath chest level_up], bed: nil },
     motion: %w[list-enter],
     prefetch: { nextScreen: true, maxBytes: 180_000 },
     classes: {
       "style.shell" => "critical",
       "style.hub" => "critical",
       "media.lcp" => "critical",
       "controller.hub" => "contextual",
       "audio.hub" => "interaction",
       "screen.next" => "predictive"
     }
   ) %>
<section id="street_world"
         class="street-world is-game-hub"
         data-controller="street-share hub-scroll"
         data-street-share-copied-value="<%= t("street.share_copied") %>"
         data-hub-theme="<%= art.theme.mode %>"
         data-hub-atmosphere="<%= art.theme.atmosphere %>"
         data-hub-accent="<%= art.theme.accent %>"
         <% if params[:rank_up].present? %>
         data-stage-sfx-value="level_up"
         data-stage-sfx-token-value="hub:rank_up:<%= current_street_person&.id || "guest" %>"
         data-stage-fx-value="level"
         <% end %>
         style="--hub-art: url('<%= art_src %>'); view-transition-name: street-world">
  <%= noche_picture(
        art.media_key,
        role: :hub_backdrop,
        alt: "",
        class_name: "street-world-art",
        loading: "lazy",
        fetchpriority: "low",
        data: { hub_background: true }
      ) %>
  <% page_hud(
        hud: true,
        bar: Huds::Present.from_screen(screen: screen, rank_up: params[:rank_up].present?)
      ) { site_menu(player: screen.player) } %>
  <% content_for :hud do %>
    <%= render "street_hub/desktop_navigation" %>
  <% end %>

  <div class="street-hub-feed hub-streaming-feed hub-streaming-feed--editorial"
       data-hub-layout="hero-rama-carousel">
    <%= render "street_hub/hero", screen: screen, theme: art.theme.mode %>
    <%= render "street_hub/rama_carousel", live: screen.live, events: screen.rama_events, circle: screen.circle, duel_summary: @duel_summary %>
    <%= render "street_hub/install" %>
    <%= render "street_hub/identity_empty", state: @hub_identity_state if @hub_identity_state %>
    <%= render "street_hub/now_cards", cards: @now_cards, study: screen.study unless screen.player.guest %>
    <%= render("notifications/prompt", person: current_street_person, **@push_prompt) if @push_prompt %>
  </div>

  <% page_dock(active: :home) %>
</section>
