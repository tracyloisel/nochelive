<% invitations = local_assigns[:invitations] %>
<% person = current_street_person %>
<% if person %>
  <article class="hub-panel hub-invitations<%= " is-empty" unless invitations&.any? %>">
    <header class="hub-invitations-head">
      <span class="hub-invitations-seal" aria-hidden="true">
        <img src="/media/social/icon-share-medallion-v1.png" alt="" width="52" height="52">
      </span>
      <div>
        <p class="hub-kicker"><%= t("hub.invitations_title") %></p>
        <p class="hub-invitations-summary">
          <% if invitations&.any? %>
            <%= t("hub.invitations_summary", count: invitations.total, joined: invitations.joined) %>
          <% else %>
            <%= t("hub.invitations_empty") %>
          <% end %>
        </p>
      </div>
    </header>

    <% if invitations&.any? %>
      <ul class="hub-invitations-list">
        <% invitations.items.each do |invitation| %>
          <li class="hub-invitation-row is-<%= invitation.state %>">
            <span class="hub-invitation-state" aria-hidden="true"><%= picto(invitation.state == :completed ? "crown" : invitation.state == :playing ? "fire" : "send") %></span>
            <span class="hub-invitation-copy">
              <strong><%= invitation.friend_name.presence || t("hub.invitation_friend") %></strong>
              <small><%= t("hub.invitation_state_#{invitation.state}", pack: invitation.pack_title) %></small>
            </span>
            <% if %i[sent opened].include?(invitation.state) %>
              <button type="button"
                      class="hub-invitation-remind"
                      data-controller="street-share"
                      data-action="street-share#share"
                      data-street-share-url-value="<%= street_challenge_url(invitation.token, src: "reminder") %>"
                      data-street-share-title-value="Noche Live"
                      data-street-share-text-value="<%= t("hub.invitation_reminder_text", name: person.given_name, score: invitation.score) %>"
                      data-street-share-duel-token-value="<%= invitation.token %>"
                      data-street-share-source-value="hub_reminder"
                      data-street-share-copied-value="<%= t("street.share_copied") %>">
                <%= t("hub.invitation_remind") %>
              </button>
            <% else %>
              <%= link_to t("hub.invitation_open"), invitation.url, class: "hub-invitation-open" %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= link_to street_challenges_path, class: "hub-invitations-all" do %>
        <span><%= t("hub.invitations_all") %></span><%= picto("arrow") %>
      <% end %>
    <% else %>
      <%= link_to street_challenges_path, class: "btn btn-navy hub-invitations-start" do %>
        <%= picto("send") %><%= t("hub.invitations_start") %>
      <% end %>
    <% end %>
  </article>
<% end %>
