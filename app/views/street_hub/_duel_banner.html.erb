<% duel = local_assigns[:duel] %>
<% challenge = local_assigns[:challenge] %>
<% pack = QuizDefinition.catalog.find_pack(duel.pack_id) %>
<% challenger = duel.challenger_person %>
<% viewer = local_assigns[:viewer] || current_street_person %>
<% csrf = local_assigns.fetch(:csrf, true) %>
<% other = viewer&.id == challenger.id ? duel.opponent_person : challenger %>
<% phase = challenge&.phase || :accept %>
<% share_text = t("street.duel_share_text", name: challenger.display_name, pack: pack.copy(:title)) %>
<% lede = case phase
     when :waiting
       if challenge&.waiting_for == :play && other
         t("street.duel_playing_named", name: other.display_name)
       elsif challenge&.waiting_for == :accept && other
         t("street.duel_waiting_named_short", name: other.display_name)
       elsif challenge&.waiting_for == :link
         t("street.duel_waiting_link")
       elsif challenge&.role == :challenger
         t("street.duel_you_sent", pack: pack.copy(:title))
       else
         t("street.duel_waiting_link")
       end
     when :play
       t("street.duel_challenge", name: challenger.display_name, pack: pack.copy(:title))
     else
       if duel.challenger_score
         t("street.duel_beat_score", name: challenger.display_name, score: duel.challenger_score)
       else
         t("street.duel_challenge", name: challenger.display_name, pack: pack.copy(:title))
       end
     end %>

<aside class="street-card is-hub-tile street-duel-banner" role="status">
  <div class="street-hub-tile-faces" aria-hidden="true">
    <span class="street-duel-face is-you">
      <% if viewer %>
        <% src = avatar_mark(viewer) %>
        <% if src %><img src="<%= src %>" alt="" class="avatar-img" width="36" height="36"><% end %>
      <% else %>
        <span class="street-duel-face-slot"><%= picto("sparkle") %></span>
      <% end %>
    </span>
    <span class="street-duel-vs-mark"><%= t("street.duel_vs") %></span>
    <span class="street-duel-face">
      <% if other %>
        <% src = avatar_mark(other) %>
        <% if src %><img src="<%= src %>" alt="" class="avatar-img" width="36" height="36"><% end %>
      <% else %>
        <span class="street-duel-face-slot"><%= picto("sparkle") %></span>
      <% end %>
    </span>
  </div>
  <div class="street-hub-tile-meta">
    <p class="street-hub-tile-kicker"><%= t("street.duel_title") %></p>
    <p class="street-duel-banner-lede street-hub-tile-title"><%= lede %></p>
  </div>
  <div class="street-hub-tile-action">
    <% case phase %>
    <% when :waiting %>
      <% if challenge&.waiting_for == :link %>
        <button type="button"
                class="street-hub-tile-go street-duel-accept"
                data-action="street-share#invite"
                data-street-share-url-value="<%= street_challenge_url(duel.token) %>"
                data-street-share-text-value="<%= share_text %>">
          <%= t("street.duel_share_again") %>
        </button>
      <% else %>
        <%= link_to t("street.duel_inbox_open"), street_challenges_path, class: "street-hub-tile-go quiet-link" %>
      <% end %>
    <% when :play %>
      <%= link_to t("street.duel_play"), jugar_path, class: "street-hub-tile-go street-duel-accept" %>
    <% else %>
      <% if viewer || current_ward.blank? %>
        <%= button_to street_challenge_accept_path(duel.token),
              class: "street-hub-tile-go street-duel-accept",
              authenticity_token: csrf,
              form: { class: "street-hub-tile-form" } do %>
          <%= t("street.duel_accept") %>
        <% end %>
        <% if viewer && duel.opponent_person_id == viewer.id %>
          <%= button_to street_challenge_decline_path(duel.token),
                class: "quiet-link street-duel-decline",
                authenticity_token: csrf,
                form: { class: "street-hub-tile-form" } do %>
            <%= t("street.duel_decline") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</aside>
