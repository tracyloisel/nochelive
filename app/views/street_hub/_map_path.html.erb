<% world = local_assigns[:world] %>
<% unlock_pack_id = local_assigns[:unlock_pack_id] %>
<% packs = world.packs %>
<% current_id = world.current_pack_id %>
<% first_finished_id = packs.find { |pack_view| pack_view.state == :finished }&.id %>
<% last_index = packs.size - 1 %>

<nav class="street-map-path is-rope" aria-label="<%= t("street.world_map") %>" data-street-hub-target="map">
  <div class="street-map-legend-pin">
    <aside class="street-map-legend">
      <h2 class="street-map-path-title"><%= t("street.world_map") %></h2>
    </aside>
  </div>
  <div class="street-map-track">
    <svg class="street-map-thread" aria-hidden="true" focusable="false">
      <path />
    </svg>
    <% packs.reverse.each_with_index do |pack_view, idx| %>
      <% role = if pack_view.id == current_id
           :current
         elsif pack_view.state == :finished
           :finished
         elsif pack_view.state == :locked
           :locked
         else
           pack_view.state
         end %>
      <%= render "street_hub/map_node",
            pack_view: pack_view,
            role: role,
            unlock_pack_id: unlock_pack_id,
            historial: pack_view.id == first_finished_id || (first_finished_id.blank? && pack_view.id == current_id) %>
      <% unless idx == last_index %>
        <span class="street-map-rope" aria-hidden="true"></span>
      <% end %>
    <% end %>
  </div>
</nav>
