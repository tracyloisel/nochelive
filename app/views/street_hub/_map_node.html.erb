<% pack_view = local_assigns[:pack_view] %>
<% unlock_pack_id = local_assigns[:unlock_pack_id] %>
<% historial = local_assigns[:historial] %>
<% role = local_assigns[:role] %>

<% role = :current if pack_view.id == @world.current_pack_id %>
<% role = :finished if pack_view.state == :finished %>
<% role = :locked if pack_view.state == :locked %>
<% unlocking = unlock_pack_id == pack_view.id && (role == :locked || pack_view.state == :locked) %>
<% pack_number = pack_view.index + 1 %>
<% has_coffret = (pack_number % 10).zero? %>

<article id="pack-<%= pack_view.id %>"
         class="mapa-node is-<%= role %><%= " is-unlocking" if unlocking %>"
         data-pack-id="<%= pack_view.id %>"
         data-category="<%= pack_view.category %>"
         data-hub-map-target="node"
         data-action="click->hub-map#tapNode keydown.enter->hub-map#tapNode keydown.space->hub-map#tapNode"
         <%= %(aria-current="step").html_safe if role == :current %>
         <%= %(tabindex="0" role="button" aria-label="#{j(t("street.mapa_locked_hint", pack: [pack_number - 1, 1].max))}").html_safe if role == :locked %>
         <%= %(data-controller="street-motion" data-street-motion-sequence-value="packUnlock").html_safe if unlocking %>>

  <% if role == :current %>
    <span class="mapa-node-beacon" aria-hidden="true"><%= picto("star4") %></span>
  <% end %>

  <div class="mapa-node-circle">
    <span class="mapa-node-number"><%= pack_number %></span>

    <% if role == :finished || pack_view.state == :finished %>
      <span class="mapa-node-check" aria-hidden="true"><%= picto("check") %></span>
    <% elsif role == :locked || pack_view.state == :locked %>
      <span class="mapa-node-lock" aria-hidden="true"><%= picto("lock") %></span>
    <% end %>
  </div>

  <div class="mapa-node-stars" aria-label="<%= t("street.card_stars", count: pack_view.stars) %>">
      <% 3.times do |i| %>
        <span class="mapa-star <%= "is-filled" if i < pack_view.stars %>"><%= picto("star") %></span>
      <% end %>
  </div>

  <% if has_coffret %>
    <span class="mapa-node-coffret" aria-hidden="true" data-coffret-index="<%= pack_number %>">
      <%= picto("mapa-chest") %>
    </span>
  <% end %>

  <% if role == :locked %>
    <span class="mapa-lock-hint" role="status"><%= t("street.mapa_locked_hint", pack: [pack_number - 1, 1].max) %></span>
  <% end %>

  <% if role != :locked %>
    <% path = pack_view.open_run_id ? jugar_path : street_pack_start_path(pack_view.id) %>
    <% if pack_view.open_run_id %>
      <%= link_to "", path, class: "mapa-node-hit", aria: { label: pack_view.pack.copy(:title) }, data: { turbo: false } %>
    <% else %>
      <%= button_to "", path, class: "mapa-node-hit", form: { data: { turbo: false } }, aria: { label: pack_view.pack.copy(:title) } %>
    <% end %>
  <% end %>
</article>
