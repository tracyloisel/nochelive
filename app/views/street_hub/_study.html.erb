<% study = local_assigns[:study] %>
<% if study %>
  <% light_theme = local_assigns[:theme].to_s == "light" %>
  <% week = study.week %>
  <% quiz = study.quiz %>
  <% artwork = light_theme ? "media/hub/light/study-refuge-v2.png" : quiz.content.fetch("artwork") %>
  <%= link_to study_program_path,
        class: "hub-study hub-light-tile--study",
        style: "--study-art: url('#{media_src(artwork)}')" do %>
    <div class="hub-study-copy">
      <p class="hub-kicker"><%= t("study.home_kicker") %></p>
      <h2><%= t("study.psalms_theme") %></h2>
      <p class="hub-study-refs"><%= week.display_scripture_refs.first %></p>
      <div class="hub-study-progress" aria-label="<%= t("study.progress", n: study.progress, total: 10) %>">
        <span><i style="width:<%= study.progress * 10 %>%"></i></span>
        <strong><%= study.progress %>/10</strong>
      </div>
      <p class="hub-study-community"><%= t("study.people_advancing", count: study.players) %></p>
    </div>
    <% if study.run %>
      <span class="btn btn-navy hub-study-action"><%= t("study.continue") %></span>
    <% else %>
      <span class="btn btn-navy hub-study-action"><%= t("study.discover") %></span>
    <% end %>
  <% end %>
<% end %>
