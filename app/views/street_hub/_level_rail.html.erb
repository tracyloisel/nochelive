<% position = local_assigns[:position] %>
<% total = local_assigns[:total] %>
<% run = local_assigns[:run] %>

<ol class="street-level-rail" aria-label="<%= t("street.level_rail", current: position, total: total) %>">
  <% (1..total).each do |n| %>
    <% state = if n < position
      "is-filled"
    elsif n == position && run.open?
      "is-current"
    elsif n == position && run.settled? && run.quiz_answers.find_by(question_id: run.pack.question_at(n).id)&.correct? == false
      "is-miss"
    elsif n == position
      "is-current"
    else
      ""
    end %>
    <li class="street-level-dot <%= state %>" data-position="<%= n %>">
      <span class="street-level-pip" aria-hidden="true"></span>
    </li>
  <% end %>
</ol>
