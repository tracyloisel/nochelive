<% community = local_assigns[:community] %>
<% pulse = local_assigns[:pulse] %>
<% stats = [
     [ "people", community.players_this_month, "hub.players_month", "hub.players_month_a", "hub.players_month_b" ],
     [ "chat", community.questions, "hub.questions_answered", "hub.questions_answered_a", "hub.questions_answered_b" ],
     [ "temple", community.wards, "hub.wards_join", "hub.wards_join_a", "hub.wards_join_b" ]
   ] %>
<%= link_to platform_stats_path,
      class: "hub-panel hub-community",
      aria: { label: t("stats.menu") },
      data: {
        controller: "hub-counter",
        hub_counter_target: "community",
        turbo_frame: "_top"
      } do %>
  <span class="hub-community-art" aria-hidden="true">
    <img src="/media/ui/community-celestial-gathering-v1.webp"
         alt=""
         width="1400"
         height="700"
         loading="lazy"
         decoding="async">
  </span>
  <span class="hub-community-glow" aria-hidden="true"></span>
  <header class="hub-community-head">
    <div class="hub-community-heading">
      <p class="hub-kicker"><%= t("hub.community") %></p>
      <% if pulse %>
        <%= turbo_stream_from :street_presence, I18n.locale %>
        <%= render "street_hub/pulse_frame", pulse: pulse %>
      <% end %>
    </div>
    <span class="hub-community-go" aria-hidden="true"></span>
  </header>
  <ul class="hub-community-stats">
    <% stats.each_with_index do |stat, index| %>
      <% icon, value, full_key, line_a, line_b = stat %>
      <li>
        <span class="hub-community-mark" aria-hidden="true">
          <img class="hub-community-mark-gold" src="/media/ui/community-<%= icon %>-gold.png" alt="" width="32" height="32">
          <img class="hub-community-mark-ink" src="/media/ui/community-<%= icon %>-ink.png" alt="" width="32" height="32">
        </span>
        <strong class="hub-community-n is-counter"
                data-target-value="<%= value %>"
                data-reveal-once="true"
                data-session-key="hub-community-<%= icon %>-revealed">
          <%= compact_number(value) %>
        </strong>
        <span class="hub-community-label" aria-label="<%= t(full_key) %>">
          <span><%= t(line_a) %></span>
          <span><%= t(line_b) %></span>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
