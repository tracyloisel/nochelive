<%= link_to church_videos_path(locale: I18n.locale),
      class: "hub-panel hub-videos",
      aria: { label: t("hub.videos_title") },
      data: { turbo_frame: "_top" } do %>
  <span class="hub-videos-art" aria-hidden="true">
    <img src="/media/church/videos/celestial-video-sanctuary-v1.webp"
         alt=""
         width="1672"
         height="941"
         loading="lazy"
         decoding="async">
  </span>
  <span class="hub-videos-scrim" aria-hidden="true"></span>
  <span class="hub-videos-copy">
    <span class="hub-videos-kicker"><%= picto("video-library") %><%= t("hub.videos_kicker") %></span>
    <strong><%= t("hub.videos_title") %></strong>
    <span><%= t("hub.videos_body") %></span>
  </span>
  <span class="hub-videos-go" aria-hidden="true"><%= picto("arrow") %></span>
<% end %>
