<% live = local_assigns[:live] %>
<% ward = local_assigns[:ward] %>
<% today = local_assigns[:today] %>
<% challenge = local_assigns[:challenge] %>
<% circle = local_assigns[:circle] %>
<% event_cards = Array(local_assigns[:events]) %>
<% event_cards = event_cards.reject do |event|
  today&.kind == :rama_event && today.source_id.present? && event.event_id == today.source_id
end %>

<% if ward.nil? %>
  <section class="hub-rama-presence hub-rama-presence--missing" aria-labelledby="hub-rama-title">
    <span class="hub-rama-presence__emblem" aria-hidden="true"><%= picto("people") %></span>
    <div>
      <p><%= t("hub.rama.find_kicker") %></p>
      <h2 id="hub-rama-title"><%= t("hub.rama.find_title") %></h2>
      <span><%= t("hub.rama.find_body") %></span>
    </div>
    <%= link_to live.ward_pick_path || live.program_path, class: "hub-rama-presence__action" do %>
      <%= t("hub.rama.find_action") %><%= picto("arrow") %>
    <% end %>
  </section>
<% else %>
  <% show_live = live.present? && live.state.in?([ :scheduled, :soon ]) && today&.kind != :live %>
  <% circle_has_news = circle&.activity&.present? %>
  <% reserved_slots = (show_live ? 1 : 0) + (challenge.present? ? 1 : 0) %>
  <% event_cards = event_cards.first([ 2, 3 - reserved_slots ].min.clamp(0, 2)) %>
  <% show_circle = circle_has_news && (reserved_slots + event_cards.size) < 3 %>
  <% has_presence = show_live || event_cards.any? || show_circle || challenge.present? %>
  <% if has_presence %>
    <section class="hub-rama-carousel hub-rama-presence" aria-labelledby="hub-rama-title">
      <header class="hub-content-rail__head">
        <h2 id="hub-rama-title"><%= t("hub.rama.title") %></h2>
      </header>

      <div class="hub-content-rail__track hub-rama-presence__track" role="list">
        <% if show_live %>
          <div class="hub-rama-card hub-rama-card--live" role="listitem">
            <%= render "street_hub/live", live: live %>
          </div>
        <% end %>

        <% if challenge.present? %>
          <% challenge_content = capture do %>
            <span class="hub-rama-event__art" aria-hidden="true"><%= noche_media_picture("media/social/campus-scriptures-celestial-dark-v1.png", alt: "", loading: "lazy") %></span>
            <span class="hub-rama-event__scrim" aria-hidden="true"></span>
            <span class="hub-rama-event__copy">
              <span class="hub-rama-event__kicker"><%= t(challenge.state == :incoming ? "hub.now.challenge_incoming" : "hub.now.challenge_active", name: challenge.title) %></span>
              <strong><%= challenge.pack_title.presence || t("hub.now.challenge_state.ready") %></strong>
              <% if challenge.state == :incoming %><span class="hub-rama-event__meta"><%= t("hub.now.challenge_due", time: duel_time_left(challenge.due_at)) %></span><% end %>
              <span class="hub-rama-event__action"><%= t(challenge.state == :incoming ? "hub.now.challenge_accept" : "hub.now.challenge_open") %><%= picto("arrow") %></span>
            </span>
          <% end %>
          <% if challenge.method == :post %>
            <%= button_to challenge.path, class: "hub-rama-card hub-rama-event hub-rama-event--challenge", form: { role: "listitem", class: "hub-rama-challenge-form" } do %><%= challenge_content %><% end %>
          <% else %>
            <%= link_to challenge.path, class: "hub-rama-card hub-rama-event hub-rama-event--challenge", role: "listitem" do %><%= challenge_content %><% end %>
          <% end %>
        <% end %>

        <% event_cards.each do |event| %>
          <% cancelled = event.state == :cancelled %>
          <% kicker = cancelled ? t("hub.rails.rama_cancelled_kicker") : t("hub.rails.event_kinds.#{event.kind}") %>
          <% meta = event.starts_at.present? ? l(event.starts_at, format: :short) : nil %>
          <% event_content = capture do %>
            <span class="hub-rama-event__art" aria-hidden="true">
              <% if event.still.present? %>
                <%= noche_media_picture(event.still, alt: "", loading: "lazy") %>
              <% else %>
                <%= noche_picture("hub.card.rama-vigil", role: :hub_card, alt: "", loading: "lazy") %>
              <% end %>
            </span>
            <span class="hub-rama-event__scrim" aria-hidden="true"></span>
            <span class="hub-rama-event__copy">
              <span class="hub-rama-event__kicker"><%= kicker %></span>
              <strong><%= event.title %></strong>
              <% if cancelled %>
                <span class="hub-rama-event__cancelled"><%= t("hub.rails.rama_cancelled") %></span>
                <% if event.cancellation_reason.present? %><span class="hub-rama-event__detail"><%= event.cancellation_reason %></span><% end %>
              <% else %>
                <% if meta.present? %><span class="hub-rama-event__meta"><%= meta %></span><% end %>
                <span class="hub-rama-event__action"><%= t("hub.rails.rama_open") %><%= picto("arrow") %></span>
              <% end %>
            </span>
          <% end %>
          <% if cancelled %>
            <article class="hub-rama-card hub-rama-event is-cancelled" role="listitem"><%= event_content %></article>
          <% else %>
            <%= link_to event.path,
                  class: "hub-rama-card hub-rama-event is-#{event.state}",
                  role: "listitem",
                  target: ("_blank" if event.external),
                  rel: ("noopener noreferrer" if event.external) do %>
              <%= event_content %>
            <% end %>
          <% end %>
        <% end %>

        <% if show_circle %>
          <%= link_to circle.path, class: "hub-rama-card hub-rama-event hub-rama-event--circle", role: "listitem" do %>
            <span class="hub-rama-event__art" aria-hidden="true">
              <%= noche_picture("hub.card.circle-study", role: :hub_card, alt: "", loading: "lazy") || noche_picture(circle.artwork, role: :hub_backdrop, alt: "", loading: "lazy") %>
            </span>
            <span class="hub-rama-event__scrim" aria-hidden="true"></span>
            <span class="hub-rama-event__copy">
              <span class="hub-rama-event__kicker"><%= t("hub.rama.circle_news_kicker") %></span>
              <strong><%= t("scripture_circle.hub_link") %></strong>
              <span class="hub-rama-circle-freshness"><%= t("hub.rama.circle_last_activity", time: l(circle.activity.last_at, format: :short)) %></span>
              <span class="hub-rama-event__action"><%= t("hub.rama.circle_action") %><%= picto("arrow") %></span>
            </span>
          <% end %>
        <% end %>

      </div>
    </section>
  <% end %>
<% end %>
