<% live = local_assigns[:live] %>
<% event_cards = Array(local_assigns[:events]).first(2) %>
<% circle = local_assigns[:circle] %>

<section class="hub-rama-carousel hub-rama-block" aria-labelledby="hub-rama-title">
  <header class="hub-rama-carousel__head hub-rama-block__head">
    <h2 id="hub-rama-title"><%= picto("people") %><%= t("hub.rama.title") %></h2>
  </header>

  <div class="hub-rama-carousel__track hub-rama-block__events" role="list">
    <div class="hub-rama-card hub-rama-card--live" role="listitem">
      <%= render "street_hub/live", live: live %>
    </div>

    <% event_cards.each do |event| %>
      <% cancelled = event.state == :cancelled %>
      <% service_event = %i[clothing_drive toy_drive books_and_school_supplies_drive food_drive].include?(event.kind) %>
      <% event_art = service_event ? "hub.card.service-bread" : "hub.card.rama-vigil" %>
      <% kicker = cancelled ? t("hub.rails.rama_cancelled_kicker") : t("hub.rails.event_kinds.#{event.kind}") %>
      <% meta = if event.starts_at.blank?
        nil
      elsif event.location_label.present?
        t("hub.rails.rama_meta", date: l(event.starts_at, format: :short), location: event.location_label)
      else
        l(event.starts_at, format: :short)
      end %>
      <% action = cancelled ? nil : t("hub.rails.rama_open") %>
      <% label = if cancelled
        t("hub.rails.rama_cancelled_card_label", title: event.title, reason: event.cancellation_reason)
      else
        t("hub.rails.rama_card_label", title: event.title, action: action)
      end %>
      <% event_content = capture do %>
        <span class="hub-rama-event__art" aria-hidden="true">
          <%= noche_picture(event_art, role: :hub_card, alt: "", loading: "lazy") || noche_media_picture(event.still, alt: "", loading: "lazy") %>
        </span>
        <span class="hub-rama-event__scrim" aria-hidden="true"></span>
        <span class="hub-rama-event__copy">
          <span class="hub-rama-event__kicker"><%= kicker %></span>
          <strong><%= event.title %></strong>
          <% if cancelled %>
            <span class="hub-rama-event__cancelled"><%= picto("cross") %><%= t("hub.rails.rama_cancelled") %></span>
            <% if event.cancellation_reason.present? %>
              <span class="hub-rama-event__detail"><%= t("hub.rails.rama_cancelled_reason", reason: event.cancellation_reason) %></span>
            <% end %>
          <% else %>
            <% if event.summary.present? %><span class="hub-rama-event__detail"><%= event.summary %></span><% end %>
            <% if meta.present? %><span class="hub-rama-event__meta"><%= meta %></span><% end %>
            <span class="hub-rama-event__action"><%= action %><%= picto("arrow") %></span>
          <% end %>
        </span>
      <% end %>
      <% if cancelled %>
        <article class="hub-rama-card hub-rama-card--event hub-rama-event is-cancelled"
                 role="listitem"
                 aria-label="<%= label %>"><%= event_content %></article>
      <% else %>
        <%= link_to event.path,
              class: "hub-rama-card hub-rama-card--event hub-rama-event is-#{event.state}",
              role: "listitem",
              target: ("_blank" if event.external),
              rel: ("noopener noreferrer" if event.external),
              aria: { label: } do %>
          <%= event_content %>
        <% end %>
      <% end %>
    <% end %>

    <% if circle.present? %>
      <%= link_to circle.path,
            class: "hub-rama-card hub-rama-card--circle hub-rama-event hub-rama-event--circle is-#{circle.state}",
            role: "listitem",
            aria: { label: t("hub.rama.circle_card_label") } do %>
        <span class="hub-rama-event__art" aria-hidden="true">
          <%= noche_picture("hub.card.circle-study", role: :hub_card, alt: "", loading: "lazy") || noche_picture(circle.artwork, role: :hub_backdrop, alt: "", loading: "lazy") %>
        </span>
        <span class="hub-rama-event__scrim" aria-hidden="true"></span>
        <span class="hub-rama-event__copy">
          <span class="hub-rama-event__kicker"><%= t("hub.rama.circle_kicker") %></span>
          <strong><%= t("scripture_circle.hub_link") %></strong>
          <span class="hub-rama-event__detail"><%= t("hub.rama.circle_body") %></span>
          <% if circle.state == :read_only %>
            <span class="hub-rama-event__meta"><%= t("scripture_circle.state.read_only") %></span>
          <% end %>
          <span class="hub-rama-event__action"><%= t("hub.rama.circle_action") %><%= picto("arrow") %></span>
        </span>
      <% end %>
    <% end %>

    <%= link_to street_challenges_path,
          class: "hub-rama-card hub-rama-card--challenge hub-rama-event hub-rama-event--utility",
          role: "listitem",
          aria: { label: t("duel_campus.title") } do %>
      <span class="hub-rama-event__art" aria-hidden="true">
        <%= noche_media_picture("media/challenges/david_goliath/slides/01.jpg", alt: "", loading: "lazy") %>
      </span>
      <span class="hub-rama-event__scrim" aria-hidden="true"></span>
      <span class="hub-rama-event__copy">
        <span class="hub-rama-event__kicker"><%= t("duel_campus.kicker") %></span>
        <strong><%= t("duel_campus.title") %></strong>
        <span class="hub-rama-event__detail"><%= t("hub_menu.invite_friend_hint") %></span>
        <span class="hub-rama-event__action"><%= t("hub.now.challenge_open") %><%= picto("arrow") %></span>
      </span>
    <% end %>

    <%= link_to church_videos_path(locale: I18n.locale),
          class: "hub-rama-card hub-rama-card--videos hub-rama-event hub-rama-event--utility",
          role: "listitem",
          aria: { label: t("hub.videos_kicker") } do %>
      <span class="hub-rama-event__art" aria-hidden="true">
        <%= noche_media_picture("media/hub/light/video-sanctuary-v2.png", alt: "", loading: "lazy") %>
      </span>
      <span class="hub-rama-event__scrim" aria-hidden="true"></span>
      <span class="hub-rama-event__copy">
        <span class="hub-rama-event__kicker"><%= t("hub.videos_kicker") %></span>
        <strong><%= t("hub.videos_title") %></strong>
        <span class="hub-rama-event__detail"><%= t("hub.videos_body") %></span>
        <span class="hub-rama-event__action"><%= t("church_videos.all_videos") %><%= picto("arrow") %></span>
      </span>
    <% end %>
  </div>
</section>
