<% share = local_assigns[:share] %>
<% person = local_assigns[:person] %>

<article class="street-card is-share"
         data-controller="street-share"
         data-street-share-url-value="<%= share.url %>"
         data-street-share-text-value="<%= share.text %>"
         data-street-share-title-value="<%= share.title %>"
         data-street-share-copied-value="<%= t("street.share_copied") %>">
  <p class="street-share-ward"><%= share.ward_name %></p>
  <p class="street-share-score-hero" aria-label="<%= t("chrome.points", score: share.score) %>"><%= share.score %></p>
  <p class="street-share-score-suffix"><%= t("street.share_pts") %></p>
  <div class="street-share-stars" aria-label="<%= t("street.card_stars", count: share.stars) %>">
    <%= render "street_hub/stars", count: share.stars %>
  </div>
  <p class="street-share-pack"><%= person&.given_name || t("street.share_guest") %> · <%= share.pack_title %></p>
  <p class="street-share-prompt"><%= t("street.share_prompt") %></p>
  <button type="button" class="btn <%= local_assigns[:cta_class] || "btn-gold" %> street-share-cta" data-action="street-share#share">
    <%= picto("send") %><%= t("street.share_cta") %>
  </button>
</article>
