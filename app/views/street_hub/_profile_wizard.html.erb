<% if local_assigns[:profile_gate] %>
  <% if gate_ward.blank? %>
    <aside id="profile_gate"
           class="street-wizard"
           data-controller="street-arrival keyboard-inset"
           aria-labelledby="profile-gate-title">
      <button type="button"
              class="street-arrival-hit"
              data-action="street-arrival#skip"
              aria-label="<%= t("street.gate_arrive_skip") %>"></button>
      <p class="street-arrival-caption"><%= t("street.gate_arrive") %></p>
      <div class="street-wizard-panel hall-sheet">
        <span class="hall-sheet-apex street-quien-apex" aria-hidden="true"><%= picto("star4") %></span>
        <p class="street-arrival-lockup">Noche Live</p>
        <h1 id="profile-gate-title"><%= t("street.gate_ward_title") %></h1>
        <p class="lede"><%= t("street.gate_ward_lede") %></p>
        <span class="street-quien-rule" aria-hidden="true"></span>
        <%= render "street_hub/ward_picker", pick: "rama", ssr_fallback: true %>
      </div>
    </aside>
  <% else %>
    <aside id="profile_gate"
           class="street-wizard is-ready"
           data-controller="keyboard-inset"
           aria-labelledby="profile-gate-title">
      <div class="street-wizard-panel hall-sheet">
        <span class="hall-sheet-apex street-quien-apex" aria-hidden="true"><%= picto("star4") %></span>
        <%= render "street_hub/identity_steps",
              screen: local_assigns[:gate_screen],
              person: local_assigns[:gate_person],
              people: gate_people,
              not_me_path: root_path(ficha: 1, not_me: 1),
              someone_else_path: root_path(ficha: 1, fresh: 1) %>
      </div>
    </aside>
  <% end %>
<% end %>
