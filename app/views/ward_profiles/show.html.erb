<% content_for :title, @ward.name %>
<% content_for :body_class, "is-kid is-paper-hall is-rama-profile" %>
<% enable_frontend_audio %>
<% declare_frontend_resources(
     context: "ward.profile",
     styles: %w[shell ward_profile rama],
     controllers: %w[loading press stage hub-countdown],
     audio: { unlock: true, cues: %w[round_open] },
     classes: { "style.shell" => "critical", "style.ward_profile" => "critical", "style.rama" => "critical", "audio.ward" => "interaction" }
   ) %>
<% admin = ward_admin?(@ward) %>
<% live = @featured_night %>
<% page_hud(face: false, hud: true, theme: "celestial-dark") { site_menu } %>

<main id="rama_profile" class="rama-page hall-paper">
  <section class="rama-hero hall-still" style="--rama-hero: url('<%= media_src("media/rama/chapel-celestial-light.png") %>')">
    <div class="rama-hero-copy">
      <span class="emblem emblem-xl emblem-<%= @ward.emblem %>"><%= render "shared/emblem", key: @ward.emblem %></span>
      <div>
        <p class="rama-kicker"><%= t("ward.my_parish") %></p>
        <h1><%= @ward_display_name || @ward.name %></h1>
        <% if @ward.maps_url %>
          <%= link_to @ward.maps_url, class: "rama-pin", target: "_blank", rel: "noreferrer" do %>
            <%= picto("pin") %><span><%= @ward.maps_query %></span>
          <% end %>
        <% elsif ward_place(@ward).present? %>
          <p class="rama-pin"><%= picto("pin") %><span><%= ward_place(@ward) %></span></p>
        <% end %>
      </div>
    </div>
    <div class="rama-social-proof rama-stats">
      <div class="rama-online-faces" aria-hidden="true">
        <% @online_people.each do |person| %>
          <% if (src = avatar_mark(person)) %><img src="<%= src %>" alt=""><% else %><span><%= person.given_name.first %></span><% end %>
        <% end %>
      </div>
      <strong><%= t("street.leaderboard_players", count: @board.players) %></strong>
      <span class="rama-online-dot"></span><strong><%= t("ward.online_count", count: @online_count) %></strong>
    </div>
    <span class="rama-selected"><%= picto("star") %><%= t("ward.selected_parish") %></span>
  </section>

  <div class="rama-content">
    <section class="rama-visit rama-card">
      <div class="rama-visit-intro">
        <span class="rama-visit-mark" aria-hidden="true"><%= picto("pin") %></span>
        <h2><%= t("ward.visit_us") %></h2>
      </div>
      <div class="rama-visit-actions">
        <% if @ward.maps_url %><%= link_to @ward.maps_url, target: "_blank", rel: "noreferrer" do %><%= picto("pin") %><span><strong><%= t("ward.directions") %></strong><small><%= t("ward.open_maps") %></small></span><b>↗</b><% end %><% end %>
        <%= link_to church_missionaries_path do %><%= picto("people") %><span><strong><%= t("ward.contact_missionaries") %></strong><small><%= t("ward.send_message") %></small></span><b>›</b><% end %>
        <%= link_to church_path do %><%= picto("church") %><span><strong><%= t("ward.come_to_church") %></strong><small><%= t("church.invite") %></small></span><b>›</b><% end %>
      </div>
    </section>

    <% if @ward.sunday_schedule.any? %>
      <section class="rama-sunday-card rama-card" style="--rama-chapel-art: url('<%= media_src("media/rama/chapel-celestial-light.png") %>')">
        <div class="rama-sunday-welcome">
          <p class="rama-kicker"><%= t("ward.welcome_sunday_kicker") %></p>
          <h2><%= t("ward.welcome_sunday_title") %></h2>
          <p><%= t("ward.welcome_sunday_lede") %></p>
          <%= link_to church_missionaries_path, class: "rama-welcome-cta" do %>
            <%= picto("people") %><span><%= t("ward.welcome_sunday_cta") %></span><b>›</b>
          <% end %>
          <small><%= t("ward.welcome_sunday_hint") %></small>
        </div>
        <div class="rama-sunday-schedule">
          <span class="rama-sunday-icon" aria-hidden="true"><%= picto("calendar") %></span>
          <strong><%= t("ward.sunday_schedule") %></strong>
          <div class="rama-sunday-times">
            <% @ward.sunday_schedule.each do |meeting| %>
              <span><b><%= t("ward.#{meeting["label_key"]}") %></b><time><%= meeting["time"] %></time></span>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <% if @rama_events.any? %>
      <section class="rama-events rama-section" aria-labelledby="rama-events-title">
        <header class="rama-events-head">
          <div>
            <p class="rama-kicker"><%= t("ward.events_kicker") %></p>
            <h2 id="rama-events-title"><%= t("ward.events_title") %></h2>
          </div>
          <span class="rama-rail-count"><%= @rama_events.size %></span>
        </header>
        <div class="rama-events-grid" role="list">
          <% @rama_events.each do |event| %>
            <% cancelled = event.state == :cancelled %>
            <% meta = t("hub.rails.rama_meta", date: l(event.starts_at, format: :short), location: event.location_label) %>
            <% label = cancelled ? t("hub.rails.rama_cancelled_card_label", title: event.title, reason: event.cancellation_reason) : t("hub.rails.rama_card_label", title: event.title, action: t("ward.event_open")) %>
            <% content = capture do %>
              <% if event.still.present? %>
                <span class="rama-event-tile__art" aria-hidden="true"><%= noche_media_picture(event.still, alt: "", loading: "lazy") %></span>
              <% end %>
              <span class="rama-event-tile__scrim" aria-hidden="true"></span>
              <span class="rama-event-tile__copy">
                <span class="rama-event-tile__kicker"><%= t("hub.rails.event_kinds.#{event.kind}") %></span>
                <strong><%= event.title %></strong>
                <span class="rama-event-tile__detail"><%= event.summary %></span>
                <span class="rama-event-tile__meta"><%= meta %></span>
                <span class="rama-event-tile__action"><%= cancelled ? t("hub.rails.rama_cancelled") : t("ward.event_open") %> <%= picto("arrow") %></span>
              </span>
            <% end %>
            <% if cancelled %>
              <article class="rama-event-tile is-cancelled" role="listitem" aria-label="<%= label %>"><%= content %></article>
            <% else %>
              <%= link_to event.path, class: "rama-event-tile is-#{event.state}", role: "listitem", aria: { label: } do %><%= content %><% end %>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @study_week %>
      <% word_path = @expedition ? street_map_path(view: "expeditions", expedition: @study_week.id) : scripture_library_path %>
      <% word_art = @expedition&.artwork.presence || "media/study/psalms-refuge-2026.png" %>
      <%= link_to word_path, class: ["rama-word-card", "rama-card", (@expedition ? "is-gameops" : "is-library")], style: "--rama-word-art: url('#{media_src(word_art)}')" do %>
        <div class="rama-word-copy">
          <p class="rama-kicker"><%= t("ward.word_kicker") %></p>
          <h2><%= @expedition&.title || t("study.psalms_theme") %></h2>
          <p class="rama-word-refs"><%= @expedition&.subtitle.presence || @study_week.display_scripture_refs.first %></p>
          <% if @expedition&.promise.present? %><p class="rama-word-promise"><%= @expedition.promise %></p><% end %>
          <% study_total = @expedition&.total_count || 10 %>
          <% study_percent = @expedition&.progress_percent || (@study_progress * 10) %>
          <div class="rama-word-progress" aria-label="<%= t("study.progress", n: @study_progress, total: study_total) %>">
            <span><i style="width:<%= study_percent %>%"></i></span><strong><%= @study_progress %>/<%= study_total %></strong>
          </div>
          <p class="rama-word-community"><%= t("study.people_advancing", count: @study_community.players) %></p>
        </div>
        <span class="rama-word-mark" aria-hidden="true"><%= picto(@expedition ? "compass" : "book") %></span>
        <span class="rama-word-link"><%= @expedition ? t("street.expeditions.see_map") : t("ward.word_cta") %> <b>›</b></span>
      <% end %>
    <% end %>

    <% if @live_nights.any? %>
      <section class="rama-live-rail rama-section rama-section--gameops" aria-labelledby="rama-live-title">
        <header class="rama-live-head">
          <div><p class="rama-kicker"><%= t("hub.next_live") %></p><h2 id="rama-live-title"><%= t("ward.upcoming") %></h2></div>
          <span class="rama-rail-count"><%= @live_nights.size %></span>
        </header>
        <div class="rama-live-carousel" role="list">
        <% @live_nights.each_with_index do |night, index| %>
          <% countdown = index.zero? && !night.playing? %>
          <article class="rama-next rama-live-slide" role="listitem" style="--rama-night-poster: url('<%= night_poster_src(night) %>')"
               <% if countdown %>data-controller="hub-countdown" data-hub-countdown-state-value="upcoming"
               data-hub-countdown-starts-at-value="<%= night.starts_at.iso8601 %>"<% end %>>
        <div class="rama-next-copy">
          <p class="rama-kicker"><%= index.zero? ? t("hub.next_live") : t("ward.upcoming") %></p>
          <h2><%= l(night.local_starts_at.to_date) %></h2>
          <p class="rama-next-time"><%= picto("calendar") %><%= l(night.local_starts_at, format: "%H:%M") %></p>
          <p class="rama-next-theme"><span><%= t("ward.theme") %></span><%= night_title(night) %></p>
          <% if index.zero? %><p class="rama-next-players"><%= picto("people") %><%= t("ward.participants", count: @featured_participants_count) %></p><% end %>
          <%= link_to t(night.playing? ? "home.enter" : "ward.see_night"), home_night_path_for(night), class: ["btn", (index.zero? ? "btn-gold" : "btn-ghost")] %>
        </div>
        <% if countdown %>
          <div class="rama-countdown" data-hub-countdown-target="clock">
            <p><%= t("ward.starts_in") %></p>
            <div><strong data-hub-countdown-target="hours">00</strong><small><%= t("hub.hours") %></small></div>
            <i>:</i><div><strong data-hub-countdown-target="minutes">00</strong><small><%= t("hub.min") %></small></div>
            <i>:</i><div><strong data-hub-countdown-target="seconds">00</strong><small><%= t("hub.sec") %></small></div>
          </div>
        <% end %>
          </article>
        <% end %>
        </div>
      </section>
    <% end %>

    <%= render "street_hub/league_strip", board: @board, path: ward_leaderboard_path(@ward.code), empty_ok: true, league_class: "rama-liga", extended: true %>

    <% if admin %><nav class="rama-host-tools"><%= link_to t("fichas.heading"), ward_fichas_path %><%= link_to t("ward.secret"), ward_gate_path %></nav><% end %>
  </div>
</main>
<% page_dock(active: :church) %>
