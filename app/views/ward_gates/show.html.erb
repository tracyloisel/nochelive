<% content_for :title, t("ward.gate_title") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<% page_hud { site_menu } %>

<%= paper_hall id: "ward_gate", kicker: t("ward.gate_title") do %>
  <h1><%= t("ward.open_title") %></h1>
  <p class="lede"><%= t("ward.open_lede") %></p>

  <%= form_with url: ward_gate_path, class: "join-form" do %>
    <label for="code"><%= t("ward.code") %></label>
    <input id="code" name="code" required class="code-input" placeholder="RAMA" autocapitalize="characters">
    <label for="token"><%= t("ward.secret") %></label>
    <input id="token" name="token" required class="code-input" autocomplete="off">
    <button type="submit" class="btn btn-gold"><%= t("ward.enter") %></button>
  <% end %>

  <nav class="hall-sheet-foot">
    <%= link_to t("home.who"), add_ward_path, class: "quiet-link" %>
    <%= link_to t("chrome.close"), root_path, class: "quiet-link" %>
  </nav>
<% end %>
