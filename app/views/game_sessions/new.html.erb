<% content_for :title, "Crear noche" %>
<% shot = capture do %>
  <%= render "shared/still", src: night_poster_src("reyes_y_profetas"), poster: true %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", title: "Presentador", ticks: false %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "open", mid: 0.62, reel_class: "is-join" do %>
  <% if @ward %>
    <h1>Abrir la noche</h1>
    <p class="lede"><%= @ward.name %> · <%= @ward.code %>. Se crea un código corto. Guarda el enlace secreto.</p>
    <% if @live_nights.any? %>
      <p class="lede">Esta rama ya tiene una noche. Entra como presentador o crea otra.</p>
      <% @live_nights.each do |night| %>
        <%= button_to presenter_claim_path(night.code), class: "btn btn-gold picto-btn" do %>
          <%= picto("wand") %>Soy el presentador · <%= night.code %>
        <% end %>
      <% end %>
    <% end %>
    <%= button_to "Crear Reyes y Profetas", game_sessions_path, class: "btn btn-navy" %>
    <%= link_to "Fichas de la rama", ward_fichas_path, class: "btn btn-navy" %>
    <%= link_to "Otra rama", new_ward_path, class: "btn btn-ghost" %>
  <% else %>
    <h1>Primero tu rama</h1>
    <p class="lede">Las fichas viven en la rama. Crea una o entra con el secreto.</p>
    <%= link_to "Crear rama", new_ward_path, class: "btn btn-gold" %>
    <%= link_to "Ya tengo rama", ward_gate_path, class: "btn btn-navy" %>
  <% end %>
  <%= link_to "Volver", root_path, class: "btn btn-ghost" %>
<% end %>
