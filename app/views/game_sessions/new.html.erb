<% content_for :title, t("night.create_title") %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<% page_hud { site_menu } %>

<%= paper_hall id: "night_open", kicker: t("presenter.title") do %>
  <% if @ward %>
    <h1><%= t("night.open_title") %></h1>
    <p class="lede"><%= t("night.open_lede", ward: @ward.name, code: @ward.code) %></p>
    <% if @live_nights.any? %>
      <p class="lede"><%= t("night.already") %></p>
      <% @live_nights.each_with_index do |night, index| %>
        <%= button_to presenter_claim_path(night.code), class: index.zero? ? "btn btn-gold" : "btn btn-navy" do %>
          <%= picto("wand") %><%= t("night.i_am_code", code: night.code) %>
        <% end %>
      <% end %>
      <%= button_to t("night.create_theme"), game_sessions_path, class: "btn btn-navy" %>
    <% else %>
      <%= button_to t("night.create_theme"), game_sessions_path, class: "btn btn-gold" %>
    <% end %>
    <%= link_to t("night.fichas"), ward_fichas_path, class: "quiet-link" %>
    <%= link_to t("night.other_ward"), root_path, class: "quiet-link" %>
  <% else %>
    <h1><%= t("night.first_ward") %></h1>
    <p class="lede"><%= t("night.first_lede") %></p>
    <%= link_to t("night.create_ward"), add_ward_path, class: "btn btn-gold" %>
    <%= link_to t("night.have_ward"), ward_gate_path, class: "quiet-link" %>
  <% end %>
  <nav class="hall-sheet-foot">
    <%= link_to t("presenter.back"), root_path, class: "quiet-link" %>
  </nav>
<% end %>
