<% content_for :title, t("night.title_code", code: @night.code) %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<% page_hud { site_menu } %>

<%= paper_hall id: "night_created", kicker: t("night.ready") do %>
  <%= render "shared/hall_still", src: night_still_src(@night) %>
  <h1 class="code-display"><%= @night.code %></h1>
  <p class="lede"><%= t("night.code_lede", ward: @night.ward.name, code: @night.ward.code) %></p>
  <p class="secret"><%= t("night.secret") %></p>
  <input class="secret-url" readonly value="<%= presenter_gate_url(@night.code, token: params[:token]) %>" onclick="this.select()">
  <%= link_to t("night.open_console"), presenter_console_path(@night.code), class: "btn btn-gold" %>
  <nav class="hall-sheet-foot">
    <%= link_to t("night.as_public"), night_watch_path(@night.code), class: "quiet-link" %>
  </nav>
<% end %>
