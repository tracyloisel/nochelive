<% content_for :title, t("fichas.title", ward: @ward.name) %>
<% still_src = @night ? night_still_src(@night) : night_poster_src("reyes_y_profetas") %>
<% shot = capture do %>
  <%= render "shared/still", src: still_src, poster: true %>
<% end %>
<% chrome = capture do %>
  <%= render "shared/reel_chrome", night: @night, title: "#{@ward.name} · #{@ward.code}", ticks: false %>
<% end %>
<%= story_reel shot: shot, chrome: chrome, snap: "open", mid: 0.7, handle: false, reel_class: "is-join" do %>
  <section class="ficha-desk">
    <h1><%= t("fichas.heading") %></h1>
    <p class="lede"><%= t("fichas.lede") %></p>

    <%= form_with url: fichas_path_for, method: :get, class: "ficha-search" do %>
      <label for="ficha_q"><%= t("fichas.search") %></label>
      <input id="ficha_q" name="q" type="search" value="<%= @q %>" maxlength="24" class="code-input">
      <button type="submit" class="btn btn-ghost"><%= t("fichas.search_btn") %></button>
    <% end %>

    <% if @people.empty? %>
      <p class="quiet"><%= t("fichas.empty") %></p>
    <% else %>
      <ul class="ficha-grid person-list">
        <% @people.each do |person| %>
          <li>
            <%= link_to ficha_path_for(person), class: "team-pick person-pick" do %>
              <%= render "people/card", person: person, show_year: true %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @pages > 1 %>
      <nav class="ficha-pages" aria-label="<%= t("fichas.pages") %>">
        <% if @page > 1 %>
          <%= link_to t("fichas.prev"), fichas_path_for(page: @page - 1, q: @q.presence), class: "btn btn-ghost" %>
        <% end %>
        <span class="quiet"><%= t("fichas.page", page: @page, pages: @pages, total: @total) %></span>
        <% if @page < @pages %>
          <%= link_to t("fichas.next"), fichas_path_for(page: @page + 1, q: @q.presence), class: "btn btn-ghost" %>
        <% end %>
      </nav>
    <% end %>

    <p class="cluster">
      <% if @night %>
        <%= link_to t("fichas.night_list"), presenter_roster_path(@night.code), class: "btn btn-navy" %>
        <%= link_to t("presenter.console_link"), presenter_console_path(@night.code), class: "btn btn-ghost" %>
      <% else %>
        <%= link_to t("fichas.open_night"), ward_profile_path(@ward.code), class: "btn btn-gold" %>
        <%= link_to t("chrome.close"), ward_profile_path(@ward.code), class: "btn btn-ghost" %>
      <% end %>
    </p>
  </section>
<% end %>
