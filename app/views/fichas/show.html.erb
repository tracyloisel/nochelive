<% content_for :title, @person.display_name %>
<% content_for :body_class, "is-kid is-paper-hall" %>
<% still_src = @night ? night_still_src(@night) : night_poster_src("reyes_y_profetas") %>
<% page_hud { site_menu } %>

<%= paper_hall id: "ficha_show", kicker: @ward.name do %>
  <%= render "shared/hall_still", src: still_src %>
  <section class="ficha-desk">
    <h1><%= @person.display_name %></h1>
    <% if @night %>
      <%= render "shared/lang_assign", url: presenter_person_locale_path(@night.code, @person), current: @person.locale, name: @person.display_name %>
    <% end %>
    <p class="lede"><%= t("fichas.year_lede") %></p>

    <p class="year-shout" aria-label="<%= t("fichas.year") %>"><%= @person.favorite_year %></p>
    <p class="quiet"><%= t("fichas.not_on_tv") %></p>

    <%= form_with url: ficha_path_for(@person), method: :patch, class: "join-form" do %>
      <label for="given_name"><%= t("fichas.given") %></label>
      <input id="given_name" name="given_name" maxlength="24" required class="code-input" value="<%= @person.given_name %>">

      <label for="family_name"><%= t("fichas.family") %></label>
      <input id="family_name" name="family_name" maxlength="24" class="code-input" value="<%= @person.family_name %>">

      <fieldset class="emblem-pick avatar-pick">
        <legend><%= t("fichas.animal") %></legend>
        <% Player::AVATARS.each do |key| %>
          <label class="emblem-choice avatar-choice">
            <input type="radio" name="avatar_key" value="<%= key %>" <%= "checked" if key == @person.avatar_key %>>
            <% src = avatar_mark(key) %>
            <% if src %>
              <img src="<%= src %>" alt="" class="avatar-img avatar-img-lg">
            <% end %>
            <em><%= avatar_name(key) %></em>
          </label>
        <% end %>
      </fieldset>

      <%= render "shared/year_field", value: @person.favorite_year, required: true %>
      <button type="submit" class="btn btn-gold"><%= t("fichas.save") %></button>
    <% end %>

    <% if @merge_cards.any? %>
      <article class="merge-card">
        <h2><%= t("fichas.merge") %></h2>
        <p class="quiet"><%= t("fichas.merge_hint") %></p>
        <div class="ficha-merge-current">
          <%= render "people/card", person: @person, show_year: false %>
          <small><%= t("street.merge_crowns", count: @profile_score) %> · <%= t("street.merge_since", date: l(@person.created_at.to_date)) %></small>
        </div>
        <ul class="ficha-merge-list person-list">
          <% @merge_cards.each do |card| %>
            <% oldest = [@person, card.person].min_by { |person| [person.created_at, person.id] } %>
            <li class="team-pick person-pick">
              <%= render "people/card", person: card.person, show_year: false %>
              <small><%= t("street.merge_crowns", count: card.score) %> · <%= t("street.merge_since", date: l(card.person.created_at.to_date)) %></small>
              <%= form_with url: ficha_merge_path_for(@person),
                            class: "join-form ficha-merge-form",
                            data: {
                              controller: "profile-merge",
                              action: "turbo:submit-start->profile-merge#start turbo:submit-end->profile-merge#finish"
                            } do %>
                <input type="hidden" name="source_id" value="<%= card.person.id %>">
                <p class="hint"><%= t("fichas.merge_keeps", name: oldest.display_name, date: l(oldest.created_at.to_date)) %></p>
                <button type="submit" class="btn btn-navy" data-profile-merge-target="button" data-turbo-confirm="<%= t("fichas.merge_confirm", name: oldest.display_name) %>"><%= t("fichas.merge_pair") %></button>
                <aside class="profile-merge-overlay" hidden data-profile-merge-target="overlay" role="status" aria-live="assertive">
                  <div class="profile-merge-motion" aria-hidden="true">
                    <span class="profile-merge-orb is-current"><%= @person.given_name.to_s.first %></span>
                    <span class="profile-merge-spark">✦</span>
                    <span class="profile-merge-orb is-keeper"><%= card.person.given_name.to_s.first %></span>
                  </div>
                  <strong><%= t("street.merging_title") %></strong>
                  <p><%= t("street.merging_lede") %></p>
                </aside>
              <% end %>
            </li>
          <% end %>
        </ul>
      </article>
    <% end %>

    <nav class="hall-sheet-foot">
      <%= link_to t("fichas.all"), fichas_path_for, class: "quiet-link" %>
    </nav>
  </section>
<% end %>
