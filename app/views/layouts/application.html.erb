<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s.tr('_', '-') %>" data-asset-host="<%= Rails.configuration.x.asset_host %>">
  <head>
    <title><%= seo_metadata[:title].presence || content_for(:title) || "Noche Live" %></title>
    <%= seo_head_tags %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-visual">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Noche Live">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Noche Live">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6f3ec">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <script type="application/json" id="noche_resource_manifest"><%= frontend_resource_manifest_json %></script>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <% font_stylesheet = "https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Kalam:wght@700&display=swap" %>
    <link href="<%= font_stylesheet %>" rel="preload" as="style" data-noche-font-preload>
    <noscript><link href="<%= font_stylesheet %>" rel="stylesheet"></noscript>
    <%= stylesheet_link_tag "application", "shell/loading", "data-turbo-track": "reload" %>
    <%= frontend_surface_stylesheet_tags %>
    <%= yield :surface_stylesheets %>
    <style>:root {
      --temple-hall-bg: url("<%= temple_hall_bg_src %>");
      --temple-ceremony-hall-bg: url("<%= street_ceremony_asset_src("ceremony-gateway") || street_ceremony_asset_src("marble-hall-victory") || temple_hall_bg_src %>");
    }</style>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for(:body_class) %>"
        data-controller="loading press motion scripture-launcher pwa-install<%= " stage" if frontend_audio_enabled? %>"
        data-scripture-launcher-stylesheet-value="<%= asset_path("surfaces/scripture.css") %>"
        data-pwa-install-stylesheet-value="<%= asset_path("surfaces/pwa.css") %>"
        data-street-share-copied="<%= t("street.share_copied") %>"
        data-street-share-failed="<%= t("duel_campus.errors.create") %>">
      <a class="skip" href="#main"><%= t("chrome.skip_main") %></a>
    <div class="noche-loading"
         data-loading-target="indicator"
         data-state="idle"
         aria-hidden="true"
         hidden>
      <span class="noche-loading__shape"></span>
      <span class="noche-loading__shape"></span>
      <span class="noche-loading__shape"></span>
    </div>
    <div class="sky" aria-hidden="true"></div>
    <% if notice || alert %>
      <div class="toast-slot">
        <% if notice %>
          <p class="banner" role="status" data-controller="banner">
            <span class="banner-mark" aria-hidden="true"><%= picto("star8") %></span>
            <span class="banner-copy"><%= notice %></span>
          </p>
        <% end %>
        <% if alert %>
          <p class="banner banner-alert" role="alert" data-controller="banner">
            <span class="banner-mark" aria-hidden="true"><%= picto("cross") %></span>
            <span class="banner-copy"><%= alert %></span>
          </p>
        <% end %>
      </div>
    <% end %>
    <%= yield :hud %>
    <main id="main" class="shell">
      <%= yield %>
    </main>
    <%= yield :dock %>
    <div id="live_pulses" class="live-pulses" aria-live="polite"></div>
    <% if frontend_audio_enabled? %>
      <script type="application/json" id="noche_sfx_catalog"><%= json_escape(frontend_audio_catalog.to_json).html_safe %></script>
      <% tick = Sfx.versioned_path_for("tick") %>
      <% if tick %>
        <audio id="noche_sfx_gate" class="sfx-gate" preload="none" playsinline webkit-playsinline="true" src="<%= tick %>"></audio>
      <% end %>
    <% end %>
    <%= render "shared/chrome_tools" unless content_for?(:hud) %>
    <% if current_street_person %>
      <div hidden
           data-controller="presence"
           data-presence-scope-value="street"
           data-presence-token-value="<%= current_street_person.signed_id(purpose: :street_presence, expires_in: 1.day) %>"></div>
    <% end %>
    <% if street_duel_ping? %>
      <%= turbo_stream_from current_street_person, :duel_campus %>
      <div id="duel_campus_notice"></div>
    <% end %>
    <aside id="scripture_loading"
           class="reader-loading-veil"
           data-scripture-launcher-target="loading"
           data-state="idle"
           data-reader-loading-chapter-fallback="<%= t("scripture_reader.loading.chapter_fallback") %>"
           role="status"
           aria-live="polite"
           aria-atomic="true"
           aria-hidden="true"
           aria-busy="true"
           aria-labelledby="reader_loading_chapter"
           hidden>
      <div class="reader-loading-room">
        <button type="button"
                class="reader-loading-dismiss"
                data-action="scripture-launcher#cancel"
                aria-label="<%= t("scripture_reader.close") %>">
          <%= picto("cross") %><span><%= t("scripture_reader.close") %></span>
        </button>
        <div class="reader-loading-art" aria-hidden="true">
          <%= noche_picture(
                "scripture.reader.mountains-gold-ivory",
                alt: "",
                class_name: "reader-loading-art-image",
                loading: "lazy",
                fetchpriority: "low"
              ) %>
        </div>
        <section class="reader-loading-card">
          <span class="reader-loading-star" aria-hidden="true"><%= picto("sparkle") %></span>
          <p class="reader-loading-kicker"><%= t("scripture_reader.loading.kicker") %></p>
          <h1 id="reader_loading_chapter" class="reader-loading-chapter" data-reader-loading-chapter><%= t("scripture_reader.loading.chapter_fallback") %></h1>
          <% %w[opening slow waiting failed].each do |state| %>
            <p class="reader-loading-copy is-<%= state %>"
               <%= "role=alert" if state == "failed" %>
               data-reader-loading-template="<%= t("scripture_reader.loading.#{state}", chapter: "__CHAPTER__") %>"><%= t("scripture_reader.loading.#{state}", chapter: t("scripture_reader.loading.chapter_fallback")) %></p>
          <% end %>
          <span class="reader-loading-beacon" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="reader-loading-actions">
            <button type="button" class="reader-loading-retry" data-reader-loading-retry data-action="scripture-launcher#retry"><%= t("scripture_reader.loading.retry") %></button>
          </div>
        </section>
      </div>
    </aside>
    <% identity_migration_available = request.host == IdentityTransfersController::SOURCE_HOST && cookies.signed[:noche_device].present? %>
    <% if identity_migration_available %>
      <dialog class="identity-transfer-modal"
              open
              aria-modal="true"
              aria-labelledby="identity_transfer_title"
              aria-describedby="identity_transfer_hint"
              data-controller="identity-transfer"
              data-action="cancel->identity-transfer#keepOpen">
        <section class="identity-transfer-card">
          <span class="identity-transfer-apex" aria-hidden="true"><%= picto("star4") %></span>
          <span class="identity-transfer-emblem" aria-hidden="true">
            <img src="/apple-touch-icon.png" width="88" height="88" alt="">
          </span>
          <p class="identity-transfer-kicker">Noche Live</p>
          <h2 id="identity_transfer_title"><%= t("identity_migration.title") %></h2>
          <p id="identity_transfer_hint" class="identity-transfer-hint"><%= t("identity_migration.hint") %></p>
          <div class="identity-transfer-route" aria-hidden="true">
            <span><%= IdentityTransfersController::SOURCE_HOST %></span>
            <%= picto("arrow") %>
            <strong><%= IdentityTransfersController::TARGET_HOST %></strong>
          </div>
        <%= button_to identity_transfer_path,
                      class: "btn btn-gold identity-transfer-cta",
                      form: {
                        class: "identity-transfer-form",
                        data: {
                          turbo: false,
                          action: "submit->identity-transfer#submit",
                          identity_transfer_target: "form"
                        }
                      },
                      data: { identity_transfer_target: "button" },
                      autofocus: true do %>
          <span><%= t("identity_migration.action") %></span>
          <span class="identity-transfer-cta-arrow" aria-hidden="true"><%= picto("arrow") %></span>
          <span class="identity-transfer-spinner" aria-hidden="true"></span>
        <% end %>
        </section>
        <span class="identity-transfer-star is-one" aria-hidden="true"><%= picto("star4") %></span>
        <span class="identity-transfer-star is-two" aria-hidden="true"><%= picto("star4") %></span>
        <span class="identity-transfer-star is-three" aria-hidden="true"><%= picto("star4") %></span>
      </dialog>
    <% end %>
    <% unless identity_migration_available %>
      <aside class="pwa-install-banner"
             data-pwa-install-target="banner"
             aria-label="<%= t("pwa.install") %>"
             hidden>
        <img src="/apple-touch-icon.png" width="52" height="52" alt="" class="pwa-install-banner-icon">
        <button type="button" class="pwa-install-banner-copy" data-action="pwa-install#openGuide">
          <strong><%= t("pwa.banner_title") %></strong>
          <span><%= t("pwa.banner_hint") %></span>
        </button>
        <button type="button"
                class="pwa-install-banner-close"
                data-action="pwa-install#dismissBanner"
                aria-label="<%= t("pwa.not_now") %>">×</button>
      </aside>
    <% end %>
    <dialog class="pwa-install-dialog"
            data-pwa-install-target="dialog"
            data-action="click->pwa-install#backdropClose close->pwa-install#closed"
            aria-labelledby="pwa_install_title"
            aria-describedby="pwa_install_lede">
      <template data-pwa-install-target="guideTemplate">
      <div class="pwa-install-sheet"
           data-pwa-install-target="sheet"
           tabindex="-1">
        <span class="pwa-install-apex" aria-hidden="true"><%= picto("star4") %></span>
        <header class="pwa-install-hero">
          <span class="pwa-install-emblem" aria-hidden="true">
            <img src="/apple-touch-icon.png" width="72" height="72" alt="" class="pwa-install-icon">
          </span>
          <span class="pwa-install-heading">
            <span class="pwa-install-kicker"><%= t("pwa.kicker") %></span>
            <h2 id="pwa_install_title"><%= t("pwa.ios_title") %></h2>
          </span>
        </header>
        <p id="pwa_install_lede" class="pwa-install-lede"><%= t("pwa.banner_hint") %></p>
        <p class="pwa-install-browser-hint" data-pwa-install-target="browserHint" hidden><%= t("pwa.ios_browser_hint") %></p>
        <ol class="pwa-install-steps">
          <li>
            <%= noche_media_picture("media/pwa/ios-install-share-v1.webp", alt: "", class_name: "pwa-install-step-art", loading: "lazy") %>
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">1</span><span><%= t("pwa.ios_share") %></span></span>
          </li>
          <li>
            <%= noche_media_picture("media/pwa/ios-install-home-v1.webp", alt: "", class_name: "pwa-install-step-art", loading: "lazy") %>
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">2</span><span><%= t("pwa.ios_home") %></span></span>
          </li>
          <li>
            <%= noche_media_picture("media/pwa/ios-install-web-app-v1.webp", alt: "", class_name: "pwa-install-step-art", loading: "lazy") %>
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">3</span><span><%= t("pwa.ios_web_app") %></span></span>
          </li>
          <li>
            <%= noche_media_picture("media/pwa/ios-install-add-v1.webp", alt: "", class_name: "pwa-install-step-art", loading: "lazy") %>
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">4</span><span><%= t("pwa.ios_add") %></span></span>
          </li>
        </ol>
        <footer class="pwa-install-footer">
          <button type="button" class="btn btn-navy pwa-install-done" data-action="pwa-install#close">
            <span><%= t("pwa.done") %></span>
            <%= picto("check") %>
          </button>
        </footer>
      </div>
      </template>
    </dialog>
    <turbo-frame id="scripture_reader" data-scripture-launcher-target="frame"></turbo-frame>
  </body>
</html>
