<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s.tr('_', '-') %>">
  <head>
    <title><%= content_for(:title) || "Noche Live" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Noche Live">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6f3ec">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for(:body_class) %>" data-controller="stage press motion">
      <a class="skip" href="#main"><%= t("chrome.skip_main") %></a>
    <div class="sky" aria-hidden="true"></div>
    <main id="main" class="shell">
      <% if notice %><p class="banner" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="banner banner-alert" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <div id="live_pulses" class="live-pulses" aria-live="polite"></div>
    <script>window.NocheSfx = <%= Sfx.catalog.to_json.html_safe %>;</script>
    <% tick = Sfx.path_for("tick") %>
    <% if tick %>
      <audio id="noche_sfx_gate" class="sfx-gate" preload="auto" playsinline webkit-playsinline="true" src="<%= tick %>"></audio>
    <% end %>
    <%= render "shared/chrome_tools" %>
  </body>
</html>
