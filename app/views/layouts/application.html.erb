<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s.tr('_', '-') %>">
  <head>
    <title><%= seo_metadata[:title].presence || content_for(:title) || "Noche Live" %></title>
    <%= seo_head_tags %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-visual">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Noche Live">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Noche Live">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f6f3ec">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Kalam:wght@700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>:root {
      --temple-hall-bg: url("<%= temple_hall_bg_src %>");
      --temple-ceremony-hall-bg: url("<%= street_ceremony_asset_src("ceremony-gateway") || street_ceremony_asset_src("marble-hall-victory") || temple_hall_bg_src %>");
    }</style>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for(:body_class) %>"
        data-controller="stage press motion scripture pwa-install"
        data-street-share-copied="<%= t("street.share_copied") %>"
        data-street-share-failed="<%= t("street.duel_create_failed") %>">
      <a class="skip" href="#main"><%= t("chrome.skip_main") %></a>
    <div class="sky" aria-hidden="true"></div>
    <% if notice || alert %>
      <div class="toast-slot">
        <% if notice %>
          <p class="banner" role="status" data-controller="banner">
            <span class="banner-mark" aria-hidden="true"><%= picto("star8") %></span>
            <%= notice %>
          </p>
        <% end %>
        <% if alert %>
          <p class="banner banner-alert" role="alert" data-controller="banner"><%= alert %></p>
        <% end %>
      </div>
    <% end %>
    <%= yield :hud %>
    <main id="main" class="shell">
      <%= yield %>
    </main>
    <%= yield :dock %>
    <div id="live_pulses" class="live-pulses" aria-live="polite"></div>
    <script>window.NocheSfx = <%= Sfx.catalog.to_json.html_safe %>;</script>
    <% tick = Sfx.versioned_path_for("tick") %>
    <% if tick %>
      <audio id="noche_sfx_gate" class="sfx-gate" preload="auto" playsinline webkit-playsinline="true" src="<%= tick %>"></audio>
    <% end %>
    <%= render "shared/chrome_tools" unless chrome_tools_in_drawer? %>
    <% if current_street_person %>
      <div hidden data-controller="presence" data-presence-url-value="<%= street_presence_path %>"></div>
    <% end %>
    <% if street_duel_ping? %>
      <%= turbo_stream_from current_street_person, :street_duel %>
      <div id="street_duel_ping"></div>
    <% end %>
    <aside id="scripture_loading" class="scripture-veil is-loading" hidden data-scripture-target="loading" role="status">
      <div class="scripture-sheet">
        <p class="scripture-loading"><%= t("quiz.scripture_loading") %></p>
      </div>
    </aside>
    <% identity_migration_available = request.host == IdentityTransfersController::SOURCE_HOST && cookies.signed[:noche_device].present? %>
    <% if identity_migration_available %>
      <aside class="pwa-install-banner" aria-label="<%= t("identity_migration.action") %>">
        <img src="/apple-touch-icon.png" width="52" height="52" alt="" class="pwa-install-banner-icon">
        <%= button_to identity_transfer_path, class: "pwa-install-banner-copy" do %>
          <strong><%= t("identity_migration.title") %></strong>
          <span><%= t("identity_migration.hint") %></span>
        <% end %>
      </aside>
    <% end %>
    <% unless identity_migration_available %>
      <aside class="pwa-install-banner"
             data-pwa-install-target="banner"
             aria-label="<%= t("pwa.install") %>"
             hidden>
        <img src="/apple-touch-icon.png" width="52" height="52" alt="" class="pwa-install-banner-icon">
        <button type="button" class="pwa-install-banner-copy" data-action="pwa-install#openGuide">
          <strong><%= t("pwa.banner_title") %></strong>
          <span><%= t("pwa.banner_hint") %></span>
        </button>
        <button type="button"
                class="pwa-install-banner-close"
                data-action="pwa-install#dismissBanner"
                aria-label="<%= t("pwa.not_now") %>">×</button>
      </aside>
    <% end %>
    <dialog class="pwa-install-dialog"
            data-pwa-install-target="dialog"
            data-action="click->pwa-install#backdropClose close->pwa-install#closed"
            aria-labelledby="pwa_install_title">
      <div class="pwa-install-sheet">
        <img src="/apple-touch-icon.png" width="72" height="72" alt="" class="pwa-install-icon">
        <p class="home-menu-kicker"><%= t("pwa.kicker") %></p>
        <h2 id="pwa_install_title"><%= t("pwa.ios_title") %></h2>
        <p class="pwa-install-browser-hint" data-pwa-install-target="browserHint" hidden><%= t("pwa.ios_browser_hint") %></p>
        <ol class="pwa-install-steps">
          <li>
            <img src="/media/pwa/ios-install-share-v1.png" width="96" height="96" alt="" class="pwa-install-step-art">
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">1</span><span><%= t("pwa.ios_share") %></span></span>
          </li>
          <li>
            <img src="/media/pwa/ios-install-home-v1.png" width="96" height="96" alt="" class="pwa-install-step-art">
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">2</span><span><%= t("pwa.ios_home") %></span></span>
          </li>
          <li>
            <img src="/media/pwa/ios-install-web-app-v1.png" width="96" height="96" alt="" class="pwa-install-step-art">
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">3</span><span><%= t("pwa.ios_web_app") %></span></span>
          </li>
          <li>
            <img src="/media/pwa/ios-install-add-v1.png" width="96" height="96" alt="" class="pwa-install-step-art">
            <span class="pwa-install-step-copy"><span class="pwa-install-step-mark">4</span><span><%= t("pwa.ios_add") %></span></span>
          </li>
        </ol>
        <button type="button" class="btn btn-navy" data-action="pwa-install#close"><%= t("pwa.done") %></button>
      </div>
    </dialog>
    <turbo-frame id="scripture_reader" data-scripture-target="frame"></turbo-frame>
  </body>
</html>
