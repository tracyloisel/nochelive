<% content_for :title, t("street.leaderboard_screen_title") %>
<% content_for :body_class, "is-kid is-street-hub is-liga" %>
<% pack = @pack_id && QuizDefinition.catalog.find_pack(@pack_id) %>
<% board_title = pack ? t("street.board_pack", pack: pack.copy(:title)) : t("street.board_total") %>
<% you = @you %>
<% liga_empty = @q.present? ? t("street.leaderboard_empty_search") : (@visit ? t("street.leaderboard_empty_ward") : t("street.leaderboard_empty")) %>
<section id="street_world"
         class="street-world street-leaderboard-page is-liga-enter"
         data-controller="liga-board"
         data-liga-board-create-url-value="<%= street_challenges_path(format: :json) %>"
         data-liga-board-pack-id-value="<%= @duel_pack_id %>"
         style="view-transition-name: street-world">
  <%= chrome_menu(hud: true) { site_menu } %>

  <header class="street-liga-head leaderboard-title">
    <div class="street-liga-title-rule" aria-hidden="true"></div>
    <h1><%= t("street.leaderboard_screen_title") %></h1>
    <%= link_to ward_profile_path(@board_ward.code), class: "street-liga-rama-back" do %>
      <%= picto("arrow") %>
      <span><%= t("street.leaderboard_back_ward") %></span>
    <% end %>
    <span class="street-liga-title-star" aria-hidden="true"><%= picto("star8") %></span>
  </header>

  <nav class="street-liga-scope leaderboard-controls" aria-label="<%= t("street.leaderboard_scope") %>">
    <%= link_to liga_path_for(q: @q.presence), class: ("is-active" unless @stake_scope), aria: { current: ("page" unless @stake_scope) } do %>
      <%= picto("temple") %>
      <span><%= @board_ward.name %></span>
    <% end %>
    <%= link_to liga_path_for(scope: "stake", q: @q.presence), class: ("is-active" if @stake_scope), aria: { current: ("page" if @stake_scope) } do %>
      <%= picto("scroll") %>
      <span><%= t("street.leaderboard_scope_stake") %></span>
    <% end %>
  </nav>

  <div class="street-leaderboard-sheet">
    <div class="street-leaderboard-tools leaderboard-controls">
      <%= form_with url: liga_path_for, method: :get, class: "street-leaderboard-search",
            data: { controller: "liga-search", action: "input->liga-search#queue keydown.esc->liga-search#clearOnEscape" } do %>
        <div class="street-leaderboard-search-row<%= " is-filled" if @q.present? %>">
          <label for="leaderboard_q" class="visually-hidden"><%= t("street.leaderboard_search") %></label>
          <span class="street-liga-search-mark" aria-hidden="true"><%= picto("search") %></span>
          <input id="leaderboard_q"
                 name="q"
                 type="search"
                 value="<%= @q %>"
                 maxlength="24"
                 autocomplete="off"
                 enterkeyhint="search"
                 class="street-leaderboard-query"
                 placeholder="<%= t("street.leaderboard_search_member") %>"
                 data-action="focus->liga-board#searchFocus blur->liga-board#searchBlur input->liga-search#queue">
          <input type="hidden" name="pack_id" value="<%= @pack_id %>">
          <% if @stake_scope %><input type="hidden" name="scope" value="stake"><% end %>
        </div>
      <% end %>
      <%= link_to street_challenges_path, class: "street-liga-sibling-link", data: { action: "liga-board#leaveForChallenges" } do %>
        <span aria-hidden="true">⚔</span><%= t("street.duel_inbox") %>
        <% if @duel_incoming.to_i.positive? %><b><%= @duel_incoming %></b><% end %>
      <% end %>
    </div>

    <p class="street-liga-lede">
      <%= t(pack ? "street.leaderboard_basis_pack" : (@stake_scope ? "street.leaderboard_basis_stake" : "street.leaderboard_basis_total"), pack: pack&.copy(:title)) %>
      <%= picto("crown") %>
    </p>

    <div class="street-liga-board-wrap" data-liga-board-target="board">
      <% if @board.rows.any? %>
        <%= render "home/leaderboard",
              board: @board,
              title: board_title,
              board_class: "is-liga",
              show_players: true,
              show_avatars: true,
              show_ward: @stake_scope,
              compact_head: true,
              podium: @page == 1 && @q.blank? %>
      <% else %>
        <p class="street-leaderboard-empty<%= " is-search" if @q.present? %>">
          <span class="street-leaderboard-empty-mark" aria-hidden="true"><%= picto(@q.present? ? "search" : "podium") %></span>
          <%= liga_empty %>
        </p>
      <% end %>
    </div>

    <% if @board.pages > 1 %>
      <nav class="street-leaderboard-pages" aria-label="<%= t("street.leaderboard_pages") %>">
        <% 1.upto(@board.pages) do |n| %>
          <% if n == @page %>
            <span class="street-leaderboard-page-link is-current" aria-current="page"><%= n %></span>
          <% else %>
            <%= link_to n, liga_path_for(pack_id: @pack_id, scope: ("stake" if @stake_scope), page: n, q: @q.presence),
                  class: "street-leaderboard-page-link" %>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <% if you && @board.your_rank %>
    <%= link_to liga_path_for(pack_id: @pack_id, scope: ("stake" if @stake_scope), page: @board.your_page, anchor: "liga-you"),
          class: "street-liga-you-bar",
          data: { liga_board_target: "youBar" } do %>
      <span class="street-liga-you-trophy"><%= picto("trophy") %></span>
      <span><small><%= t("street.leaderboard_your_position") %></small><strong><%= t("street.leaderboard_position", rank: @board.your_rank, players: @board.players) %></strong></span>
      <b><%= number_with_delimiter(@board.your_score) %> <%= picto("crown") %></b>
      <i aria-hidden="true">›</i>
    <% end %>
  <% end %>

  <dialog class="street-liga-dialog street-liga-challenge-dialog" data-liga-board-target="challenge">
    <form method="dialog" class="street-liga-dialog-sheet">
      <button class="street-liga-dialog-close" value="cancel" aria-label="<%= t("chrome.close_menu") %>">×</button>
      <div class="street-liga-versus">
        <span class="street-liga-challenger"><%= you&.given_name %></span>
        <b>⚔</b>
        <span data-liga-board-target="opponentName"></span>
      </div>
      <h2 data-liga-board-target="challengeTitle"></h2>
      <p><span data-liga-board-target="opponentMeta"></span> · <%= picto("crown") %></p>
      <p><%= t("street.duel_live_rule") %></p>
      <p class="street-liga-challenge-success" data-liga-board-target="success" hidden><%= picto("check") %> <%= t("street.duel_sent") %></p>
      <footer>
        <button value="cancel" class="btn btn-ghost"><%= t("street.cancel") %></button>
        <button type="button" class="btn btn-gold" data-liga-board-target="send" data-action="liga-board#sendChallenge"><%= t("street.duel_send") %></button>
      </footer>
    </form>
  </dialog>

  <%= render Navigation::DockComponent.new(active: :home) %>
</section>
