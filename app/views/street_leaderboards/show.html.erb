<% content_for :title, t("street.leaderboard_title") %>
<% content_for :body_class, "is-kid is-street-hub" %>
<% pack_title = @pack_id ? QuizDefinition.catalog.find_pack(@pack_id).copy(:title) : nil %>
<% board_title = pack_title ? t("street.board_pack", pack: pack_title) : t("street.board_total") %>
<% you = current_street_person %>
<% you_on_page = @board.rows.any? { |row| row.you && !row.context } %>
<%= chrome_menu { site_menu } %>

<section id="street_world"
         class="street-world street-leaderboard-page"
         style="view-transition-name: street-world">
  <%= render "pages/head", kicker: t("street.leaderboard_kicker") %>

  <div class="street-leaderboard-sheet">
    <div class="street-leaderboard-tools">
    <%= form_with url: street_leaderboard_path, method: :get, class: "street-leaderboard-search",
          data: { controller: "liga-search", action: "input->liga-search#queue keydown.esc->liga-search#clearOnEscape" } do %>
      <div class="street-leaderboard-search-row<%= " is-filled" if @q.present? %>">
        <label for="leaderboard_q" class="visually-hidden"><%= t("street.leaderboard_search") %></label>
        <input id="leaderboard_q"
               name="q"
               type="search"
               value="<%= @q %>"
               maxlength="24"
               autocomplete="off"
               enterkeyhint="search"
               class="street-leaderboard-query"
               placeholder="<%= t("street.leaderboard_search_hint") %>"
               data-action="input->liga-search#queue"
               <%= "autofocus" if @q.present? %>>
        <% if @q.present? %>
          <%= link_to street_leaderboard_path(pack_id: @pack_id),
                class: "street-leaderboard-search-clear",
                aria: { label: t("street.leaderboard_search_clear") } do %>
            <%= picto("cross") %>
          <% end %>
        <% end %>
        <button type="submit" class="street-leaderboard-search-go" aria-label="<%= t("street.leaderboard_search_btn") %>">
          <%= picto("search") %>
        </button>
      </div>
      <label class="street-leaderboard-filter">
        <span class="visually-hidden"><%= t("street.leaderboard_scope") %></span>
        <span class="street-leaderboard-filter-mark" aria-hidden="true"><%= picto("podium") %></span>
        <select name="pack_id"
                class="street-leaderboard-select"
                data-action="change->liga-search#queue">
          <option value="" <%= "selected" unless @pack_id %>><%= t("street.leaderboard_scope_all") %></option>
          <% QuizDefinition.catalog.pack_ids.each do |pack_id| %>
            <option value="<%= pack_id %>" <%= "selected" if @pack_id == pack_id %>>
              <%= QuizDefinition.catalog.find_pack(pack_id).copy(:title) %>
            </option>
          <% end %>
        </select>
      </label>
    <% end %>

    <% if you && @board.your_rank && !you_on_page && @board.your_page %>
      <%= link_to street_leaderboard_path(pack_id: @pack_id, page: @board.your_page, q: @q.presence, anchor: "liga-you"),
            class: "street-leaderboard-you-card" do %>
        <span class="street-board-rank"><%= @board.your_rank %></span>
        <% src = avatar_mark(you) %>
        <span class="street-card-avatar">
          <% if src %>
            <img src="<%= src %>" alt="" class="avatar-img" width="48" height="48">
          <% else %>
            <span class="avatar-fallback" aria-hidden="true"><%= you.given_name.to_s.first %></span>
          <% end %>
          <%= street_live_dot(@board.your_live) %>
        </span>
        <div class="street-card-meta">
          <p class="street-card-name"><%= you.given_name %></p>
          <p class="street-board-answered"><%= t("street.leaderboard_answered", count: @board.your_answered) %></p>
          <p class="street-leaderboard-you"><%= t("street.leaderboard_you", rank: @board.your_rank, players: @board.players, score: @board.your_score) %></p>
          <span class="visually-hidden"><%= t("street.leaderboard_you_jump") %></span>
        </div>
        <p class="street-card-score">
          <%= picto("crown") %><%= number_with_delimiter(@board.your_score) %>
        </p>
      <% end %>
    <% end %>
    </div>

    <% if @board.rows.any? %>
      <%= render "home/leaderboard",
            board: @board,
            title: board_title,
            board_class: "is-liga",
            show_players: true,
            show_avatars: true,
            compact_head: true,
            podium: @q.blank? && @page == 1 %>
    <% else %>
      <p class="street-leaderboard-empty<%= " is-search" if @q.present? %>">
        <span class="street-leaderboard-empty-mark" aria-hidden="true"><%= picto(@q.present? ? "search" : "podium") %></span>
        <%= @q.present? ? t("street.leaderboard_empty_search") : t("street.leaderboard_empty") %>
      </p>
    <% end %>

    <% if @board.pages > 1 %>
      <% pages = @board.pages %>
      <% from = pages <= 5 ? 1 : [1, @page - 2].max %>
      <% to = pages <= 5 ? pages : [pages, @page + 2].min %>
      <nav class="street-leaderboard-pages" aria-label="<%= t("street.leaderboard_pages") %>">
        <span class="visually-hidden"><%= t("street.leaderboard_page", page: @page, pages: pages) %></span>
        <% if @page > 1 %>
          <%= link_to street_leaderboard_path(pack_id: @pack_id, page: @page - 1, q: @q.presence),
                class: "street-leaderboard-page-link is-step",
                aria: { label: t("street.leaderboard_prev") } do %>
            <span aria-hidden="true">‹</span>
          <% end %>
        <% end %>
        <% if from > 1 %>
          <%= link_to "1", street_leaderboard_path(pack_id: @pack_id, page: 1, q: @q.presence),
                class: "street-leaderboard-page-link",
                aria: { label: t("street.leaderboard_page", page: 1, pages: pages) } %>
          <% if from > 2 %>
            <span class="street-leaderboard-page-gap" aria-hidden="true"><%= t("street.leaderboard_gap") %></span>
          <% end %>
        <% end %>
        <% from.upto(to) do |n| %>
          <% if n == @page %>
            <span class="street-leaderboard-page-link is-current" aria-current="page"><%= n %></span>
          <% else %>
            <%= link_to n, street_leaderboard_path(pack_id: @pack_id, page: n, q: @q.presence),
                  class: "street-leaderboard-page-link",
                  aria: { label: t("street.leaderboard_page", page: n, pages: pages) } %>
          <% end %>
        <% end %>
        <% if to < pages %>
          <% if to < pages - 1 %>
            <span class="street-leaderboard-page-gap" aria-hidden="true"><%= t("street.leaderboard_gap") %></span>
          <% end %>
          <%= link_to pages, street_leaderboard_path(pack_id: @pack_id, page: pages, q: @q.presence),
                class: "street-leaderboard-page-link",
                aria: { label: t("street.leaderboard_page", page: pages, pages: pages) } %>
        <% end %>
        <% if @page < pages %>
          <%= link_to street_leaderboard_path(pack_id: @pack_id, page: @page + 1, q: @q.presence),
                class: "street-leaderboard-page-link is-step",
                aria: { label: t("street.leaderboard_next") } do %>
            <span aria-hidden="true">›</span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>
</section>
