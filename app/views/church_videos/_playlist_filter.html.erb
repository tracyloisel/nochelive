<% playlist_active = @catalog.active_playlist&.id == playlist.id %>
<%= link_to church_videos_path(locale: I18n.locale, playlist: playlist.id),
      class: ["church-video-playlist", ("is-featured" if playlist.featured), ("is-active" if playlist_active)].compact.join(" "),
      aria: { current: playlist_active ? "page" : nil } do %>
  <span class="church-video-playlist-art">
    <% if playlist.thumbnail_video_id.present? %>
      <%= tag.img src: church_video_thumbnail_path(playlist.thumbnail_video_id),
            alt: "",
            width: 320,
            height: 180,
            loading: playlist.featured ? "eager" : "lazy",
            decoding: "async" %>
    <% else %>
      <%= noche_media_picture(artwork, alt: "", loading: (playlist.featured ? "eager" : "lazy")) %>
    <% end %>
    <% if playlist.featured %>
      <span class="church-video-playlist-featured"><%= picto("star") %><%= t("church_videos.featured_playlist") %></span>
    <% end %>
    <span class="church-video-playlist-icon" aria-hidden="true"><%= picto("video-library") %></span>
  </span>
  <span class="church-video-playlist-copy">
    <strong><%= playlist.title %></strong>
    <small><%= t("church_videos.playlist_video_count", count: playlist.video_count) %></small>
  </span>
<% end %>
