<% definition = round&.definition %>
<% answered = response.present? %>
<% visual_phase = answered && snapshot.open? ? "locked" : snapshot.phase %>
<%= tag.section id: "night_spectator",
      class: [ "audience-stage", "is-#{visual_phase}" ],
      data: {
        controller: "audience",
        audience_refresh_in_value: snapshot.refresh_in_ms,
        audience_url_value: night_public_path(night.public_token),
        audience_online_value: t("audience.connected"),
        audience_offline_value: t("audience.offline")
      } do %>
  <div class="audience-art" aria-hidden="true">
    <% if round && !snapshot.lobby? && !snapshot.finished? %>
      <%= render "shared/challenge_media", round: round, cinema: true %>
    <% else %>
      <%= image_tag night_still_src(night), alt: "", class: "audience-poster" %>
    <% end %>
  </div>
  <div class="audience-scrim" aria-hidden="true"></div>
  <div class="audience-stars" aria-hidden="true"></div>

  <header class="audience-head">
    <div class="audience-brand">
      <span class="audience-brand-mark"><%= picto("star8") %></span>
      <span>NOCHE<br>LIVE</span>
    </div>
    <% if round %>
      <p class="audience-round-count"><%= t("audience.round_count", current: round.position, total: night.round_runs.size) %></p>
    <% else %>
      <p class="audience-round-count"><%= t("audience.live") %></p>
    <% end %>
  </header>

  <% if round && snapshot.phase.in?(%w[open locked revealed]) && round.definition.duration.to_i.positive? %>
    <div class="audience-timer" aria-label="<%= t("audience.time_left", seconds: snapshot.seconds_left) %>">
      <span style="--audience-progress: <%= snapshot.progress_percent %>%"></span>
    </div>
  <% end %>

  <% if night.teams.any? && !snapshot.finished? %>
    <ol class="audience-score-strip" aria-label="<%= t("audience.scoreboard") %>">
      <% night.teams.order(cached_score: :desc, name: :asc).limit(3).each do |team| %>
        <li>
          <span class="emblem emblem-<%= team.emblem %>"><%= render "shared/emblem", key: team.emblem %></span>
          <span class="word"><%= team.name %></span>
          <strong><%= team.cached_score %></strong>
        </li>
      <% end %>
    </ol>
  <% end %>

  <div class="audience-spacer"></div>

  <div class="audience-panel-wrap">
    <article class="audience-panel">
      <% if snapshot.finished? %>
        <p class="audience-kicker"><%= t("audience.final_kicker") %></p>
        <h1><%= t("audience.final_title") %></h1>
        <% if champion = night.champion %>
          <div class="audience-champion">
            <span class="emblem emblem-<%= champion.emblem %>"><%= render "shared/emblem", key: champion.emblem %></span>
            <strong><%= champion.name %></strong>
            <span><%= t("audience.points", count: champion.cached_score) %></span>
          </div>
        <% end %>
        <p class="audience-lede"><%= t("audience.final_lede") %></p>
      <% elsif snapshot.lobby? %>
        <p class="audience-kicker"><%= t("audience.welcome_kicker") %></p>
        <h1><%= t("audience.welcome_title") %></h1>
        <p class="audience-lede"><%= t("audience.welcome_lede") %></p>
        <div class="audience-live-pill"><span></span><%= t("audience.connected") %></div>
      <% elsif snapshot.intro? %>
        <p class="audience-kicker"><%= t("audience.next_round") %></p>
        <h1><%= definition.copy(:title) %></h1>
        <p class="audience-lede"><%= definition.copy(:instructions) %></p>
        <div class="audience-wait-orbit" aria-hidden="true"><%= picto(definition.icon.presence || "sparkle") %></div>
      <% elsif snapshot.reveal_visible? %>
        <% correct = response&.correct? %>
        <p class="audience-kicker"><%= correct ? t("audience.correct_kicker") : t("audience.reveal_kicker") %></p>
        <h1 class="audience-result <%= "is-correct" if correct %>"><%= correct ? t("audience.correct") : definition.copy(:answer) %></h1>
        <% if correct %>
          <p class="audience-answer"><%= definition.copy(:answer) %></p>
        <% end %>
        <% if definition.reference.present? %>
          <p class="audience-reference"><%= definition.copy(:reference) %></p>
        <% end %>

        <% if definition.has_choices? %>
          <ol class="audience-result-list">
            <% Array(definition.choices).each_with_index do |choice, index| %>
              <% key = choice_key(choice) %>
              <% is_correct = key == definition.correct_choice.to_s %>
              <li class="<%= "is-correct" if is_correct %> <%= "is-mine" if response&.choice == key %>">
                <span class="choice-mark"><%= picto(choice_mark(index)[:shape]) %></span>
                <span class="word"><%= choice_label(choice, definition) %></span>
                <strong><%= distribution[key].to_i %>%</strong>
              </li>
            <% end %>
          </ol>
        <% end %>

        <div class="audience-reward-line">
          <span><%= t("audience.participation", count: response_count) %></span>
          <strong><%= t("audience.streak", count: streak) %></strong>
        </div>
      <% elsif answered || snapshot.locked? %>
        <p class="audience-kicker"><%= t("audience.answer_locked") %></p>
        <h1><%= answered ? t("audience.choice_saved") : t("audience.round_closed") %></h1>
        <% if answered %>
          <% picked = Array(definition.choices).find { |choice| choice_key(choice) == response.choice } %>
          <div class="audience-locked-choice">
            <span><%= picto("lock") %></span>
            <strong><%= picked ? choice_label(picked, definition) : response.choice %></strong>
          </div>
        <% end %>
        <p class="audience-lede"><%= t("audience.wait_reveal") %></p>
      <% elsif snapshot.accepting_responses? %>
        <p class="audience-kicker"><%= t("audience.play_now") %></p>
        <h1><%= definition.copy(:question) %></h1>
        <p class="audience-lede"><%= t("audience.choose_once") %></p>
        <div class="audience-choices">
          <% Array(definition.choices).each_with_index do |choice, index| %>
            <% mark = choice_mark(index) %>
            <%= button_to night_public_response_path(night.public_token, round),
                  params: { choice: choice_key(choice) },
                  class: "audience-choice is-#{mark[:tone]}",
                  form: { data: { turbo: true } } do %>
              <span class="choice-mark"><%= picto(mark[:shape]) %></span>
              <span class="word"><%= choice_label(choice, definition) %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="audience-kicker"><%= t("audience.live_challenge") %></p>
        <h1><%= definition.copy(:title) %></h1>
        <p class="audience-lede"><%= definition.copy(:instructions) %></p>
        <div class="audience-live-pill"><span></span><%= t("audience.room_plays") %></div>
      <% end %>
    </article>

    <% if round && snapshot.phase.in?(%w[open locked revealed]) %>
      <nav class="audience-reactions" aria-label="<%= t("audience.reactions") %>">
        <% { "applause" => "👏", "heart" => "♥", "crown" => "♛" }.each do |mark, glyph| %>
          <%= button_to night_public_reaction_path(night.public_token, round), params: { mark: mark }, aria: { label: t("audience.reaction_#{mark}") } do %>
            <span aria-hidden="true"><%= glyph %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <p class="audience-network" data-audience-target="network" role="status"><%= t("audience.connected") %></p>
<% end %>
