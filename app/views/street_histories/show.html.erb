<% content_for :title, t("street.history_title") %>
<% content_for :body_class, "is-kid" %>
<%= chrome_menu(open: true) { site_menu } %>

<section class="gate is-paper street-history">
  <h1><%= t("street.history_title") %></h1>
  <p class="lede"><%= t("street.history_lede") %></p>

  <% if @trail_sections.any? %>
    <% @trail_sections.each do |section| %>
      <article class="street-history-pack <%= section[:pack].state %>">
        <header class="street-history-head">
          <span class="street-history-flag" aria-hidden="true"><%= picto("flag") %></span>
          <h2><%= section[:pack].label %></h2>
        </header>
        <ol class="street-history-steps">
          <% section[:questions].each do |step| %>
            <li class="street-history-step <%= step.state %>">
              <% if step.jumpable? && step.run_id == @street.run.id %>
                <%= button_to quiz_jump_path(@street.run),
                      params: { position: step.position },
                      class: "street-history-hit" do %>
                  <span class="street-history-mark" aria-hidden="true"><%= trail_step_mark(step) %></span>
                  <span class="street-history-copy">
                    <strong><%= t("street.history_question", n: step.position) %></strong>
                    <small><%= trail_step_label(step) %></small>
                  </span>
                  <%= picto("arrow") %>
                <% end %>
              <% else %>
                <div class="street-history-hit is-static">
                  <span class="street-history-mark" aria-hidden="true"><%= trail_step_mark(step) %></span>
                  <span class="street-history-copy">
                    <strong><%= t("street.history_question", n: step.position) %></strong>
                    <small><%= trail_step_label(step) %></small>
                  </span>
                </div>
              <% end %>
            </li>
          <% end %>
        </ol>
      </article>
    <% end %>
  <% else %>
    <p class="hint"><%= t("street.history_empty") %></p>
  <% end %>

  <%= link_to root_path, class: "btn btn-gold" do %>
    <%= t("street.back_quiz") %>
  <% end %>
</section>
